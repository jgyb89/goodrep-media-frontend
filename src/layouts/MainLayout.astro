---
import "material-symbols/outlined.css";
import "../styles/global.css";
import { Image } from "astro:assets";
import LeadForm from "../components/LeadForm.jsx";
import LightboxModal from "../components/LightboxModal.astro";
import BaseHead from "../components/BaseHead.astro";
import { SITE_NAME, DEFAULT_META_DESCRIPTION, LEGAL_LINKS } from "../config/site.js";

const {
  title = `${SITE_NAME} | Digital Marketing Agency`,
  description = DEFAULT_META_DESCRIPTION,
} = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body id="top">
    <!-- Global Header -->
    <header class="global-header">
      <nav class="global-nav" aria-label="Primary">
        <a href="/" class="brand" aria-label="Good Rep Media home">
          <span class="brand__mark">
            <Image
              src="/grm-logos/GRM-icon-logo-white.webp"
              alt=""
              width={150}
              height={150}
              loading="lazy"
              decoding="async"
            />
          </span>
          <span class="brand__text">
            <span class="brand__name">GOOD REP</span>
            <span class="brand__sub">MEDIA</span>
          </span>
        </a>
        <div class="global-nav__links">
          <div class="nav-item nav-item--mega">
            <a
              href="/services/"
              class="nav-item__trigger"
              aria-haspopup="true"
              aria-expanded="false"
            >
              <span>Services</span>
              <span
                class="material-symbols-outlined nav-item__caret"
                aria-hidden="true">expand_more</span
              >
            </a>

            <div class="mega-menu" role="region" aria-label="Services submenu">
              <div class="mega-menu__inner">
                <div class="mega-menu__col">
                  <h3 class="mega-menu__heading">Web Design and Build</h3>
                  <ul class="mega-menu__list">
                    <li><a href="/services/web-design/">Website Design</a></li>
                    <li>
                      <a href="/services/ecommerce-web-design/"
                        >eCommerce Web Design</a
                      >
                    </li>
                  </ul>
                </div>

                <div class="mega-menu__col">
                  <h3 class="mega-menu__heading">Search Engine Optimization</h3>
                  <ul class="mega-menu__list">
                    <li><a href="/services/local-seo/">Local SEO</a></li>
                    <li><a href="/services/technical-seo/">Technical SEO</a></li>
                    <li>
                      <a href="/services/link-building-services/"
                        >Link Building Services</a
                      >
                    </li>
                    <li>
                      <a href="/services/amazon-marketing-services/"
                        >Amazon Marketing Services</a
                      >
                    </li>
                  </ul>
                </div>

                <div class="mega-menu__col">
                  <h3 class="mega-menu__heading">Digital Media</h3>
                  <ul class="mega-menu__list">
                    <li>
                      <a href="/services/digital-media-production/"
                        >Digital Media Production</a
                      >
                    </li>
                    <li>
                      <a href="/services/email-marketing/">Email Marketing</a>
                    </li>
                    <li><a href="/services/sms-marketing-services/">SMS Marketing</a></li>
                    <li>
                      <a href="/services/video-production-services/">Video Production</a>
                    </li>
                    <li>
                      <a href="/services/social-media-marketing/">Social Media Marketing</a
                      >
                    </li>
                  </ul>
                </div>

                <div class="mega-menu__col">
                  <h3 class="mega-menu__heading">Paid Media</h3>
                  <ul class="mega-menu__list">
                    <li>
                      <a href="/services/pay-per-click-marketing/">Pay-per-click Marketing</a>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
          <a href="/work/" class="nav-link">Our Work</a>
          <a href="/about/" class="nav-link">About</a>
          <a href="/blog/" class="nav-link">Insights</a>
        </div>
        <a href="/#consultation" class="btn btn--primary global-nav__cta"
          >Book a Call</a
        >
      </nav>
    </header>

    <!-- Page Content Injected Here -->
    <slot />

    <!-- Global Footer -->
    <footer class="global-footer">
      <div class="global-footer__grid">
        <div class="global-footer__brand">
          <a
            href="/"
            class="brand brand--footer"
            aria-label="Good Rep Media home"
          >
            <Image
              class="brand__logo"
              src="/grm-logos/GRM-icon-logo-white.webp"
              alt=""
              width={150}
              height={150}
              loading="lazy"
              decoding="async"
            />
            <span class="brand__text">
              <span class="brand__name">GOOD REP</span>
              <span class="brand__sub">MEDIA</span>
            </span>
          </a>
          <p>
            Good Rep Media is a digital marketing agency for small and local
            businesses located in Grand Rapids, MI.
          </p>
          <p class="global-footer__sms">
            <span class="material-symbols-outlined" aria-hidden="true"
              >smartphone</span
            >
            Text JOIN to 49872 for Exclusive Offers &amp; Updates. Msg freq varies.
          </p>
          <p class="global-footer__fine">
            Recurring Msgs. Reply HELP for Help. Reply STOP to opt out. Msg
            &amp; Data rates may apply.
          </p>
        </div>

        <div class="global-footer__col">
          <h2 class="global-footer__heading">Resources</h2>
          <ul>
            <li><a href="/work/">Our Work</a></li>
            <li><a href="/about/">About Us</a></li>
            <li><a href="/#process">Our Process</a></li>
            <li><a href="/blog/">Knowledge Center</a></li>
            <li><a href="/#consultation">Contact Us</a></li>
          </ul>
        </div>

        <div class="global-footer__col">
          <h2 class="global-footer__heading">Services</h2>
          <ul>
            <li><a href="/services/web-design/">Website Design</a></li>
            <li><a href="/services/local-seo/">Local SEO</a></li>
            <li><a href="/services/pay-per-click-marketing/">Paid Ads</a></li>
            <li><a href="/services/">View All Services &rarr;</a></li>
          </ul>
        </div>

        <div class="global-footer__col">
          <h2 class="global-footer__heading">Help</h2>
          <ul class="global-footer__contact">
            <li>
              <span class="material-symbols-outlined" aria-hidden="true"
                >call</span
              >
              <a href="tel:+16163009868">(616) 300-9868</a>
            </li>
            <li>
              <span class="material-symbols-outlined" aria-hidden="true"
                >mail</span
              >
              <a href="mailto:team@goodrep.media">team@goodrep.media</a>
            </li>
            <li>
              <span class="material-symbols-outlined" aria-hidden="true"
                >location_on</span
              >
              <span>O-745 Lake Michigan Dr. NW, Grand Rapids, MI 49534</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="global-footer__bottom">
        <p>&copy; {year} {SITE_NAME} Inc. All rights reserved.</p>
        <nav class="global-footer__legal" aria-label="Legal Links">
          {LEGAL_LINKS.map((link, idx) => (
            <>
              {idx > 0 && <span class="global-footer__sep" aria-hidden="true">&bull;</span>}
              <a href={link.href}>{link.label}</a>
            </>
          ))}
        </nav>
      </div>
    </footer>

    <!-- Fixed Form Modal Pop-up Button (above back-to-top) -->
    <button
      type="button"
      class="fixed-form-btn"
      id="fixed-form-btn"
      aria-label="Open contact form"
      title="Send us a message"
    >
      <span class="material-symbols-outlined" aria-hidden="true">mail</span>
      <span class="fixed-form-btn__tooltip">Send a message</span>
    </button>

    <a href="#top" class="back-to-top" aria-label="Back to top">
      <span class="material-symbols-outlined" aria-hidden="true"
        >keyboard_arrow_up</span
      >
    </a>

    <!-- Global Contact Form Modal -->
    <dialog class="contact-modal" id="contact-modal">
      <div class="contact-modal__inner">
        <button
          type="button"
          class="contact-modal__close"
          id="close-contact-modal"
          aria-label="Close modal"
        >
          <span class="material-symbols-outlined" aria-hidden="true">close</span
          >
        </button>
        <h3 class="contact-modal__title">Send Us A Message</h3>
        <p class="contact-modal__sub">
          Tell us about your project and we'll get back to you within 24 hours.
        </p>
        <LeadForm client:visible submitLabel="Send Message" />
      </div>
    </dialog>

    <!-- Global Image Lightbox Modal -->
    <LightboxModal />

    <script>
      function setupContactModal() {
        const modal =
          document.querySelector<HTMLDialogElement>("#contact-modal");
        if (!modal) return;

        const closeBtn = document.querySelector("#close-contact-modal");
        const openBtns = document.querySelectorAll(
          "#fixed-form-btn, #trigger-contact-modal, [data-open-modal]",
        );

        openBtns.forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.preventDefault();
            if (typeof modal.showModal === "function") {
              modal.showModal();
            }
          });
        });

        closeBtn?.addEventListener("click", () => {
          modal.close();
        });

        // Close modal when clicking outside the dialog content
        modal.addEventListener("click", (e) => {
          const rect = modal.getBoundingClientRect();
          const isInDialog =
            rect.top <= e.clientY &&
            e.clientY <= rect.top + rect.height &&
            rect.left <= e.clientX &&
            e.clientX <= rect.left + rect.width;
          if (!isInDialog) {
            modal.close();
          }
        });
      }

      function setupMegaMenu() {
        const megaItem = document.querySelector<HTMLElement>(".nav-item--mega");
        const trigger =
          megaItem?.querySelector<HTMLAnchorElement>(".nav-item__trigger");
        if (!megaItem || !trigger) return;

        const setExpanded = (expanded: boolean) => {
          trigger.setAttribute("aria-expanded", String(expanded));
          if (expanded) {
            megaItem.classList.remove("is-closed");
          }
        };

        megaItem.addEventListener("pointerenter", () => setExpanded(true));
        megaItem.addEventListener("pointerleave", () => setExpanded(false));
        megaItem.addEventListener("focusin", () => setExpanded(true));
        megaItem.addEventListener("focusout", (e) => {
          if (!megaItem.contains(e.relatedTarget as Node)) {
            setExpanded(false);
          }
        });

        megaItem.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            megaItem.classList.add("is-closed");
            trigger.setAttribute("aria-expanded", "false");
            trigger.focus();
          }
        });
      }

      function initLayout() {
        setupContactModal();
        setupMegaMenu();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initLayout);
      } else {
        initLayout();
      }
      document.addEventListener("astro:page-load", initLayout);
    </script>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ---------- Header ---------- */
  .global-header {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .global-nav {
    max-width: var(--container);
    height: var(--header-h);
    box-sizing: border-box;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-dark);
    margin-right: auto;
  }

  /* The GR mark is white, so it sits on a charcoal tile in the light header */
  .brand__mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--color-dark);
  }

  .brand__mark img {
    width: 40px;
    height: 30px;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
    font-family: var(--font-heading);
  }

  .brand__name {
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: 0.02em;
  }

  .brand__sub {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    color: var(--color-cyan);
    margin-top: 3px;
  }

  .global-nav__links {
    display: none;
    align-items: center;
    height: 100%;
    gap: 2rem;
  }

  .nav-link,
  .nav-item__trigger {
    color: var(--color-dark);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    position: relative;
    padding: 0.25rem 0;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  .nav-link::after,
  .nav-item__trigger::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 2px;
    background: var(--color-cyan);
    transform: scaleX(0);
    transform-origin: left;
    transition:
      transform 0.25s ease,
      background-color 0.25s ease;
  }

  .nav-link:hover {
    color: var(--color-cyan-dark);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  /* ---------- Services Mega Menu ---------- */
  .nav-item--mega {
    height: 100%;
    display: flex;
    align-items: center;
  }

  .nav-item__caret {
    font-size: 1.15rem;
    line-height: 1;
    transition:
      transform 0.25s ease,
      color 0.2s ease;
  }

  .nav-item--mega:hover:not(.is-closed) .nav-item__trigger,
  .nav-item--mega:focus-within:not(.is-closed) .nav-item__trigger {
    color: var(--color-cyan);
  }

  .nav-item--mega:hover:not(.is-closed) .nav-item__trigger::after,
  .nav-item--mega:focus-within:not(.is-closed) .nav-item__trigger::after {
    background: var(--color-primary);
    transform: scaleX(1);
  }

  .nav-item--mega:hover:not(.is-closed) .nav-item__caret,
  .nav-item--mega:focus-within:not(.is-closed) .nav-item__caret {
    transform: rotate(180deg);
    color: var(--color-cyan);
  }

  .mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    background: #2b2b2b;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-6px);
    transition:
      opacity 0.22s ease,
      transform 0.22s ease,
      visibility 0.22s;
    z-index: 60;
  }

  .nav-item--mega:hover:not(.is-closed) .mega-menu,
  .nav-item--mega:focus-within:not(.is-closed) .mega-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mega-menu__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 2.75rem 2rem 3.25rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.25rem 3rem;
  }

  @media (min-width: 1024px) {
    .mega-menu__inner {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem 3.5rem;
    }
  }

  .mega-menu__heading {
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-light);
    margin: 0 0 1.25rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid var(--color-light);
    display: inline-block;
  }

  .mega-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.05rem;
  }

  .mega-menu__list a {
    color: #e5e7eb;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.4;
    display: inline-block;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .mega-menu__list a:hover,
  .mega-menu__list a:focus-visible {
    color: var(--color-cyan);
    transform: translateX(3px);
  }

  .global-nav__cta {
    padding: 0.6rem 1.4rem;
    font-size: 0.9rem;
  }

  @media (min-width: 860px) {
    .global-nav__links {
      display: flex;
    }
  }

  /* ---------- Footer ---------- */
  .global-footer {
    margin-top: auto;
    background: var(--color-darker);
    color: #d4d4d4;
    font-size: 0.9rem;
  }

  .global-footer__grid {
    max-width: var(--container);
    margin: 0 auto;
    padding: 4rem 2rem 3rem;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .global-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .global-footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
    }
  }

  .global-footer p {
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .brand--footer {
    color: var(--color-light);
    margin-bottom: 1.25rem;
  }

  .brand__logo {
    width: 54px;
    height: 44px;
  }

  .global-footer__sms {
    display: flex;
    gap: 0.5rem;
    color: var(--color-cyan);
  }

  .global-footer__sms .material-symbols-outlined {
    font-size: 1.2rem;
  }

  .global-footer__fine {
    font-size: 0.8rem;
    color: #a3a3a3;
  }

  .global-footer__heading {
    color: var(--color-light);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0.5rem 0 1.25rem;
  }

  .global-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .global-footer a {
    color: #d4d4d4;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .global-footer a:hover {
    color: var(--color-cyan);
  }

  .global-footer__contact li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    line-height: 1.5;
  }

  .global-footer__contact .material-symbols-outlined {
    font-size: 1.2rem;
    color: var(--color-light);
  }

  .global-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    text-align: center;
    padding: 1.5rem 2rem;
    color: #8a8a8a;
    font-size: 0.8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .global-footer__bottom p {
    margin: 0;
  }

  .global-footer__legal {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .global-footer__sep {
    color: #525252;
    user-select: none;
  }

  /* ---------- Back to top ---------- */
  .back-to-top {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 40;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-light);
    color: var(--color-cyan);
    border: 2px solid var(--color-cyan);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .back-to-top:hover {
    background: var(--color-cyan);
    color: var(--color-light);
    transform: translateY(-3px);
  }

  /* ---------- Fixed Form Modal Pop-up Button ---------- */
  .fixed-form-btn {
    position: fixed;
    right: 1.5rem;
    bottom: calc(1.5rem + 48px + 0.75rem); /* Exactly above .back-to-top */
    z-index: 40;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-light);
    border: none;
    box-shadow: 0 10px 20px -6px rgba(233, 79, 55, 0.55);
    cursor: pointer;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .fixed-form-btn:hover {
    background: #d63f28;
    transform: translateY(-3px) scale(1.06);
    box-shadow: 0 14px 26px -6px rgba(233, 79, 55, 0.7);
  }

  .fixed-form-btn:focus-visible {
    outline: 3px solid var(--color-cyan);
    outline-offset: 3px;
  }

  .fixed-form-btn .material-symbols-outlined {
    font-size: 24px;
    line-height: 1;
  }

  /* Tooltip on hover/focus */
  .fixed-form-btn__tooltip {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    transform: translateY(-50%) translateX(6px);
    background: #0f172a;
    color: var(--color-light);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.25);
    pointer-events: none;
    opacity: 0;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .fixed-form-btn__tooltip::after {
    content: "";
    position: absolute;
    right: -4px;
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
    width: 8px;
    height: 8px;
    background: #0f172a;
  }

  .fixed-form-btn:hover .fixed-form-btn__tooltip,
  .fixed-form-btn:focus-visible .fixed-form-btn__tooltip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  /* Mobile sizing */
  @media (max-width: 640px) {
    .back-to-top {
      right: 1rem;
      bottom: 1rem;
      width: 44px;
      height: 44px;
    }

    .fixed-form-btn {
      right: 1rem;
      bottom: calc(1rem + 44px + 0.65rem);
      width: 44px;
      height: 44px;
    }

    .fixed-form-btn__tooltip {
      display: none;
    }
  }

  /* ---------- Contact Modal ---------- */
  .contact-modal {
    padding: 0;
    border: none;
    border-radius: 16px;
    background: transparent;
    max-width: 560px;
    width: 92%;
    box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.45);
    overflow: visible;
  }

  .contact-modal::backdrop {
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(5px);
  }

  .contact-modal__inner {
    background: var(--color-light);
    padding: 2.25rem 2rem 2rem;
    border-radius: 16px;
    position: relative;
    max-height: 90vh;
