      src: "/grm-web-icons/social-media-icon.svg",
    },
    accents: [
      {
        src: "/grm-web-assets/999-hearts-likes-graphic.svg",
        placement: "top-right",
      },
      {
        src: "/grm-web-assets/3d-chat-bubbles-graphic.svg",
