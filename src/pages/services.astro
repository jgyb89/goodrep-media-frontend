      src: "/grm-web-icons/amazon-marketing-icon.svg",
    },
    accents: [
      {
        src: "/grm-web-assets/pc-screen-online-marketplace-graphic.svg",
        placement: "top-right",
      },
      {
        src: "/grm-web-assets/3d-mobile-graphic.svg",
