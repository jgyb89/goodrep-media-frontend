  primaryCta: {
    label: "Book Free Strategy Session",
    href: "#consultation",
  },
  secondaryCta: {
    label: "Explore Our Work",
    href: "/work",
  },
  art: {
    blob: {
      src: "/grm-web-assets/blue-circular-background-graphic.svg",
      width: 746,
      height: 780,
      parallax: 22,
    },
    main: {
      src: "/grm-main-graphics/monitor-with-rocket-launching.webp",
      alt: "Scale your business with Good Rep Media full-service marketing",
      width: 746,
      height: 780,
      parallax: -28,
    },
    badges: [
      {
        src: "/grm-web-assets/3d-bar-graph-going-up-graphic.svg",
        alt: "",
        width: 746,
        height: 780,
        parallax: -36,
        className: "ready-band__badge--growth",
      },
      {
        src: "/grm-web-assets/award-trophy-graphic.svg",
        alt: "",
        width: 746,
        height: 780,
        parallax: -48,
        className: "ready-band__badge--handshake",
      },
    ],
  },
};

