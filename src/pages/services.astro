---

<MainLayout
  title="Our Services | Good Rep Media - Small Business Digital Marketing"
  description="Explore Good Rep Media's full suite of digital marketing services: Website Design, Local SEO, Paid Ads, Social Media, Video Production, and E-Commerce."
>
  <!-- SERVICES HERO -->
  <section class="services-hero">
    <div class="container services-hero__container">
      <div class="services-hero__content" data-reveal>
        <span class="services-hero__kicker">FULL-SERVICE DIGITAL MARKETING</span
        >
        <h1 class="services-hero__title">
          Everything Your Small Business Needs To <span class="text-cyan"
            >Scale Online</span
          >
        </h1>
        <p class="services-hero__lead">
          From high-converting custom websites to full-funnel search and paid
          marketing, we provide hands-on, transparent support that turns digital
          marketing into measurable revenue.
        </p>
        <div class="services-hero__actions">
          <a href="#consultation" class="btn btn--primary"
            >Book Free 30-Min Strategy Call</a
          >
          <a href="#services-catalog" class="btn btn--outline"
            >Browse All Services</a
          >
        </div>
      </div>

      <div class="services-hero__graphic" aria-hidden="true" data-reveal>
        <div class="services-hero__art">
          <img
            class="services-hero__blob"
            src="/grm-web-assets/blue-circular-background-graphic.svg"
            alt=""
            width="746"
            height="780"
          />
          <img
            class="services-hero__main"
            src="/grm-main-graphics/monitor-with-rocket-launching.webp"
            alt="Good Rep Media Services"
            width="746"
            height="780"
            fetchpriority="high"
          />
          <img
            class="services-hero__badge services-hero__badge--growth"
            data-float
            src="/grm-web-assets/3d-bar-graph-going-up-graphic.svg"
            alt=""
            width="746"
            height="780"
            loading="lazy"
          />
          <img
            class="services-hero__badge services-hero__badge--target"
            data-float
            src="/grm-web-assets/award-trophy-graphic.svg"
            alt=""
            width="746"
            height="780"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- QUICK ANCHOR NAV -->
  <nav class="services-nav" aria-label="Services Navigation">
    <div class="container services-nav__container">
      <span class="services-nav__label">Jump to:</span>
      <div class="services-nav__pills">
        {
          servicesList.map((s) => (
            <a class="services-nav__pill" href={`#${s.id}`}>
              {s.kicker.split("&")[0]}
            </a>
          ))
        }
      </div>
    </div>
  </nav>

  <!-- SERVICES CATALOG -->
  <section class="section services-catalog" id="services-catalog">
    <div class="container">
      <div class="services-catalog__list">
        {
          servicesList.map((service, idx) => (
            <article
              class:list={[
                "service-block",
                { "service-block--reverse": idx % 2 === 1 },
              ]}
              id={service.id}
              data-reveal
            >
              <div class="service-block__media">
                <div class="service-block__frame" aria-hidden="true">
                  <div class="service-block__circle">
                    <img
                      class="service-block__main"
                      src={service.main.src}
                      alt={service.title}
                      width="160"
                      height="160"
                      data-no-lightbox
                      loading="lazy"
                    />
                  </div>
                  {service.accents.map((acc) => (
                    <img
                      class:list={[
                        "service-block__accent",
                        acc.placement && `service-block__accent--${acc.placement}`,
                      ]}
                      data-float
                      src={acc.src}
                      alt=""
                      width="240"
                      height="240"
                      data-no-lightbox
                      loading="lazy"
                    />
                  ))}
                </div>
              </div>

              <div class="service-block__content">
                <span class="eyebrow">{service.kicker}</span>
                <h2 class="service-block__title">{service.title}</h2>
                <p class="service-block__text">{service.desc}</p>

                <ul class="checklist">
                  {service.features.map((feat) => (
                    <li>{feat}</li>
                  ))}
                </ul>

                <div class="service-block__cta">
                  <a
                    href={service.href || "#consultation"}
                    class="btn btn--primary"
                  >
                    Get Started With {service.kicker.split("&")[0]}
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- READY BAND -->
  <ReadyBand {...readyData} />

  <!-- CONSULTATION BANNER -->
  <ConsultSection
    id="consultation"
    kicker="Ready to grow?"
    title="Let's Build Your Custom Marketing Plan"
    text="Schedule a free 30-minute consultation. We'll evaluate your current presence, audit competitor traffic, and share a step-by-step roadmap tailored to your budget."
    cardTitle="Book Your Free Consultation"
    submitLabel="Get My Custom Plan"
  />

  <!-- GSAP ANIMATIONS -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      // Hero entrance
      gsap.from(".services-hero__content > *", {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.15,
        ease: "power3.out",
        delay: 0.2,
      });

      gsap.from(".services-hero__blob", {
        scale: 0.85,
        opacity: 0,
        duration: 1.1,
        ease: "power3.out",
        delay: 0.2,
      });

      gsap.from(".services-hero__main", {
        scale: 0.9,
        opacity: 0,
        duration: 1,
        ease: "power3.out",
        delay: 0.3,
      });

      gsap.from(".services-hero__badge", {
        scale: 0,
        opacity: 0,
        duration: 0.8,
        stagger: 0.14,
        ease: "back.out(2)",
        delay: 0.55,
      });

      // Gentle continuous float for decorative layers
      gsap.utils.toArray<HTMLElement>("[data-float]").forEach((el, i) => {
        gsap.to(el, {
          y: -12,
          rotation: i % 2 ? 3 : -3,
          duration: 2.5 + (i % 3) * 0.45,
          ease: "sine.inOut",
          yoyo: true,
          repeat: -1,
          delay: (i % 4) * 0.25,
        });
      });

      // Scroll reveals for service blocks
      gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
        gsap.from(el, {
          y: 40,
          opacity: 0,
          duration: 0.8,
          ease: "power3.out",
          scrollTrigger: {
            trigger: el,
            start: "top 85%",
            once: true,
          },
        });
      });
    });
  </script>

  <style>
    /* ---------- Hero ---------- */
    .services-hero {
      background-color: var(--color-bg);
      padding: clamp(3rem, 6vw, 5rem) 0 clamp(2rem, 4vw, 4rem);
      border-bottom: 1px solid var(--color-border);
      position: relative;
      overflow: hidden;
    }

    .services-hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(
        rgba(27, 196, 217, 0.18) 1.5px,
        transparent 1.5px
      );
      background-size: 28px 28px;
      mask-image: radial-gradient(ellipse at 80% 50%, #000 0%, transparent 70%);
      pointer-events: none;
    }

    .services-hero__container {
      display: grid;
      gap: 3rem;
      align-items: center;
    }

    @media (min-width: 960px) {
      .services-hero__container {
        grid-template-columns: 6fr 5fr;
      }
    }

    .services-hero__kicker {
      display: block;
      color: #64748b;
      font-weight: 600;
      font-size: 0.85rem;
      letter-spacing: 1.5px;
      margin-bottom: 0.75rem;
    }

    .services-hero__title {
      font-size: clamp(2.2rem, 4.5vw, 3.2rem);
      font-weight: 700;
      line-height: 1.18;
      letter-spacing: -0.01em;
      margin: 0 0 1.25rem;
    }

    .text-cyan {
      color: var(--color-cyan);
    }

    .services-hero__lead {
      color: var(--color-muted);
      font-size: 1.1rem;
      line-height: 1.7;
      margin: 0 0 2rem;
    }

    .services-hero__actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .services-hero__graphic {
      display: flex;
      justify-content: center;
    }

    .services-hero__art {
      position: relative;
      width: 100%;
      max-width: 500px;
      aspect-ratio: 1 / 0.92;
    }

    .services-hero__art img {
      position: absolute;
      height: auto !important;
      max-height: none !important;
      object-fit: contain;
      pointer-events: none;
    }

    .services-hero__blob {
      width: 88%;
      left: 6%;
      top: 4%;
      z-index: 0;
    }

    .services-hero__line {
      width: 78%;
      left: 11%;
      top: 10%;
      z-index: 1;
      opacity: 0.72;
    }

    .services-hero__main {
      width: 60%;
      left: 20%;
      top: 14%;
      z-index: 2;
      filter: drop-shadow(0 22px 28px rgba(15, 23, 42, 0.22));
    }

    .services-hero__badge {
      max-width: 28% !important;
      z-index: 3;
      filter: drop-shadow(0 14px 20px rgba(15, 23, 42, 0.25));
    }

    .services-hero__badge--web {
      width: 28%;
      left: 2%;
      top: 6%;
    }

    .services-hero__badge--growth {
      width: 24%;
      right: 2%;
      top: 4%;
    }

    .services-hero__badge--target {
      width: 25%;
      left: 4%;
      bottom: 6%;
    }

    .services-hero__badge--heart {
      width: 20%;
      right: 6%;
      bottom: 6%;
    }

    /* ---------- Quick Nav ---------- */
    .services-nav {
      background: var(--color-light);
      border-bottom: 1px solid var(--color-border);
      position: sticky;
      top: var(--header-h);
      z-index: 30;
      backdrop-filter: blur(10px);
    }

    .services-nav__container {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding-top: 0.85rem;
      padding-bottom: 0.85rem;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .services-nav__container::-webkit-scrollbar {
      display: none;
    }

    .services-nav__label {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--color-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      white-space: nowrap;
    }

    .services-nav__pills {
      display: flex;
      gap: 0.5rem;
    }

    .services-nav__pill {
      display: inline-block;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--color-dark);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      padding: 0.35rem 0.85rem;
      border-radius: 999px;
      text-decoration: none;
      white-space: nowrap;
      transition: all 0.2s ease;
    }

    .services-nav__pill:hover {
      background: var(--color-cyan-soft);
      border-color: var(--color-cyan);
      color: var(--color-cyan-dark);
    }

    /* ---------- Catalog List ---------- */
    .services-catalog {
      background: var(--color-light);
    }

    .services-catalog__list {
      display: grid;
      gap: clamp(4rem, 8vw, 7rem);
    }

    .service-block {
      display: grid;
      gap: 3rem;
      align-items: center;
      scroll-margin-top: calc(var(--header-h) + 4rem);
    }

    @media (min-width: 960px) {
      .service-block {
        grid-template-columns: 1fr 1fr;
        gap: 5rem;
      }
      .service-block--reverse .service-block__media {
        order: 2;
      }
    }

    .service-block__frame {
      position: relative;
      width: 100%;
      max-width: 520px;
      margin: 0 auto;
      aspect-ratio: 1 / 0.88;
      border-radius: 24px;
      background:
        radial-gradient(
          circle at 50% 50%,
          rgba(27, 196, 217, 0.18),
          transparent 70%
        ),
        linear-gradient(155deg, #f3fbfc 0%, #eef7fa 100%);
      border: 1px solid var(--color-border);
      overflow: visible;
      transition:
        transform 0.35s ease,
        border-color 0.35s ease;
    }

    .service-block:hover .service-block__frame {
      transform: translateY(-4px);
      border-color: rgba(27, 196, 217, 0.4);
    }

    .service-block__frame > img {
      position: absolute;
      height: auto !important;
      max-height: none !important;
      object-fit: contain;
      pointer-events: none;
    }

    .service-block__circle {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 52%;
      aspect-ratio: 1;
      border-radius: 50%;
      background: #ffffff;
      border: 1px solid rgba(27, 196, 217, 0.25);
      box-shadow: 0 14px 28px rgba(15, 23, 42, 0.08), 0 4px 12px rgba(27, 196, 217, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
      transition: transform 0.45s ease, box-shadow 0.45s ease;
    }

    .service-block:hover .service-block__circle {
      transform: translate(-50%, -54%) scale(1.03);
      box-shadow: 0 20px 38px rgba(15, 23, 42, 0.12), 0 6px 18px rgba(27, 196, 217, 0.16);
    }

    .service-block__main {
      width: 56%;
      height: 56%;
      max-width: 56%;
      max-height: 56%;
      object-fit: contain;
      pointer-events: none;
      filter: drop-shadow(0 4px 10px rgba(15, 23, 42, 0.08));
    }

    .service-block__accent {
      z-index: 3;
      filter: drop-shadow(0 12px 18px rgba(15, 23, 42, 0.22));
    }

