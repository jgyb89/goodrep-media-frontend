---
import MainLayout from "../layouts/MainLayout.astro";
import LeadForm from "../components/LeadForm.jsx";
import { Image } from "astro:assets";

const pillars = [
  {
    title: "Hands-On Partnership",
    desc: "You never get passed off to an overseas call center or junior trainee. You work directly with experienced digital strategists who learn your business inside and out.",
    img: "/Asset 33.webp",
    w: 438,
    h: 152,
  },
  {
    title: "Engineered For Growth",
    desc: "Every design choice, keyword target, and ad dollar is tied directly to customer acquisition. We focus on phones ringing and booked calendars, not vanity traffic.",
    img: "/Asset 4.webp",
    w: 291,
    h: 419,
  },
  {
    title: "Small Business Dedicated",
    desc: "We specialize exclusively in local and small businesses. We understand tight budgets, busy owner schedules, and the critical need for fast, proven return on investment.",
    img: "/Asset 7.webp",
    w: 656,
    h: 302,
  },
  {
    title: "Radical Transparency",
    desc: "No long lock-in contracts, no hidden markups, and no technical jargon. You receive clear monthly reporting and live dashboards tracking every dollar and conversion.",
    img: "/Asset 34.webp",
    w: 152,
    h: 162,
  },
];
---

<MainLayout
  title="About Us | Goodrep Media - Grand Rapids Marketing Agency"
  description="Learn about Good Rep Media, an authentic digital marketing partner for small and local businesses based in Grand Rapids, Michigan."
>
  <!-- ABOUT HERO -->
  <section class="about-hero">
    <div class="container about-hero__container">
      <div class="about-hero__content" data-reveal>
        <span class="about-hero__kicker">ABOUT GOOD REP MEDIA</span>
        <h1 class="about-hero__title">
          A Marketing Agency That Feels Like <span class="text-cyan">Part of Your Team</span>
        </h1>
        <p class="about-hero__lead">
          We founded Good Rep Media on a simple premise: small and local businesses deserve honest, high-caliber marketing without corporate jargon, bloated retainers, or generic templates.
        </p>
        <div class="about-hero__actions">
          <a href="#our-story" class="btn btn--primary">Our Story &amp; Values</a>
          <a href="#consultation" class="btn btn--outline">Meet The Team</a>
        </div>
      </div>

      <div class="about-hero__graphic" aria-hidden="true" data-reveal>
        <div class="about-hero__art">
          <Image
            class="about-hero__main"
            src="/grm-about-us.webp"
            alt="About Good Rep Media team and story"
            width={1909}
            height={1397}
            loading="eager"
            decoding="async"
          />
          <img
            class="about-hero__badge about-hero__badge--handshake"
            src="/Asset 33.webp"
            alt=""
            width="438"
            height="152"
          />
          <img
            class="about-hero__badge about-hero__badge--store"
            src="/Asset 7.webp"
            alt=""
            width="656"
            height="302"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- STORY SECTION -->
  <section class="section about-story" id="our-story">
    <div class="container about-story__grid">
      <div class="about-story__content" data-reveal>
        <span class="eyebrow">Our Mission</span>
        <h2 class="section-title">Rooted in Grand Rapids, Dedicated to Small Business Growth</h2>
        <p class="about-story__text">
          Good Rep Media was born out of frustration with how most digital agencies treat small businesses. Too often, small business owners are sold expensive packages with vague promises, locked into confusing contracts, and left wondering where their money actually went.
        </p>
        <p class="about-story__text">
          We do things differently. Based on Lake Michigan Drive in Grand Rapids, Michigan, we believe in radical transparency, responsive communication, and marketing strategies that directly impact your bottom line. Whether you are a local contractor, medical clinic, spa, or retailer, we treat your business with the care, hustle, and respect it deserves.
        </p>
        <div class="about-story__highlights">
          <div class="highlight-item">
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <span>100% In-House Strategy &amp; Execution</span>
          </div>
          <div class="highlight-item">
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <span>No Long-Term Lock-In Contracts</span>
          </div>
          <div class="highlight-item">
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <span>Transparent Live ROI Dashboards</span>
          </div>
        </div>
      </div>

      <div class="about-story__media" data-reveal>
        <div class="about-story__frame">
          <Image
            src="/grm-partner-with-us.webp"
            alt="Illustration of our collaborative partnership process"
            width={1790}
            height={1113}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- PILLARS / VALUES -->
  <section class="section about-pillars">
    <div class="container">
      <header class="section-head text-center" data-reveal>
        <span class="eyebrow">Our Core Principles</span>
        <h2 class="section-title">The Values That Guide Every Project</h2>
        <p class="section-lead">
          We hold ourselves to the highest standards of craft, accountability, and integrity.
        </p>
      </header>

      <div class="pillars-grid" data-reveal>
        {pillars.map((pillar) => (
          <div class="pillar-card">
            <div class="pillar-card__icon-wrap">
              <img
                src={pillar.img}
                alt=""
                width={pillar.w}
                height={pillar.h}
                loading="lazy"
              />
            </div>
            <h3 class="pillar-card__title">{pillar.title}</h3>
            <p class="pillar-card__desc">{pillar.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LOCAL COMMUNITY MAP RIBBON -->
  <section class="local-ribbon">
    <div class="container local-ribbon__container" data-reveal>
      <div class="local-ribbon__text">
        <span class="local-ribbon__kicker">GRAND RAPIDS, MI</span>
        <h2 class="local-ribbon__title">Proudly Supporting Midwest &amp; Michigan Businesses</h2>
        <p class="local-ribbon__desc">
          We love meeting our clients face-to-face over coffee or jumping on a quick screen share. Located at O-745 Lake Michigan Dr. NW, we're proud to serve West Michigan businesses and forward-thinking companies nationwide.
        </p>
      </div>
      <div class="local-ribbon__action">
        <a href="#consultation" class="btn btn--primary">Schedule a Local Strategy Session</a>
      </div>
    </div>
  </section>

  <!-- CONSULTATION BANNER -->
  <section class="consult" id="consultation">
    <div class="container consult__layout">
      <div class="consult__intro" data-reveal>
        <p class="consult__kicker">Get in touch with us</p>
        <h2 class="consult__title">Let's Grab Coffee or Talk Strategy</h2>
        <p class="consult__text">
          Whether you have a specific question about your Google ranking or need a complete digital marketing roadmap, we're here to help.
        </p>
        <ul class="consult__contact">
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">call</span>
            <a href="tel:+16163009868">(616) 300-9868</a>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">mail</span>
            <a href="mailto:team@goodrep.media">team@goodrep.media</a>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
            <span>Grand Rapids, Michigan</span>
          </li>
        </ul>
      </div>

      <div class="consult__card" data-reveal>
        <h3 class="consult__card-title">Send Us A Message</h3>
        <LeadForm client:visible submitLabel="Send Message" />
      </div>
    </div>
  </section>

  <!-- GSAP ANIMATIONS -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.from(".about-hero__content > *", {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.15,
        ease: "power3.out",
        delay: 0.2,
      });

      gsap.from(".about-hero__main", {
        scale: 0.9,
        opacity: 0,
        duration: 1,
        ease: "power3.out",
        delay: 0.3,
      });

      gsap.from(".about-hero__badge", {
        scale: 0,
        opacity: 0,
        duration: 0.8,
        stagger: 0.2,
        ease: "back.out(2)",
        delay: 0.5,
      });

      gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
        gsap.from(el, {
          y: 40,
          opacity: 0,
          duration: 0.8,
          ease: "power3.out",
          scrollTrigger: {
            trigger: el,
            start: "top 85%",
            once: true,
          },
        });
      });
    });
  </script>

  <style>
    /* ---------- Hero ---------- */
    .about-hero {
      background-color: var(--color-bg);
      padding: clamp(3rem, 6vw, 5rem) 0 clamp(2rem, 4vw, 4rem);
      border-bottom: 1px solid var(--color-border);
      position: relative;
      overflow: hidden;
    }

    .about-hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(
        rgba(27, 196, 217, 0.18) 1.5px,
        transparent 1.5px
      );
      background-size: 28px 28px;
      mask-image: radial-gradient(ellipse at 80% 50%, #000 0%, transparent 70%);
      pointer-events: none;
    }

    .about-hero__container {
      display: grid;
      gap: 3rem;
      align-items: center;
    }

    @media (min-width: 960px) {
      .about-hero__container {
        grid-template-columns: 6fr 5fr;
      }
    }

    .about-hero__kicker {
      display: block;
      color: #64748b;
      font-weight: 600;
      font-size: 0.85rem;
      letter-spacing: 1.5px;
      margin-bottom: 0.75rem;
    }

    .about-hero__title {
      font-size: clamp(2.2rem, 4.5vw, 3.2rem);
      font-weight: 700;
      line-height: 1.18;
      letter-spacing: -0.01em;
      margin: 0 0 1.25rem;
    }

    .text-cyan {
      color: var(--color-cyan);
    }

    .about-hero__lead {
      color: var(--color-muted);
      font-size: 1.1rem;
      line-height: 1.7;
      margin: 0 0 2rem;
    }

    .about-hero__actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .about-hero__graphic {
      display: flex;
      justify-content: center;
    }

    .about-hero__art {
      position: relative;
      width: 100%;
      max-width: 520px;
      aspect-ratio: 1.3 / 1;
    }

    .about-hero__main {
      width: 100%;
      height: auto;
      border-radius: 20px;
      display: block;
    }

    .about-hero__badge {
      position: absolute;
      height: auto;
      filter: drop-shadow(0 14px 20px rgba(15, 23, 42, 0.25));
    }

    .about-hero__badge--handshake {
      width: 38%;
      left: -6%;
      bottom: -6%;
    }

    .about-hero__badge--store {
      width: 32%;
      right: -4%;
      top: -8%;
    }

    /* ---------- Story Section ---------- */
    .about-story {
      background: var(--color-light);
    }

    .about-story__grid {
      display: grid;
      gap: 4rem;
      align-items: center;
    }

    @media (min-width: 960px) {
      .about-story__grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    .about-story__text {
      color: var(--color-muted);
      font-size: 1.05rem;
      line-height: 1.8;
      margin: 0 0 1.25rem;
    }

    .about-story__highlights {
      display: grid;
      gap: 0.85rem;
      margin-top: 1.75rem;
    }

    .highlight-item {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-weight: 600;
      color: var(--color-dark);
    }

    .highlight-item .material-symbols-outlined {
      color: var(--color-cyan);
      font-size: 1.3rem;
    }

    .about-story__frame {
      border-radius: 20px;
      overflow: hidden;
    }

    .about-story__frame img {
      width: 100%;
      height: auto;
      display: block;
    }

    /* ---------- Pillars Grid ---------- */
    .about-pillars {
      background: var(--color-accent);
    }

    .pillars-grid {
      display: grid;
      gap: 2rem;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      margin-top: 3rem;
    }

    .pillar-card {
      background: var(--color-light);
      border-radius: 16px;
      padding: 2.25rem 1.75rem;
      box-shadow: var(--shadow-card);
      text-align: center;
      border: 1px solid var(--color-border);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .pillar-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lift);
    }

    .pillar-card__icon-wrap {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      background: var(--color-bg);
      display: grid;
      place-items: center;
      margin: 0 auto 1.5rem;
    }

    .pillar-card__icon-wrap img {
      max-width: 65%;
      max-height: 65px;
      width: auto;
      object-fit: contain;
    }

    .pillar-card__title {
      font-size: 1.2rem;
      margin: 0 0 0.75rem;
    }

    .pillar-card__desc {
      color: var(--color-muted);
      font-size: 0.95rem;
      line-height: 1.6;
      margin: 0;
    }

    /* ---------- Local Ribbon ---------- */
    .local-ribbon {
      background:
        linear-gradient(rgba(15, 23, 42, 0.9), rgba(15, 23, 42, 0.9)),
        url("/grm-map-background-blue.webp") center/cover no-repeat;
      color: var(--color-light);
      padding: clamp(3.5rem, 7vw, 5.5rem) 0;
      border-top: 4px solid var(--color-cyan);
    }

    .local-ribbon__container {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      align-items: flex-start;
      justify-content: space-between;
    }

    @media (min-width: 860px) {
      .local-ribbon__container {
        flex-direction: row;
        align-items: center;
      }
      .local-ribbon__text {
        max-width: 65%;
      }
    }

    .local-ribbon__kicker {
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      color: var(--color-cyan);
      display: block;
      margin-bottom: 0.5rem;
    }

    .local-ribbon__title {
      color: var(--color-light);
      font-size: clamp(1.8rem, 3.2vw, 2.4rem);
      margin: 0 0 1rem;
    }

    .local-ribbon__desc {
      color: #cbd5e1;
      font-size: 1.05rem;
      line-height: 1.7;
      margin: 0;
    }

    /* ---------- Consultation ---------- */
    .consult {
      background: var(--color-cyan);
      color: var(--color-light);
      padding: clamp(4rem, 8vw, 6rem) 0;
    }

    .consult__layout {
      display: grid;
      gap: 3rem;
      align-items: center;
    }

    @media (min-width: 960px) {
      .consult__layout {
        grid-template-columns: 5fr 6fr;
        gap: 4rem;
      }
    }

    .consult__kicker {
      font-size: 1.05rem;
      margin: 0 0 0.5rem;
    }

    .consult__title {
      font-size: clamp(2rem, 3.5vw, 2.6rem);
      margin: 0 0 1rem;
      color: var(--color-light);
    }

    .consult__text {
      font-size: 1.05rem;
      line-height: 1.7;
      margin: 0 0 1.5rem;
    }

    .consult__contact {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.5rem;
    }

    .consult__contact li {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 600;
    }

    .consult__contact a {
      color: var(--color-light);
      text-decoration: none;
    }

    .consult__contact a:hover {
      text-decoration: underline;
    }

    .consult__card {
      background: var(--color-light);
      color: var(--color-dark);
      border-radius: 16px;
      padding: clamp(1.5rem, 3vw, 2.5rem);
      box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.35);
    }

    .consult__card-title {
      color: var(--color-cyan);
      font-size: 1.6rem;
      margin: 0 0 1.5rem;
    }
  </style>
</MainLayout>
