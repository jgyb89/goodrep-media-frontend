---
import DOMPurify from "isomorphic-dompurify";
import {
  fetchWP,
  getCategories,
  DEFAULT_CATEGORIES,
  decodeHtmlEntities,
} from "../../lib/api.js";
import MainLayout from "../../layouts/MainLayout.astro";
import LeadForm from "../../components/LeadForm.jsx";
import { Image } from "astro:assets";

let posts: any[] = [];
let wpCategories = DEFAULT_CATEGORIES;

try {
  wpCategories = await getCategories();
  const data = await fetchWP(`
    query GetBlogFeed {
      posts(first: 200) {
        nodes {
          id
          title
          slug
          excerpt
          date
          featuredImage {
            node {
              sourceUrl
              altText
            }
          }
        }
      }
    }
  `);
  posts = (data?.posts?.nodes || []).map((post: any) => ({
    ...post,
    excerpt: decodeHtmlEntities(
      DOMPurify.sanitize(post.excerpt || "", { ALLOWED_TAGS: [] }),
    ).trim(),
  }));
} catch (error: any) {
  console.warn("Could not fetch posts for blog feed:", error?.message || error);
}

// Compute live counts per category from fetched posts, falling back to WP count
const categoryCounts = new Map<string, number>();
for (const post of posts) {
  for (const cat of post.categories || []) {
    if (cat?.slug) {
      categoryCounts.set(cat.slug, (categoryCounts.get(cat.slug) || 0) + 1);
    }
  }
}

const categories = [
  {
    name: "All Articles",
    slug: "all",
    count: posts.length > 0 ? posts.length : 127,
  },
  ...wpCategories.map((cat: any) => ({
    name: cat.name,
    slug: cat.slug,
    count:
      posts.length > 0
        ? (categoryCounts.get(cat.slug) ?? cat.count ?? 0)
        : (cat.count ?? 0),
  })),
];
---

<MainLayout
  title="Knowledge Center & Blog | Goodrep Media - Marketing Insights"
  description="Practical digital marketing strategies, SEO tactics, and growth tips written specifically for small and local business owners."
>
  <!-- BLOG HERO -->
  <section class="blog-hero">
    <div class="container blog-hero__container">
      <div class="blog-hero__content" data-reveal>
        <span class="blog-hero__kicker">KNOWLEDGE CENTER &amp; STRATEGY</span>
        <h1 class="blog-hero__title">
          Actionable Marketing Insights To <span class="text-cyan"
            >Attract More Customers</span
          >
        </h1>
        <p class="blog-hero__lead">
          No fluff, no vanity metrics. Just practical, proven digital marketing
          guides, search engine optimization breakdowns, and growth tactics for
          small business owners.
        </p>
      </div>

      <div class="blog-hero__graphic" aria-hidden="true" data-reveal>
        <div class="blog-hero__art">
          <Image
            class="blog-hero__main"
            src="/grm-attract-users-resources.webp"
            alt="Digital marketing resources and guides"
            width={1809}
            height={1381}
            loading="eager"
            decoding="async"
          />
          <img
            class="blog-hero__badge blog-hero__badge--chart"
            src="/Asset 43.webp"
            alt=""
            width="183"
            height="237"
          />
          <img
            class="blog-hero__badge blog-hero__badge--msg"
            src="/Asset 50.webp"
            alt=""
            width="186"
            height="108"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- BLOG FEED & CATEGORY LAYOUT -->
  <section class="section blog-feed">
    <div class="container blog-feed__container">
      <div class="blog-layout">
        <!-- LEFT SIDEBAR ON DESKTOP (> 980px) / HORIZONTAL PILL BAR ON TABLET & PHONE (<= 980px) -->
        <aside class="blog-layout__sidebar" aria-label="Article categories">
          <div class="blog-sidebar__header">Categories</div>
          <nav class="blog-nav" aria-label="Filter articles by category">
            <div class="blog-nav__pills" role="group">
              {
                categories.map((cat, idx) => (
                  <button
                    type="button"
                    class:list={["blog-nav__pill", { "is-active": idx === 0 }]}
                    data-category={cat.slug}
                    data-category-name={cat.name}
                    aria-pressed={idx === 0 ? "true" : "false"}
                  >
                    <span class="blog-nav__pill-label">{cat.name}</span>
                    <span class="blog-nav__pill-count">{cat.count}</span>
                  </button>
                ))
              }
            </div>
          </nav>
        </aside>

        <!-- RIGHT CONTENT COLUMN (POSTS GRID) -->
        <div class="blog-layout__main">
          {
            posts.length > 0 ? (
              <>
                <div class="blog-feed__toolbar" id="blog-filter-toolbar">
                  <div class="blog-feed__toolbar-left">
                    <div class="blog-feed__search">
                      <span
                        class="material-symbols-outlined blog-feed__search-icon"
                        aria-hidden="true"
                      >
                        search
                      </span>
                      <input
                        type="search"
                        id="blog-search-input"
                        class="blog-feed__search-input"
                        placeholder="Search marketing articles, SEO tips, ads..."
                        aria-label="Search articles"
                      />
                      <button
                        type="button"
                        id="blog-search-btn"
                        class="btn btn--primary blog-feed__search-btn"
                      >
                        Search
                      </button>
                    </div>
                    <p class="blog-feed__status" aria-live="polite">
                      Showing{" "}
                      <strong id="blog-visible-count">{posts.length}</strong>{" "}
                      <span id="blog-visible-label">articles</span> in{" "}
                      <strong id="blog-active-category">All Articles</strong>
                    </p>
                  </div>
                  <button
                    type="button"
                    id="blog-reset-btn"
                    class="blog-feed__reset"
                    hidden
                  >
                    Reset Filters
                  </button>
                </div>

                <div
                  class="blog-feed__grid"
                  id="blog-posts-grid"
                  data-reveal-group
                >
                  {posts.map((post) => {
                    const catSlugs = (post.categories || [])
                      .map((c: any) => c.slug)
                      .filter(Boolean)
                      .join(",");
                    const primaryCat = post.primaryCategory || {
                      name: "Small Business Marketing & Strategy",
                      slug: "small-business-marketing-strategy",
                    };

                    return (
                      <article
                        class="post-card"
                        data-categories={catSlugs}
                        data-search={`${post.title} ${post.excerpt} ${(post.categories || []).map((c: any) => c.name).join(" ")}`.toLowerCase()}
                      >
                        <a
                          class="post-card__media"
                          href={`/blog/${post.slug}`}
                          tabindex="-1"
                          aria-hidden="true"
                        >
                          {post.featuredImage?.node?.sourceUrl ? (
                            <img
                              src={post.featuredImage.node.sourceUrl}
                              alt={
                                post.featuredImage.node.altText || post.title
                              }
                              loading="lazy"
                              width="600"
                              height="375"
                            />
                          ) : (
                            <img
                              class="post-card__placeholder"
                              src="/Asset 43.webp"
                              alt=""
                              loading="lazy"
                              width="183"
                              height="237"
                            />
                          )}
                        </a>
                        <div class="post-card__body">
                          <button
                            type="button"
                            class="post-card__tag"
                            data-filter-category={primaryCat.slug}
                            title={`Filter by ${primaryCat.name}`}
                          >
                            {primaryCat.name}
                          </button>
                          <h2 class="post-card__title">
                            <a href={`/blog/${post.slug}`}>{post.title}</a>
                          </h2>
                          <p
                            class="post-card__excerpt"
                            set:html={post.excerpt}
                          />
                          <a
                            class="post-card__more"
                            href={`/blog/${post.slug}`}
                            aria-label={`Read more: ${post.title}`}
                          >
                            Read Full Guide{" "}
                            <span
                              class="material-symbols-outlined"
                              aria-hidden="true"
                            >
                              arrow_forward
                            </span>
                          </a>
                        </div>
                      </article>
                    );
                  })}
                </div>

                <!-- DESKTOP PAGINATION (12 articles per page) -->
                <nav
                  class="blog-pagination"
                  id="blog-pagination"
                  aria-label="Blog articles pagination"
                  hidden
                >
                  <button
                    type="button"
                    class="blog-pagination__btn blog-pagination__btn--prev"
                    id="blog-pagination-prev"
                    aria-label="Go to previous page"
                  >
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                    <span>Previous</span>
                  </button>
                  <div class="blog-pagination__pages" id="blog-pagination-pages">
           
                  </div>
                  <button
                    type="button"
                    class="blog-pagination__btn blog-pagination__btn--next"
                    id="blog-pagination-next"
                    aria-label="Go to next page"
                  >
                    <span>Next</span>
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                  </button>
                </nav>

                <!-- MOBILE LOAD MORE (6 articles at a time) -->
                <div class="blog-load-more" id="blog-load-more" hidden>
                  <button
                    type="button"
                    class="btn blog-load-more__btn"
                    id="blog-load-more-btn"
                    aria-controls="blog-posts-grid"
                  >
                    <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
                    <span>Load More Articles</span>
                    <span class="blog-load-more__count" id="blog-load-more-count"></span>
                  </button>
                  <p class="blog-load-more__status" id="blog-load-more-status" aria-live="polite">
                  </p>
                </div>

                <div
                  class="blog-feed__empty text-center"
                  id="blog-no-results"
                  hidden
                >
                  <img src="/Asset 43.webp" alt="" width="183" height="237" />
                  <h2 class="blog-feed__empty-title">
                    No Matching Articles Found
                  </h2>
                  <p class="blog-feed__empty-text">
                    We couldn't find any articles matching your current category
                    or search filter. Try clearing your filter to browse all
                    guides.
                  </p>
                  <button
                    type="button"
                    id="blog-empty-reset-btn"
                    class="btn btn--primary"
                  >
                    Show All Articles
                  </button>
                </div>
              </>
            ) : (
              <div class="blog-feed__empty text-center" data-reveal>
                <img src="/Asset 43.webp" alt="" width="183" height="237" />
                <h2 class="blog-feed__empty-title">Articles Coming Soon!</h2>
                <p class="blog-feed__empty-text">
                  We are currently updating our knowledge center with new
                  marketing guides. In the meantime, feel free to book a free
                  strategy call with our team.
                </p>
                <a href="#consultation" class="btn btn--primary">
                  Book A Strategy Session
                </a>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- VIP SMS / NEWSLETTER RIBBON -->
  <section class="sms-ribbon">
    <div class="container sms-ribbon__container" data-reveal>
      <div class="sms-ribbon__content">
        <span class="sms-ribbon__badge">VIP Small Business Circle</span>
        <h2 class="sms-ribbon__title">
          Get Proven Growth Strategies Sent Directly to Your Phone
        </h2>
        <p class="sms-ribbon__text">
          Join hundreds of local Michigan business owners getting weekly
          tactical tips on SEO, ad spend optimization, and conversion hacks.
        </p>
        <p class="sms-ribbon__callout">
          <span class="material-symbols-outlined" aria-hidden="true"
            >smartphone</span
          >
          Text <strong>JOIN</strong> to <strong>49872</strong> for Exclusive Marketing
          Updates.
        </p>
      </div>
    </div>
  </section>

  <!-- CONSULTATION BANNER -->
  <section class="consult" id="consultation">
    <div class="container consult__layout">
      <div class="consult__intro" data-reveal>
        <p class="consult__kicker">Need personalized guidance?</p>
        <h2 class="consult__title">Book A Free 1-on-1 Marketing Audit</h2>
        <p class="consult__text">
          Instead of guessing what to fix, let our marketing experts audit your
          website and local search presence. We'll show you exactly where to
          focus next.
        </p>
        <ul class="consult__contact">
          <li>
            <span class="material-symbols-outlined" aria-hidden="true"
              >call</span
            >
            <a href="tel:+16163009868">(616) 300-9868</a>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true"
              >mail</span
            >
            <a href="mailto:team@goodrep.media">team@goodrep.media</a>
          </li>
        </ul>
      </div>

      <div class="consult__card" data-reveal>
        <h3 class="consult__card-title">Book Your Free Call</h3>
        <LeadForm client:visible submitLabel="Request Free Audit" />
      </div>
    </div>
  </section>

  <!-- GSAP ANIMATIONS & CATEGORY FILTERING -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // ---------- Category, Search & Responsive Pagination Logic ----------
    const DESKTOP_PAGE_SIZE = 12;
    const MOBILE_PAGE_SIZE = 6;

    const pills = Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        ".blog-nav__pill[data-category]",
      ),
    );
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>(".post-card[data-categories]"),
    );
    const cardCategoryTags = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-filter-category]"),
    );
    const searchInput = document.getElementById(
      "blog-search-input",
    ) as HTMLInputElement | null;
    const searchBtn = document.getElementById("blog-search-btn");
    const visibleCountEl = document.getElementById("blog-visible-count");
    const visibleLabelEl = document.getElementById("blog-visible-label");
    const activeCategoryEl = document.getElementById("blog-active-category");
    const resetBtn = document.getElementById("blog-reset-btn");
    const emptyResetBtn = document.getElementById("blog-empty-reset-btn");
    const noResultsEl = document.getElementById("blog-no-results");
    const postsGridEl = document.getElementById("blog-posts-grid");

    // Pagination & Load More Elements
    const paginationEl = document.getElementById("blog-pagination");
    const paginationPagesEl = document.getElementById("blog-pagination-pages");
    const prevBtn = document.getElementById(
      "blog-pagination-prev",
    ) as HTMLButtonElement | null;
    const nextBtn = document.getElementById(
      "blog-pagination-next",
    ) as HTMLButtonElement | null;
    const loadMoreContainerEl = document.getElementById("blog-load-more");
    const loadMoreBtn = document.getElementById(
      "blog-load-more-btn",
    ) as HTMLButtonElement | null;
    const loadMoreCountEl = document.getElementById("blog-load-more-count");
    const loadMoreStatusEl = document.getElementById("blog-load-more-status");

    let activeCategory = "all";
    let searchQuery = "";
    let currentPage = 1;
    let mobileVisibleCount = MOBILE_PAGE_SIZE;
    let matchingCards: HTMLElement[] = [];

    function isMobileView(): boolean {
      return window.innerWidth <= 768;
    }

    function getPaginationRange(current: number, total: number): (number | string)[] {
      if (total <= 7) {
        return Array.from({ length: total }, (_, i) => i + 1);
      }
      if (current <= 4) {
        return [1, 2, 3, 4, 5, "...", total];
      }
      if (current >= total - 3) {
        return [1, "...", total - 4, total - 3, total - 2, total - 1, total];
      }
      return [1, "...", current - 1, current, current + 1, "...", total];
    }

    function renderDesktopPagination(totalPages: number) {
      if (!paginationEl || !paginationPagesEl || !prevBtn || !nextBtn) return;

      if (totalPages <= 1) {
        paginationEl.hidden = true;
        return;
      }
      paginationEl.hidden = false;

      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;

      paginationPagesEl.innerHTML = "";
      const range = getPaginationRange(currentPage, totalPages);

      range.forEach((item) => {
        if (item === "...") {
          const span = document.createElement("span");
          span.className = "blog-pagination__ellipsis";
          span.textContent = "…";
          span.setAttribute("aria-hidden", "true");
          paginationPagesEl.appendChild(span);
        } else {
          const pageNum = Number(item);
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = `blog-pagination__page${pageNum === currentPage ? " is-active" : ""}`;
          btn.textContent = String(pageNum);
          btn.setAttribute("aria-label", `Page ${pageNum}`);
          if (pageNum === currentPage) {
            btn.setAttribute("aria-current", "page");
          }
          btn.addEventListener("click", () => {
            if (pageNum !== currentPage) {
              goToPage(pageNum);
            }
          });
          paginationPagesEl.appendChild(btn);
        }
      });
    }

    function goToPage(pageNum: number) {
      currentPage = pageNum;
      applyFilters(true, false);

      const toolbarEl = document.getElementById("blog-filter-toolbar");
      if (toolbarEl) {
        const navOffset = 90;
        const elPos =
          toolbarEl.getBoundingClientRect().top + window.scrollY - navOffset;
        window.scrollTo({ top: Math.max(0, elPos), behavior: "smooth" });
      }
    }

    function updateMobileLoadMoreUI() {
      if (!loadMoreContainerEl || !loadMoreBtn || !loadMoreCountEl) return;

      const total = matchingCards.length;
      const visibleLimit = Math.min(mobileVisibleCount, total);

      loadMoreContainerEl.hidden = false;

      if (visibleLimit >= total) {
        loadMoreBtn.hidden = true;
        if (loadMoreStatusEl) {
          loadMoreStatusEl.textContent = `Showing all ${total} ${total === 1 ? "article" : "articles"}`;
        }
      } else {
        loadMoreBtn.hidden = false;
        const remaining = total - visibleLimit;
        const nextBatch = Math.min(MOBILE_PAGE_SIZE, remaining);
        loadMoreCountEl.textContent = `(${nextBatch} more)`;
        if (loadMoreStatusEl) {
          loadMoreStatusEl.textContent = `Showing ${visibleLimit} of ${total} articles`;
        }
      }
    }

    function applyFilters(animate = true, resetPaging = true) {
      if (resetPaging) {
        currentPage = 1;
        mobileVisibleCount = MOBILE_PAGE_SIZE;
      }

      const normalizedQuery = searchQuery.trim().toLowerCase();

      matchingCards = cards.filter((card) => {
        const cardCats = (card.dataset.categories || "")
          .split(",")
          .filter(Boolean);
        const cardSearchText = card.dataset.search || "";

        const matchesCategory =
          activeCategory === "all" || cardCats.includes(activeCategory);
        const matchesSearch =
          !normalizedQuery || cardSearchText.includes(normalizedQuery);

        return matchesCategory && matchesSearch;
      });

      // Update active category pill UI
      let activeCategoryName = "All Articles";
      let matchedPill: HTMLButtonElement | null = null;
      pills.forEach((pill) => {
        const isMatch = pill.dataset.category === activeCategory;
        pill.classList.toggle("is-active", isMatch);
        pill.setAttribute("aria-pressed", isMatch ? "true" : "false");
        if (isMatch) {
          matchedPill = pill;
          if (pill.dataset.categoryName) {
            activeCategoryName = pill.dataset.categoryName;
          }
        }
      });

      // On tablet/phone horizontal scroll strip, keep the active pill centered in view
      if (animate && matchedPill && window.innerWidth <= 980) {
        (matchedPill as HTMLButtonElement).scrollIntoView({
          behavior: "smooth",
          inline: "center",
          block: "nearest",
        });
      }

      // Update active category text in toolbar status
      if (activeCategoryEl) {
        activeCategoryEl.textContent = normalizedQuery
          ? `${activeCategoryName} matching "${searchQuery.trim()}"`
          : activeCategoryName;
      }

      const isFiltered = activeCategory !== "all" || normalizedQuery.length > 0;
      if (resetBtn) {
        resetBtn.hidden = !isFiltered;
      }

      // Empty results state
      if (matchingCards.length === 0) {
        cards.forEach((card) => {
          card.hidden = true;
        });
        if (postsGridEl && noResultsEl) {
          postsGridEl.hidden = true;
          noResultsEl.hidden = false;
        }
        if (paginationEl) paginationEl.hidden = true;
        if (loadMoreContainerEl) loadMoreContainerEl.hidden = true;

        if (visibleCountEl) visibleCountEl.textContent = "0";
        if (visibleLabelEl) visibleLabelEl.textContent = "articles";

        ScrollTrigger.refresh();
        return;
      }

      if (postsGridEl && noResultsEl) {
        postsGridEl.hidden = false;
        noResultsEl.hidden = true;
      }

      const isMobile = isMobileView();
      let cardsToAnimate: HTMLElement[] = [];

      if (isMobile) {
        // MOBILE MODE: 6 at a time with "Load More"
        if (paginationEl) paginationEl.hidden = true;

        const visibleLimit = Math.min(mobileVisibleCount, matchingCards.length);
        const visibleSet = new Set(matchingCards.slice(0, visibleLimit));

        cards.forEach((card) => {
          card.hidden = !visibleSet.has(card);
        });

        updateMobileLoadMoreUI();

        if (visibleCountEl) {
          visibleCountEl.textContent =
            matchingCards.length <= MOBILE_PAGE_SIZE
              ? String(matchingCards.length)
              : `${visibleLimit} of ${matchingCards.length}`;
        }
        if (visibleLabelEl) {
          visibleLabelEl.textContent =
            matchingCards.length === 1 ? "article" : "articles";
        }

        cardsToAnimate = matchingCards.slice(0, visibleLimit);
      } else {
        // DESKTOP MODE: 12 per page with numbered pagination
        if (loadMoreContainerEl) loadMoreContainerEl.hidden = true;

        const totalPages =
          Math.ceil(matchingCards.length / DESKTOP_PAGE_SIZE) || 1;
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        const startIndex = (currentPage - 1) * DESKTOP_PAGE_SIZE;
        const endIndex = startIndex + DESKTOP_PAGE_SIZE;
        const pageCards = matchingCards.slice(startIndex, endIndex);
        const pageSet = new Set(pageCards);

        cards.forEach((card) => {
          card.hidden = !pageSet.has(card);
        });

        renderDesktopPagination(totalPages);

        if (visibleCountEl) {
          visibleCountEl.textContent =
            matchingCards.length <= DESKTOP_PAGE_SIZE
              ? String(matchingCards.length)
              : `${startIndex + 1}–${Math.min(endIndex, matchingCards.length)} of ${matchingCards.length}`;
        }
        if (visibleLabelEl) {
          visibleLabelEl.textContent =
            matchingCards.length === 1 ? "article" : "articles";
        }

        cardsToAnimate = pageCards;
      }

      // Sync URL query params for shareable URLs
      const url = new URL(window.location.href);
      if (activeCategory === "all") {
        url.searchParams.delete("category");
      } else {
        url.searchParams.set("category", activeCategory);
      }
      if (!isMobile && currentPage > 1) {
        url.searchParams.set("page", String(currentPage));
      } else {
        url.searchParams.delete("page");
      }
      window.history.replaceState({}, "", url.toString());

      // Entrance animation for newly shown cards
      if (
        animate &&
        cardsToAnimate.length > 0 &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        gsap.killTweensOf(cardsToAnimate);
        gsap.fromTo(
          cardsToAnimate,
          { autoAlpha: 0, y: 18 },
          {
            autoAlpha: 1,
            y: 0,
            duration: 0.35,
            stagger: { amount: 0.2, from: "start" },
            ease: "power2.out",
            clearProps: "all",
          },
        );
      }

      ScrollTrigger.refresh();
    }

    // Prev / Next button listeners
    prevBtn?.addEventListener("click", () => {
      if (currentPage > 1) {
        goToPage(currentPage - 1);
      }
    });

    nextBtn?.addEventListener("click", () => {
      const totalPages =
        Math.ceil(matchingCards.length / DESKTOP_PAGE_SIZE) || 1;
      if (currentPage < totalPages) {
        goToPage(currentPage + 1);
      }
    });

    // Mobile Load More button listener
    loadMoreBtn?.addEventListener("click", () => {
      const oldLimit = mobileVisibleCount;
      mobileVisibleCount += MOBILE_PAGE_SIZE;
      const newLimit = Math.min(mobileVisibleCount, matchingCards.length);

      const newlyRevealed = matchingCards.slice(oldLimit, newLimit);
      newlyRevealed.forEach((card) => {
        card.hidden = false;
      });

      if (
        newlyRevealed.length > 0 &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        gsap.fromTo(
          newlyRevealed,
          { autoAlpha: 0, y: 20 },
          {
            autoAlpha: 1,
            y: 0,
            duration: 0.35,
            stagger: 0.08,
            ease: "power2.out",
            clearProps: "all",
          },
        );
      }

      updateMobileLoadMoreUI();

      if (visibleCountEl) {
        visibleCountEl.textContent = `${newLimit} of ${matchingCards.length}`;
      }

      ScrollTrigger.refresh();
    });

    // Category pill listeners
    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const selected = pill.dataset.category || "all";
        if (activeCategory === selected && !searchQuery) return;
        activeCategory = selected;
        applyFilters(true, true);
      });
    });

    // Post card category badge listeners
    cardCategoryTags.forEach((tag) => {
      tag.addEventListener("click", () => {
        const selected = tag.dataset.filterCategory || "all";
        activeCategory = selected;
        applyFilters(true, true);
        const feedEl = document.querySelector(".blog-feed");
        feedEl?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    // Search bar listeners
    if (searchInput) {
      searchInput.addEventListener("input", () => {
        searchQuery = searchInput.value;
        applyFilters(false, true);
      });
      searchInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          searchQuery = searchInput.value;
          applyFilters(true, true);
        }
      });
    }

    if (searchBtn && searchInput) {
      searchBtn.addEventListener("click", () => {
        searchQuery = searchInput.value;
        applyFilters(true, true);
      });
    }

    function resetAllFilters() {
      activeCategory = "all";
      searchQuery = "";
      if (searchInput) searchInput.value = "";
      applyFilters(true, true);
    }

    resetBtn?.addEventListener("click", resetAllFilters);
    emptyResetBtn?.addEventListener("click", resetAllFilters);

    // Responsive viewport change listener
    let resizeTimer: any = null;
    let lastWasMobile = isMobileView();

    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const currentIsMobile = isMobileView();
        if (currentIsMobile !== lastWasMobile) {
          lastWasMobile = currentIsMobile;
          if (!currentIsMobile) {
            currentPage = Math.max(
              1,
              Math.ceil(mobileVisibleCount / DESKTOP_PAGE_SIZE),
            );
          }
          applyFilters(false, false);
        }
      }, 150);
    });

    // Initialize from URL query parameters (?category= & ?page=)
    const urlParams = new URLSearchParams(window.location.search);
    const initialCategory = urlParams.get("category");
    const initialPage = parseInt(urlParams.get("page") || "1", 10);

    if (
      initialCategory &&
      pills.some((p) => p.dataset.category === initialCategory)
    ) {
      activeCategory = initialCategory;
    }
    if (!isNaN(initialPage) && initialPage > 1) {
      currentPage = initialPage;
    }

    // Apply initial pagination and filter state immediately
    applyFilters(false, false);

    // ---------- Scroll & Entrance Animations ----------
    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.from(".blog-hero__content > *", {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.15,
        ease: "power3.out",
        delay: 0.2,
      });

      gsap.from(".blog-hero__main", {
        scale: 0.9,
        opacity: 0,
        duration: 1,
        ease: "power3.out",
        delay: 0.3,
      });

      gsap.from(".blog-hero__badge", {
        scale: 0,
        opacity: 0,
        duration: 0.8,
        stagger: 0.2,
        ease: "back.out(2)",
        delay: 0.5,
      });

      gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
        gsap.from(el, {
          y: 40,
          opacity: 0,
          duration: 0.8,
          ease: "power3.out",
          scrollTrigger: {
            trigger: el,
            start: "top 85%",
            once: true,
          },
        });
      });

      gsap.utils
        .toArray<HTMLElement>("[data-reveal-group]")
        .forEach((group) => {
          gsap.fromTo(
            group.children,
            { y: 36, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 0.7,
              stagger: { amount: 0.4 },
              ease: "power3.out",
              clearProps: "all",
              scrollTrigger: {
                trigger: group,
                start: "top 85%",
                once: true,
              },
            },
          );
        });
    });
  </script>

