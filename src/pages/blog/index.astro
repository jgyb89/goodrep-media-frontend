---
import DOMPurify from "isomorphic-dompurify";
import { fetchWP } from "../../lib/api.js";
import MainLayout from "../../layouts/MainLayout.astro";
import LeadForm from "../../components/LeadForm.jsx";
import { Image } from "astro:assets";

let posts: any[] = [];

try {
  const data = await fetchWP(`
    query GetBlogFeed {
      posts(first: 200) {
        nodes {
          id
          title
          slug
          excerpt
          date
          featuredImage {
            node {
              sourceUrl
              altText
            }
          }
        }
      }
    }
  `);
  posts = (data?.posts?.nodes || []).map((post: any) => ({
    ...post,
    excerpt: DOMPurify.sanitize(post.excerpt || "", { ALLOWED_TAGS: [] }),
  }));
} catch (error: any) {
  console.warn("Could not fetch posts for blog feed:", error?.message || error);
}

const categories = [
  "All Articles",
  "Local SEO",
  "Website Design",
  "Paid Google Ads",
  "Social Media",
  "Lead Generation",
];
---

<MainLayout
  title="Knowledge Center & Blog | Goodrep Media - Marketing Insights"
  description="Practical digital marketing strategies, SEO tactics, and growth tips written specifically for small and local business owners."
>
  <!-- BLOG HERO -->
  <section class="blog-hero">
    <div class="container blog-hero__container">
      <div class="blog-hero__content" data-reveal>
        <span class="blog-hero__kicker">KNOWLEDGE CENTER &amp; STRATEGY</span>
        <h1 class="blog-hero__title">
          Actionable Marketing Insights To <span class="text-cyan">Attract More Customers</span>
        </h1>
        <p class="blog-hero__lead">
          No fluff, no vanity metrics. Just practical, proven digital marketing guides, search engine optimization breakdowns, and growth tactics for small business owners.
        </p>
        <div class="blog-hero__search">
          <input
            type="search"
            class="blog-hero__input"
            placeholder="Search marketing articles, SEO tips, ads..."
            aria-label="Search articles"
          />
          <button type="button" class="btn btn--primary blog-hero__search-btn">
            Search
          </button>
        </div>
      </div>

      <div class="blog-hero__graphic" aria-hidden="true" data-reveal>
        <div class="blog-hero__art">
          <Image
            class="blog-hero__main"
            src="/grm-attract-users-resources.webp"
            alt="Digital marketing resources and guides"
            width={1809}
            height={1381}
            loading="eager"
            decoding="async"
          />
          <img
            class="blog-hero__badge blog-hero__badge--chart"
            src="/Asset 43.webp"
            alt=""
            width="183"
            height="237"
          />
          <img
            class="blog-hero__badge blog-hero__badge--msg"
            src="/Asset 50.webp"
            alt=""
            width="186"
            height="108"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- CATEGORY PILLS BAR -->
  <nav class="blog-nav" aria-label="Article categories">
    <div class="container blog-nav__container">
      <div class="blog-nav__pills">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class:list={["blog-nav__pill", { "is-active": idx === 0 }]}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </nav>

  <!-- POSTS GRID -->
  <section class="section blog-feed">
    <div class="container">
      {posts.length > 0 ? (
        <div class="blog-feed__grid" data-reveal-group>
          {posts.map((post) => (
            <article class="post-card">
              <a
                class="post-card__media"
                href={`/blog/${post.slug}`}
                tabindex="-1"
                aria-hidden="true"
              >
                {post.featuredImage?.node?.sourceUrl ? (
                  <img
                    src={post.featuredImage.node.sourceUrl}
                    alt={post.featuredImage.node.altText || post.title}
                    loading="lazy"
                    width="600"
                    height="375"
                  />
                ) : (
                  <img
                    class="post-card__placeholder"
                    src="/Asset 43.webp"
                    alt=""
                    loading="lazy"
                    width="183"
                    height="237"
                  />
                )}
              </a>
              <div class="post-card__body">
                <span class="post-card__tag">Small Business Strategy</span>
                <h2 class="post-card__title">
                  <a href={`/blog/${post.slug}`}>{post.title}</a>
                </h2>
                <p class="post-card__excerpt" set:html={post.excerpt} />
                <a
                  class="post-card__more"
                  href={`/blog/${post.slug}`}
                  aria-label={`Read more: ${post.title}`}
                >
                  Read Full Guide{" "}
                  <span class="material-symbols-outlined" aria-hidden="true">
                    arrow_forward
                  </span>
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="blog-feed__empty text-center" data-reveal>
          <img src="/Asset 43.webp" alt="" width="183" height="237" />
          <h2 class="blog-feed__empty-title">Articles Coming Soon!</h2>
          <p class="blog-feed__empty-text">
            We are currently updating our knowledge center with new marketing guides. In the meantime, feel free to book a free strategy call with our team.
          </p>
          <a href="#consultation" class="btn btn--primary">Book A Strategy Session</a>
        </div>
      )}
    </div>
  </section>

  <!-- VIP SMS / NEWSLETTER RIBBON -->
  <section class="sms-ribbon">
    <div class="container sms-ribbon__container" data-reveal>
      <div class="sms-ribbon__content">
        <span class="sms-ribbon__badge">VIP Small Business Circle</span>
        <h2 class="sms-ribbon__title">Get Proven Growth Strategies Sent Directly to Your Phone</h2>
        <p class="sms-ribbon__text">
          Join hundreds of local Michigan business owners getting weekly tactical tips on SEO, ad spend optimization, and conversion hacks.
        </p>
        <p class="sms-ribbon__callout">
          <span class="material-symbols-outlined" aria-hidden="true">smartphone</span>
          Text <strong>JOIN</strong> to <strong>49872</strong> for Exclusive Marketing Updates.
        </p>
      </div>
    </div>
  </section>

  <!-- CONSULTATION BANNER -->
  <section class="consult" id="consultation">
    <div class="container consult__layout">
      <div class="consult__intro" data-reveal>
        <p class="consult__kicker">Need personalized guidance?</p>
        <h2 class="consult__title">Book A Free 1-on-1 Marketing Audit</h2>
        <p class="consult__text">
          Instead of guessing what to fix, let our marketing experts audit your website and local search presence. We'll show you exactly where to focus next.
        </p>
        <ul class="consult__contact">
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">call</span>
            <a href="tel:+16163009868">(616) 300-9868</a>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">mail</span>
            <a href="mailto:team@goodrep.media">team@goodrep.media</a>
          </li>
        </ul>
      </div>

      <div class="consult__card" data-reveal>
        <h3 class="consult__card-title">Book Your Free Call</h3>
        <LeadForm client:visible submitLabel="Request Free Audit" />
      </div>
    </div>
  </section>

  <!-- GSAP ANIMATIONS -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.from(".blog-hero__content > *", {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.15,
        ease: "power3.out",
        delay: 0.2,
      });

      gsap.from(".blog-hero__main", {
        scale: 0.9,
        opacity: 0,
        duration: 1,
        ease: "power3.out",
        delay: 0.3,
      });

      gsap.from(".blog-hero__badge", {
        scale: 0,
        opacity: 0,
        duration: 0.8,
        stagger: 0.2,
        ease: "back.out(2)",
        delay: 0.5,
      });

      gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
        gsap.from(el, {
          y: 40,
          opacity: 0,
          duration: 0.8,
          ease: "power3.out",
          scrollTrigger: {
            trigger: el,
            start: "top 85%",
            once: true,
          },
        });
      });

      gsap.utils.toArray<HTMLElement>("[data-reveal-group]").forEach((group) => {
        gsap.from(group.children, {
          y: 36,
          opacity: 0,
          duration: 0.7,
          stagger: 0.1,
          ease: "power3.out",
          scrollTrigger: {
            trigger: group,
            start: "top 85%",
            once: true,
          },
        });
      });
    });
  </script>

  <style>
    /* ---------- Hero ---------- */
    .blog-hero {
      background-color: var(--color-bg);
      padding: clamp(3rem, 6vw, 5rem) 0 clamp(2rem, 4vw, 4rem);
      border-bottom: 1px solid var(--color-border);
      position: relative;
      overflow: hidden;
    }

    .blog-hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(
        rgba(27, 196, 217, 0.18) 1.5px,
        transparent 1.5px
      );
      background-size: 28px 28px;
      mask-image: radial-gradient(ellipse at 80% 50%, #000 0%, transparent 70%);
      pointer-events: none;
    }

    .blog-hero__container {
      display: grid;
      gap: 3rem;
      align-items: center;
    }

    @media (min-width: 960px) {
      .blog-hero__container {
        grid-template-columns: 6fr 5fr;
      }
    }

    .blog-hero__kicker {
      display: block;
      color: #64748b;
      font-weight: 600;
      font-size: 0.85rem;
      letter-spacing: 1.5px;
      margin-bottom: 0.75rem;
    }

    .blog-hero__title {
      font-size: clamp(2.2rem, 4.5vw, 3.2rem);
      font-weight: 700;
      line-height: 1.18;
      letter-spacing: -0.01em;
      margin: 0 0 1.25rem;
    }

    .text-cyan {
      color: var(--color-cyan);
    }

    .blog-hero__lead {
      color: var(--color-muted);
      font-size: 1.1rem;
      line-height: 1.7;
      margin: 0 0 2rem;
    }

    .blog-hero__search {
      display: flex;
      gap: 0.5rem;
      max-width: 520px;
      background: var(--color-light);
      padding: 0.4rem;
      border-radius: 12px;
      border: 1px solid var(--color-border);
      box-shadow: var(--shadow-card);
    }

    .blog-hero__input {
      flex: 1;
      border: none;
      padding: 0.6rem 1rem;
      font-size: 0.95rem;
      outline: none;
      background: transparent;
      color: var(--color-dark);
      font-family: inherit;
    }

    .blog-hero__search-btn {
      padding: 0.6rem 1.4rem;
      font-size: 0.9rem;
    }

    .blog-hero__graphic {
      display: flex;
      justify-content: center;
    }

    .blog-hero__art {
      position: relative;
      width: 100%;
      max-width: 500px;
      aspect-ratio: 1.3 / 1;
    }

    .blog-hero__main {
      width: 100%;
      height: auto;
      border-radius: 20px;
      display: block;
    }

    .blog-hero__badge {
      position: absolute;
      height: auto;
      filter: drop-shadow(0 14px 20px rgba(15, 23, 42, 0.25));
    }

    .blog-hero__badge--chart {
      width: 20%;
      left: -4%;
      top: -8%;
    }

    .blog-hero__badge--msg {
      width: 25%;
      right: -4%;
      bottom: -6%;
    }

    /* ---------- Category Nav ---------- */
    .blog-nav {
      background: var(--color-light);
      border-bottom: 1px solid var(--color-border);
      position: sticky;
      top: var(--header-h);
      z-index: 30;
      backdrop-filter: blur(10px);
    }

    .blog-nav__container {
      padding-top: 0.85rem;
      padding-bottom: 0.85rem;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .blog-nav__container::-webkit-scrollbar {
      display: none;
    }

    .blog-nav__pills {
      display: flex;
      gap: 0.5rem;
    }

    .blog-nav__pill {
      display: inline-block;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--color-dark);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      padding: 0.4rem 1rem;
      border-radius: 999px;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.2s ease;
      font-family: inherit;
    }

    .blog-nav__pill:hover,
    .blog-nav__pill.is-active {
      background: var(--color-cyan);
      border-color: var(--color-cyan);
      color: var(--color-light);
    }

    /* ---------- Blog Feed ---------- */
    .blog-feed {
      background: var(--color-light);
      padding-top: 4rem;
      padding-bottom: 5rem;
    }

    .blog-feed__grid {
      display: grid;
      gap: 2rem;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    }

    .post-card {
      display: flex;
      flex-direction: column;
      background: var(--color-light);
      border: 1px solid var(--color-border);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: var(--shadow-card);
      transition: translate 0.3s ease, box-shadow 0.3s ease;
    }

    .post-card:hover {
      translate: 0 -6px;
      box-shadow: var(--shadow-lift);
    }

    .post-card__media {
      display: grid;
      place-items: center;
      aspect-ratio: 16 / 10;
      background: var(--color-cyan-soft);
      overflow: hidden;
    }

    .post-card__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .post-card__media .post-card__placeholder {
      width: auto;
      height: 60%;
      object-fit: contain;
    }

    .post-card:hover .post-card__media img {
      transform: scale(1.05);
    }

    .post-card__body {
      display: flex;
      flex-direction: column;
      flex: 1;
      padding: 1.5rem;
    }

    .post-card__tag {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-cyan-dark);
      margin-bottom: 0.5rem;
    }

    .post-card__title {
      font-size: 1.25rem;
      margin: 0 0 0.85rem;
      line-height: 1.35;
    }

    .post-card__title a {
      color: var(--color-dark);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .post-card__title a:hover {
      color: var(--color-cyan);
    }

    .post-card__excerpt {
      margin: 0 0 1.5rem;
      color: var(--color-muted);
      font-size: 0.95rem;
      line-height: 1.6;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .post-card__more {
      margin-top: auto;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--color-primary);
      font-family: var(--font-heading);
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
    }

    .post-card__more .material-symbols-outlined {
      font-size: 1.1rem;
      transition: transform 0.2s ease;
    }

    .post-card__more:hover .material-symbols-outlined {
      transform: translateX(4px);
    }

    .blog-feed__empty {
      padding: 4rem 1rem;
      max-width: 500px;
      margin: 0 auto;
    }
    .blog-feed__empty img {
      margin: 0 auto 1.5rem;
      opacity: 0.7;
    }
    .blog-feed__empty-title {
      font-size: 1.8rem;
      margin: 0 0 0.75rem;
    }
    .blog-feed__empty-text {
      color: var(--color-muted);
      line-height: 1.7;
      margin-bottom: 2rem;
    }

    /* ---------- SMS Ribbon ---------- */
    .sms-ribbon {
      background: var(--color-dark);
      color: var(--color-light);
      padding: clamp(3.5rem, 6vw, 5rem) 0;
      border-top: 4px solid var(--color-cyan);
      text-align: center;
    }

    .sms-ribbon__content {
      max-width: 700px;
      margin: 0 auto;
    }

    .sms-ribbon__badge {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--color-cyan);
      background: rgba(27, 196, 217, 0.15);
      padding: 0.35rem 0.85rem;
      border-radius: 999px;
      margin-bottom: 1rem;
    }

    .sms-ribbon__title {
      color: var(--color-light);
      font-size: clamp(1.8rem, 3.2vw, 2.4rem);
      margin: 0 0 1rem;
    }

    .sms-ribbon__text {
      color: #94a3b8;
      font-size: 1.05rem;
      line-height: 1.7;
      margin: 0 0 1.5rem;
    }

    .sms-ribbon__callout {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      padding: 0.75rem 1.5rem;
      font-size: 1.1rem;
      color: var(--color-cyan);
      margin: 0;
    }

    /* ---------- Consultation ---------- */
    .consult {
      background: var(--color-cyan);
      color: var(--color-light);
      padding: clamp(4rem, 8vw, 6rem) 0;
    }

    .consult__layout {
      display: grid;
      gap: 3rem;
      align-items: center;
    }

    @media (min-width: 960px) {
      .consult__layout {
        grid-template-columns: 5fr 6fr;
        gap: 4rem;
      }
    }

    .consult__kicker {
      font-size: 1.05rem;
      margin: 0 0 0.5rem;
    }

    .consult__title {
      font-size: clamp(2rem, 3.5vw, 2.6rem);
      margin: 0 0 1rem;
      color: var(--color-light);
    }

    .consult__text {
      font-size: 1.05rem;
      line-height: 1.7;
      margin: 0 0 1.5rem;
    }

    .consult__contact {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.5rem;
    }

    .consult__contact li {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 600;
    }

    .consult__contact a {
      color: var(--color-light);
      text-decoration: none;
    }

    .consult__contact a:hover {
      text-decoration: underline;
    }

    .consult__card {
      background: var(--color-light);
      color: var(--color-dark);
      border-radius: 16px;
      padding: clamp(1.5rem, 3vw, 2.5rem);
      box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.35);
    }

    .consult__card-title {
      color: var(--color-cyan);
      font-size: 1.6rem;
      margin: 0 0 1.5rem;
    }
  </style>
</MainLayout>
