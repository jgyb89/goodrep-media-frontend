---
// src/pages/contact.astro
import MainLayout from "../layouts/MainLayout.astro";
import LeadForm from "../components/LeadForm.jsx";
import { CONTACT_INFO, SITE_NAME } from "../config/site.js";

const pageTitle =
  "Contact Us | Good Rep Media - Grand Rapids Digital Marketing";
const pageDescription =
  "Get in touch with Good Rep Media. Connect with our in-house team in Grand Rapids, MI for web design, SEO, paid ads, and digital media. Call (616) 300-9868 or send us a message.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": "https://goodrep.media/contact/#webpage",
  url: "https://goodrep.media/contact/",
  name: pageTitle,
  description: pageDescription,
  mainEntity: {
    "@type": "LocalBusiness",
    "@id": "https://goodrep.media/#localbusiness",
    name: "Good Rep Media",
    telephone: "+1-616-300-9868",
    email: "team@goodrep.media",
    url: "https://goodrep.media/",
    logo: "https://goodrep.media/grm-logos/GRM_Blue_Favicon.png",
    address: {
      "@type": "PostalAddress",
      streetAddress: "O-745 Lake Michigan Dr. NW",
      addressLocality: "Grand Rapids",
      addressRegion: "MI",
      postalCode: "49534",
      addressCountry: "US",
    },
    openingHoursSpecification: [
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        opens: "09:00",
        closes: "17:00",
      },
    ],
  },
};

const trustHighlights = [
  { icon: "schedule", text: "< 24-Hour Response" },
  { icon: "verified", text: "100% In-House Team" },
  { icon: "handshake", text: "Zero Sales Pressure" },
];

const contactChannels = [
  {
    icon: "call",
    label: "Call or Text Directly",
    value: "(616) 300-9868",
    subtext: "Mon – Fri: 9:00 AM – 5:00 PM EST",
    href: "tel:+16163009868",
    actionText: "Call Now",
    badge: "Direct Line",
  },
  {
    icon: "mail",
    label: "Email Our Team",
    value: "team@goodrep.media",
    subtext: "Monitored throughout the day by strategists",
    href: "mailto:team@goodrep.media",
    actionText: "Send Email",
    badge: "Fast Reply",
  },
  {
    icon: "calendar_month",
    label: "Prefer a Scheduled Call?",
    value: "Book a 30-Min Strategy Call",
    subtext: "Pick an open date & time on our video calendar",
    href: "/chat/",
    actionText: "View Open Slots",
    badge: "Instant Booking",
  },
  {
    icon: "location_on",
    label: "Studio Office",
    value: "O-745 Lake Michigan Dr. NW",
    subtext: "Grand Rapids, MI 49534",
    href: "https://maps.google.com/?q=O-745+Lake+Michigan+Dr+NW,+Grand+Rapids,+MI+49534",
    actionText: "Get Directions",
    badge: "Michigan Studio",
    external: true,
  },
];

const processSteps = [
  {
    step: "01",
    tag: "REVIEW",
    title: "In-House Audit",
    desc: "A senior strategist inspects your current digital presence, search engine rankings, and local competitors before we talk.",
    icon: "manage_search",
  },
  {
    step: "02",
    tag: "DISCOVERY",
    title: "1-on-1 Discussion",
    desc: "We discuss your revenue bottlenecks and realistic growth opportunities—either over a phone call, Google Meet, or in-person coffee.",
    icon: "forum",
  },
  {
    step: "03",
    tag: "ROADMAP",
    title: "Clear Action Plan",
    desc: "You receive a transparent scope and timeline with clear deliverables and zero long-term hostage contracts.",
    icon: "trending_up",
  },
];

const faqs = [
  {
    q: "How fast will someone respond to my message?",
    a: "We respond to all inquiries within 24 business hours (frequently within 2 to 4 hours during normal business days). Your message goes straight to our core team in Grand Rapids, never an overseas call center.",
  },
  {
    q: "Can we meet in person in Grand Rapids?",
    a: "Yes! We love meeting local Michigan business owners in person. Our studio is located at O-745 Lake Michigan Dr. NW in Grand Rapids. Let us know in your message and we'll gladly host you or meet you at your favorite local spot.",
  },
  {
    q: "Do you work with businesses outside of Michigan?",
    a: "Absolutely! While 100% of our team is based in Grand Rapids, we manage high-performing digital marketing and web design campaigns for clients across the country.",
  },
  {
    q: "Do you lock clients into long-term retainers?",
    a: "Never. We believe in earning your business month-to-month through transparent reporting, reliable ROI, and proactive communication. You own 100% of your assets from day one.",
  },
];
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  pageSchema={pageSchema}
  hideFooterForm={true}
>
  <!-- CONTACT HERO & BREADCRUMB -->
  <section class="contact-hero">
    <div class="contact-hero__backdrop" aria-hidden="true">
      <div class="contact-hero__glow"></div>
    </div>

    <div class="container contact-hero__container">
      <nav class="contact-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="contact-breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Contact</span>
      </nav>

      <div class="contact-eyebrow">
        <span class="contact-eyebrow__pulse" aria-hidden="true"></span>
        <span class="contact-eyebrow__text"
          >Direct Line to Grand Rapids In-House Team</span
        >
      </div>

      <h1 class="contact-hero__title">
        Let’s Build Something <span class="text-cyan">Remarkable Together</span>
      </h1>

      <p class="contact-hero__lead">
        Have a project in mind, need an honest second opinion on your rankings,
        or ready to upgrade your marketing? Reach out below. No pushy sales
        reps—just experienced builders and strategists.
      </p>
    </div>
  </section>

  <!-- MAIN CONTACT INTERACTIVE HUB (GRID) -->
  <section class="contact-hub" id="contact-form-section">
    <div class="container contact-hub__container">
      <div class="contact-hub__grid">
        <!-- LEFT COLUMN: DIRECT CHANNELS & ART STAGE -->
        <div class="contact-hub__left">
          <div class="contact-hub__info-header">
            <span class="contact-hub__kicker">REACH US DIRECTLY</span>
            <h2 class="contact-hub__subtitle">We're Here When You're Ready</h2>
            <p class="contact-hub__desc">
              Choose the communication channel that fits your schedule best. We
              are always happy to chat.
            </p>
          </div>

          <!-- Direct Communication Channels Cards -->
          <div class="contact-channels-grid">
            {
              contactChannels.map((channel) => (
                <a
                  href={channel.href}
                  class="contact-channel-card"
                  target={channel.external ? "_blank" : undefined}
                  rel={channel.external ? "noopener noreferrer" : undefined}
                >
                  <div class="contact-channel-card__header">
                    <div class="contact-channel-card__icon-box">
                      <span
                        class="material-symbols-outlined contact-channel-card__icon"
                        aria-hidden="true"
                      >
                        {channel.icon}
                      </span>
                    </div>
                    {channel.badge && (
                      <span class="contact-channel-card__badge">
                        {channel.badge}
                      </span>
                    )}
                  </div>

                  <div class="contact-channel-card__body">
                    <span class="contact-channel-card__label">
                      {channel.label}
                    </span>
                    <strong class="contact-channel-card__value">
                      {channel.value}
                    </strong>
                    <span class="contact-channel-card__sub">
                      {channel.subtext}
                    </span>
                  </div>

                  <div class="contact-channel-card__footer">
                    <span class="contact-channel-card__action">
                      {channel.actionText}
                    </span>
                    <span
                      class="material-symbols-outlined contact-channel-card__arrow"
                      aria-hidden="true"
                    >
                      arrow_forward
                    </span>
                  </div>
                </a>
              ))
            }
          </div>

          <!-- VISUAL ART STAGE (Strict Anti-Clutter Limit: 1 blob + 1 center + 2 corner accents) -->
          <div class="contact-art-stage" aria-hidden="true">
            <div class="contact-art-stage__inner">
              <!-- 1 Background: Blue Circular Graphic -->
              <img
                class="contact-art-stage__blob"
                src="/grm-web-assets/blue-circular-background-graphic.svg"
                alt=""
                width="746"
                height="780"
                loading="eager"
              />
              <!-- 1 Centerpiece Graphic: Email Notification Graphic -->
              <img
                class="contact-art-stage__main"
                src="/grm-main-graphics/email-notification-graphic.svg"
                alt=""
                width="746"
                height="780"
                loading="eager"
              />
              <!-- 2 Corner Satellites: Lower-Left & Top-Right mirroring Blob 1 Geometry -->
              <img
                class="contact-art-stage__float contact-art-stage__float--bl"
                src="/grm-web-assets/3d-chat-bubbles-graphic.svg"
                alt=""
                width="62"
                height="66"
                loading="lazy"
              />
              <img
                class="contact-art-stage__float contact-art-stage__float--tr"
                src="/grm-web-assets/paper-plane-graphic.svg"
                alt=""
                width="758"
                height="813"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: THE GRAVITY FORM CARD -->
        <div class="contact-hub__right">
          <div class="contact-form-card">
            <header class="contact-form-card__header">
              <div class="contact-form-card__pill">
                <span
                  class="material-symbols-outlined contact-form-card__pill-icon"
                  aria-hidden="true"
                >
                  chat
                </span>
                <span>Send Us A Message</span>
              </div>
              <h2 class="contact-form-card__title">
                Tell Us About Your Project
              </h2>
              <p class="contact-form-card__lead">
                Fill out the form below. We'll inspect your footprint and reply
                with practical recommendations within 24 hours.
              </p>
            </header>

            <div class="contact-form-card__form-wrapper">
              <!-- Gravity Forms React Island (Form ID 15) -->
              <LeadForm client:visible submitLabel="Send Message" formId={15} />
            </div>

            <footer class="contact-form-card__footer">
              <div class="contact-form-card__privacy">
                <span
                  class="material-symbols-outlined contact-form-card__privacy-icon"
                  aria-hidden="true"
                >
                  shield
                </span>
                <span>
                  Your information is private and secure. We never sell data,
                  share details, or send spam.
                </span>
              </div>
            </footer>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT HAPPENS NEXT (CONCISE 3-STEP PROCESS) -->
  <section class="section contact-process">
    <div class="container">
      <header class="section-head text-center contact-process__head">
        <span class="contact-kicker">TRANSPARENT COLLABORATION</span>
        <h2 class="contact-section-title">What Happens After You Reach Out?</h2>
        <p class="contact-section-lead">
          We respect your time. Here is the straightforward, no-nonsense roadmap
          of what comes next:
        </p>
      </header>

      <div class="contact-process__grid">
        {
          processSteps.map((step) => (
            <div class="contact-step-card">
              <div class="contact-step-card__top">
                <span class="contact-step-card__num">{step.step}</span>
                <span class="contact-step-card__tag">{step.tag}</span>
              </div>
              <div class="contact-step-card__icon-box">
                <span
                  class="material-symbols-outlined contact-step-card__icon"
                  aria-hidden="true"
                >
                  {step.icon}
                </span>
              </div>
              <h3 class="contact-step-card__title">{step.title}</h3>
              <p class="contact-step-card__desc">{step.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQS SECTION -->
  <section class="section contact-faq">
    <div class="container">
      <header class="section-head text-center contact-faq__head">
        <span class="contact-kicker">COMMON QUESTIONS</span>
        <h2 class="contact-section-title">Frequently Asked Questions</h2>
        <p class="contact-section-lead">
          Have questions about working with Good Rep Media? Here are quick
          answers to the questions we hear most.
        </p>
      </header>

      <div class="contact-faq__grid">
        {
          faqs.map((faq) => (
            <div class="contact-faq-card">
              <div class="contact-faq-card__q-wrap">
                <span
                  class="material-symbols-outlined contact-faq-card__q-icon"
                  aria-hidden="true"
                >
                  help_outline
                </span>
                <h3 class="contact-faq-card__question">{faq.q}</h3>
              </div>
              <p class="contact-faq-card__answer">{faq.a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* ==========================================================================
     CONTACT PAGE STYLES
     ========================================================================== */

  .text-cyan {
    color: var(--color-cyan, #1bc4d9);
  }

  /* ---------------- Hero Section ---------------- */
  .contact-hero {
    position: relative;
    padding: clamp(2.5rem, 5vw, 4rem) 0 2rem;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    overflow: hidden;
  }

  .contact-hero__backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .contact-hero__glow {
    position: absolute;
    top: -160px;
    right: -120px;
    width: 600px;
    height: 600px;
    background: radial-gradient(
      circle,
      rgba(27, 196, 217, 0.12) 0%,
      rgba(27, 196, 217, 0) 70%
    );
    border-radius: 50%;
  }

  .contact-hero__container {
    position: relative;
    z-index: 1;
    max-width: 960px;
    text-align: center;
    margin: 0 auto;
  }

  /* Breadcrumb */
  .contact-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-muted, #64748b);
    margin-bottom: 1.25rem;
  }

  .contact-breadcrumb a {
    color: var(--color-muted, #64748b);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-breadcrumb a:hover {
    color: var(--color-cyan-dark, #0fa3b6);
  }

  .contact-breadcrumb__sep {
    color: #cbd5e1;
  }

  /* Eyebrow Pill */
  .contact-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.95rem;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    border-radius: 999px;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #065f46;
    margin-bottom: 1rem;
  }

  .contact-eyebrow__pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: pulseDot 2s infinite;
  }

  @keyframes pulseDot {
    0% {
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(16, 185, 129, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
    }
  }

  .contact-hero__title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-dark, #0f172a);
    margin: 0 0 1rem;
    text-wrap: balance;
  }

  .contact-hero__lead {
    font-size: clamp(1.02rem, 1.8vw, 1.18rem);
    line-height: 1.65;
    color: var(--color-muted, #64748b);
    max-width: 740px;
    margin: 0 auto 1.8rem;
    text-wrap: pretty;
  }

  /* Trust Highlights Bar */
  .contact-trust-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.25rem;
  }

  /* ---------------- Main Interactive Hub ---------------- */
  .contact-hub {
    padding: 2.5rem 0 4.5rem;
    background: #f8fafc;
  }

  .contact-hub__grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: flex-start;
  }

  /* Left Column */
  .contact-hub__left {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact-hub__kicker {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-cyan-dark, #0fa3b6);
    margin-bottom: 0.35rem;
  }

  .contact-hub__subtitle {
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    font-weight: 800;
    color: var(--color-dark, #0f172a);
    margin: 0 0 0.5rem;
    line-height: 1.25;
  }

  .contact-hub__desc {
    color: var(--color-muted, #64748b);
    font-size: 0.98rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Direct Channel Cards */
  .contact-channels-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .contact-channel-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 1.25rem 1.4rem;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  }

  .contact-channel-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-cyan, #1bc4d9);
    box-shadow: 0 10px 24px -8px rgba(27, 196, 217, 0.25);
  }

  .contact-channel-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .contact-channel-card__icon-box {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--color-cyan-soft, #e3f7fa);
    color: var(--color-cyan-dark, #0fa3b6);
    display: grid;
    place-items: center;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .contact-channel-card:hover .contact-channel-card__icon-box {
    background: var(--color-cyan, #1bc4d9);
    color: #ffffff;
  }

  .contact-channel-card__icon {
    font-size: 22px;
    line-height: 1;
  }

  .contact-channel-card__badge {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: #f1f5f9;
    color: var(--color-dark, #0f172a);
  }

  .contact-channel-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .contact-channel-card__label {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted, #64748b);
  }

  .contact-channel-card__value {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-dark, #0f172a);
    line-height: 1.3;
  }

  .contact-channel-card__sub {
    font-size: 0.85rem;
    color: var(--color-muted, #64748b);
  }

  .contact-channel-card__footer {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.25rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-cyan-dark, #0fa3b6);
  }

  .contact-channel-card__arrow {
    font-size: 16px;
    transition: transform 0.2s ease;
  }

  .contact-channel-card:hover .contact-channel-card__arrow {
    transform: translateX(4px);
  }

  /* Art Stage: Clean, isolated, strictly follows the anti-clutter limit */
  .contact-art-stage {
    position: relative;
    width: 100%;
    max-width: 460px;
    margin: 0.5rem auto 0;
    pointer-events: none;
    user-select: none;
  }

  .contact-art-stage__inner {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
  }

  .contact-art-stage__blob {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    object-fit: contain;
    opacity: 0.95;
    z-index: 1;
    filter: drop-shadow(0 12px 28px rgba(27, 196, 217, 0.15));
  }

  .contact-art-stage__main {
    position: absolute;
    width: 60%;
    height: auto;
    z-index: 2;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 16px 32px rgba(15, 23, 42, 0.14));
  }

  .contact-art-stage__float {
    position: absolute;
    z-index: 3;
    filter: drop-shadow(0 10px 20px rgba(15, 23, 42, 0.12));
    transition: transform 0.3s ease;
  }

  /* Blob 1 geometry rule: lower-left and top-right corner placement */
  .contact-art-stage__float--bl {
    width: 20%;
    height: auto;
    left: 6%;
    bottom: 10%;
    animation: gentleFloat1 4.5s ease-in-out infinite;
  }

  .contact-art-stage__float--tr {
    width: 22%;
    height: auto;
    right: 6%;
    top: 8%;
    animation: gentleFloat2 5s ease-in-out infinite;
  }

  @keyframes gentleFloat1 {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @keyframes gentleFloat2 {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  /* Right Column: Contact Form Card */
  .contact-form-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-top: 4px solid var(--color-cyan, #1bc4d9);
    border-radius: 1.5rem;
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.08);
  }

  .contact-form-card__header {
    margin-bottom: 1.75rem;
  }

  .contact-form-card__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: var(--color-cyan-soft, #e3f7fa);
    color: var(--color-cyan-dark, #0fa3b6);
    font-family: var(--font-heading);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }

  .contact-form-card__pill-icon {
    font-size: 15px;
  }

  .contact-form-card__title {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    color: var(--color-dark, #0f172a);
    margin: 0 0 0.5rem;
    line-height: 1.25;
  }

