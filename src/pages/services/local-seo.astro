---

<MainLayout
  title="Local SEO Services | Goodrep Media"
  description="Specialized Local SEO services optimizing your Google Business Profile, 50+ local directories, and website presence to attract nearby customers and boost leads and sales."
>
  <!-- 1. SERVICE HERO WITH LAYERED ART & 3D ROTATOR -->
  <section class="service-hero">
    <div class="container service-hero__container">
      <div class="service-hero__content">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol class="breadcrumb__list">
            <li class="breadcrumb__item">
              <a href="/services" class="breadcrumb__link">Services</a>
            </li>
            <li class="breadcrumb__sep" aria-hidden="true">
              <span class="material-symbols-outlined">chevron_right</span>
            </li>
            <li class="breadcrumb__item" aria-current="page">Local SEO</li>
          </ol>
        </nav>

        <span class="service-hero__kicker">LOCAL SEO SERVICES</span>

        <h1 class="service-hero__title">
          <span class="service-hero__title-top">Local SEO Engineered For</span>
          <span class="service-hero__rotator" id="local-seo-hero-rotator">
            {
              heroRotatorWords.map((word, idx) => (
                <span
                  class="service-hero__word"
                  data-hero-word
                  aria-hidden={idx === 0 ? "false" : "true"}
                >
                  {word}
                </span>
              ))
            }
          </span>
        </h1>

        <p class="service-hero__lead">
          Get more leads and sales from local searches by showing up when people
          are looking for exactly what you do. Local search engine optimization
          (SEO) starts by researching specific keywords that people search
          online and optimizing your online presence to show up for those
          searches. This leads to <strong>more traffic, more sales, and higher revenue</strong>.
        </p>

        <div class="service-hero__checklist-card">
          <ul class="checklist service-hero__checklist" data-checklist>
            {heroHighlights.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="service-hero__actions">
          <a href="#consultation" class="btn btn--primary">Contact Us</a>
          <button type="button" class="btn btn--outline" data-open-modal>
            Send Us a Message
          </button>
        </div>
      </div>

      <!-- Multi-layered isometric hero composition -->
      <div class="service-hero__graphic" aria-hidden="true">
        <div class="hero-stage" id="hero-parallax-stage">
          <img
            class="hero-stage__blob"
            data-hero-depth="12"
            src="/Asset 2.webp"
            alt=""
            width="869"
            height="663"
            decoding="async"
          />
          <Image
            class="hero-stage__main"
            data-hero-depth="-18"
            src="/grm-local-seo.webp"
            alt="Local SEO Google Business Profile and Map Pack Visibility"
            width={1942}
            height={1397}
            fetchpriority="high"
            decoding="async"
          />
          <img
            class="hero-stage__float hero-stage__float--growth"
            data-float
            data-hero-depth="-32"
            src="/Asset 4.webp"
            alt=""
            width="291"
            height="419"
            decoding="async"
          />
          <img
            class="hero-stage__float hero-stage__float--gauge"
            data-float
            data-hero-depth="-26"
            src="/Asset 42.webp"
            alt=""
            width="148"
            height="178"
            decoding="async"
          />
          <img
            class="hero-stage__float hero-stage__float--cursor"
            data-float
            data-hero-depth="-40"
            src="/Asset 18.webp"
            alt=""
            width="62"
            height="60"
            decoding="async"
          />
          <img
            class="hero-stage__float hero-stage__float--likes"
            data-float
            data-hero-depth="-28"
            src="/Asset 55.webp"
            alt=""
            width="197"
            height="98"
            decoding="async"
          />
        </div>
      </div>
    </div>

    <!-- INFINITE CAPABILITIES MARQUEE -->
    <div class="marquee">
      <div class="marquee__track">
        <div class="marquee__content">
          {
            marqueeItems.map((item) => (
              <div class="marquee__item">
                <span class="material-symbols-outlined" aria-hidden="true">
                  {item.icon}
                </span>
                {item.label}
              </div>
            ))
          }
        </div>
        <div class="marquee__content" aria-hidden="true">
          {
            marqueeItems.map((item) => (
              <div class="marquee__item">
                <span class="material-symbols-outlined" aria-hidden="true">
                  {item.icon}
                </span>
                {item.label}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 2. THE #1 LOCAL SEO MISTAKE & HOW LOCAL SEO WORKS (MULTI-PLANE PARALLAX SPOTLIGHT) -->
  <section class="section starts-section">
    <div class="container">
      <div class="starts-feature" data-reveal>
        <div class="starts-feature__media" aria-hidden="true">
          <img
            class="starts-feature__blob"
            data-spotlight-parallax="24"
            src="/Asset 2.webp"
            alt=""
            width="869"
            height="663"
            loading="lazy"
          />
          <Image
            class="starts-feature__main"
            data-spotlight-parallax="-18"
            src="/GRM Web Graphics/good-rep-media-marketing.webp"
            alt="Local Search Visibility and Google Business Profile Discovery"
            width={4000}
            height={2250}
            loading="lazy"
            decoding="async"
          />
          <img
            class="starts-feature__sat starts-feature__sat--target"
            data-spotlight-parallax="-46"
            data-float
            src="/Asset 37.webp"
            alt=""
            width="261"
            height="246"
            loading="lazy"
          />
          <img
            class="starts-feature__sat starts-feature__sat--smiley"
            data-spotlight-parallax="-34"
            data-float
            src="/Asset 9.webp"
            alt=""
            width="137"
            height="162"
            loading="lazy"
          />
          <img
            class="starts-feature__sat starts-feature__sat--likes"
            data-spotlight-parallax="-52"
            data-float
            src="/Asset 55.webp"
            alt=""
            width="197"
            height="98"
            loading="lazy"
          />

          <div class="starts-feature__pill" data-spotlight-parallax="-30">
            <span class="starts-feature__pill-icon">
              <span class="material-symbols-outlined" aria-hidden="true">
                pin_drop
              </span>
            </span>
            <div>
              <strong>84% Discovery Searches</strong>
              <span>Customers searching by service, not brand name</span>
            </div>
          </div>
        </div>

        <div class="starts-feature__content">
          <span class="eyebrow">MOST COMPANIES DON'T UNDERSTAND...</span>
          <h2 class="section-title starts-feature__title">
            The #1 Local SEO Mistake
          </h2>

          <p class="starts-feature__question">
            Only 16% of local customer searches are for a particular business.
          </p>

          <p class="starts-feature__body">
            Customers are searching for the services they need, not specific
            businesses. Only 16% of local customer searches are for a particular
            business. Don&rsquo;t lose revenue waiting for that 16%&mdash;optimize
            your listing to be found by the remaining 84%.
          </p>

          <p class="starts-feature__body">
            <strong>Trust Comes First:</strong> Local SEO is all about trust.
            You have to know what &ldquo;trust signals&rdquo; directories like
            Google are looking for. When you pair that with business-specific
            terms like &ldquo;auto repair near me&rdquo; or &ldquo;flower shop
            grand rapids&rdquo;, you have the foundation of local SEO.
          </p>

          <div class="mobile-callout">
            <div class="mobile-callout__ring" aria-hidden="true">
              <svg viewBox="0 0 80 80" class="mobile-callout__svg">
                <circle
                  class="mobile-callout__track"
                  cx="40"
                  cy="40"
                  r="34"
                ></circle>
                <circle
                  class="mobile-callout__progress"
                  cx="40"
                  cy="40"
                  r="34"
                ></circle>
              </svg>
              <span class="mobile-callout__percent">72%</span>
            </div>
            <div class="mobile-callout__copy">
              <h3 class="mobile-callout__title">
                WHY LOCAL VISIBILITY MATTERS
              </h3>
              <p class="mobile-callout__text">
                People who use local search terms on Google&ndash; phrases like
                &ldquo;near me&rdquo; or &ldquo;Grand Rapids&rdquo;&ndash; are
                some of the most active buyers across the entire internet.
                According to HubSpot, <strong>72% of consumers</strong>
                conducting local searches interacted with a local business
                within five miles.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. EYE-OPENING LOCAL SEO STATISTICS (DARK BAND WITH ANIMATED COUNTERS) -->
  <section class="stats-band" aria-labelledby="stats-heading">
    <div class="container">
      <header class="section-head stats-band__head" data-reveal>
        <span class="eyebrow stats-band__eyebrow">THE STATS</span>
        <h2 id="stats-heading" class="section-title stats-band__title">
          Eye-Opening Local SEO Statistics
        </h2>
        <p class="stats-band__sub">
          When people take out their smartphones to search for local businesses,
          it&rsquo;s because they are ready to make a purchase.
        </p>
      </header>

      <div class="stats-band__grid">
        {
          stats.map((stat) => (
            <div class="stat-card">
              <div class="stat-card__number">
                {stat.prefix && (
                  <span class="stat-card__affix">{stat.prefix}</span>
                )}
                <span
                  class="stat-card__value"
                  data-stat-counter={stat.value}
                  data-stat-decimals={stat.decimals}
                >
                  {stat.value}
                </span>
                {stat.suffix && (
                  <span class="stat-card__affix">{stat.suffix}</span>
                )}
              </div>
              <div class="stat-card__meter" aria-hidden="true">
                <div
                  class="stat-card__meter-fill"
                  data-stat-bar={stat.barPercent / 100}
                />
              </div>
              <p class="stat-card__label">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. THE PILLARS: HOW WE BOOST LOCAL SEO (DISTINCT PILLAR ROW CARDS IN WEB-DESIGN SYSTEM) -->
  <section
    class="section starts-section pillars-section"
    style="background: var(--color-bg);"
