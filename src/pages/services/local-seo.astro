  <!-- GSAP ANIMATIONS -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const wordEls = gsap.utils.toArray<HTMLElement>("[data-hero-word]");
    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      // 1. 3D Headline Rotator in Hero
      if (wordEls.length > 1) {
        const hidden = { yPercent: 60, rotationX: -80, autoAlpha: 0 };
        const shown = { yPercent: 0, rotationX: 0, autoAlpha: 1 };

        gsap.set(wordEls, {
          transformPerspective: 650,
          transformOrigin: "50% 100%",
          force3D: true,
        });
        gsap.set(wordEls[0], shown);
        gsap.set(wordEls.slice(1), hidden);

        const setActive = (active: number) =>
          wordEls.forEach((el, idx) =>
            el.setAttribute("aria-hidden", String(idx !== active)),
          );

        const flipTl = gsap.timeline({ repeat: -1 });

        wordEls.forEach((current, index) => {
          const nextIndex = (index + 1) % wordEls.length;
          const next = wordEls[nextIndex];

          flipTl.to(
            current,
            { ...hidden, duration: 0.5, ease: "power2.in" },
            "+=2.3",
          );

          flipTl.fromTo(
            next,
            hidden,
            {
              ...shown,
              duration: 0.6,
              ease: "power3.out",
              immediateRender: false,
              onStart: () => setActive(nextIndex),
            },
            "<0.25",
          );
        });
      }

      // 2. Infinite Marquee Animation (pauses on hover)
      const marqueeTween = gsap.to(".marquee__content", {
        xPercent: -100,
        repeat: -1,
        duration: 34,
        ease: "linear",
      });
      const marquee = document.querySelector(".marquee");
      marquee?.addEventListener("mouseenter", () => marqueeTween.pause());
      marquee?.addEventListener("mouseleave", () => marqueeTween.play());

      // 3. Hero Entrance Stagger + Interactive Pointer Parallax
      gsap.fromTo(
        ".breadcrumb, .service-hero__kicker, .service-hero__title, .service-hero__lead, .service-hero__checklist-card, .service-hero__actions",
        { y: 28, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.12,
          ease: "power3.out",
          delay: 0.15,
          clearProps: "all",
        },
      );

      gsap.fromTo(
        ".hero-stage__blob",
        { scale: 0.82, opacity: 0 },
        {
          scale: 1,
          opacity: 1,
          duration: 1.1,
          ease: "power3.out",
          delay: 0.15,
          clearProps: "all",
        },
      );

      gsap.fromTo(
        ".hero-stage__main",
        { y: 36, scale: 0.92, opacity: 0 },
        {
          y: 0,
          scale: 1,
          opacity: 1,
          duration: 0.95,
          ease: "power3.out",
          delay: 0.3,
          clearProps: "all",
        },
      );

      gsap.fromTo(
        ".hero-stage__float",
        { scale: 0, opacity: 0 },
        {
          scale: 1,
          opacity: 1,
          duration: 0.75,
          stagger: 0.12,
          ease: "back.out(2)",
          delay: 0.55,
          clearProps: "all",
        },
      );

      const heroSection = document.querySelector<HTMLElement>(".service-hero");
      const heroDepthLayers =
        gsap.utils.toArray<HTMLElement>("[data-hero-depth]");
      if (heroSection && heroDepthLayers.length) {
        heroSection.addEventListener("pointermove", (e) => {
          const rect = heroSection.getBoundingClientRect();
          const nx = (e.clientX - rect.left) / rect.width - 0.5;
          const ny = (e.clientY - rect.top) / rect.height - 0.5;
          heroDepthLayers.forEach((layer) => {
            const depth = Number(layer.dataset.heroDepth || 20);
            gsap.to(layer, {
              x: nx * depth,
              y: ny * depth,
              duration: 0.6,
              ease: "power2.out",
              overwrite: "auto",
            });
          });
        });
        heroSection.addEventListener("pointerleave", () => {
          heroDepthLayers.forEach((layer) => {
            gsap.to(layer, {
              x: 0,
              y: 0,
              duration: 0.8,
              ease: "power3.out",
              overwrite: "auto",
            });
          });
        });
      }

      // 4. Continuous Gentle Floating for Decorative Illustrations
      gsap.utils.toArray<HTMLElement>("[data-float]").forEach((el, i) => {
        gsap.to(el, {
          y: -12,
          rotation: i % 2 ? 3 : -3,
          duration: 2.4 + (i % 3) * 0.5,
          ease: "sine.inOut",
          yoyo: true,
          repeat: -1,
          delay: (i % 3) * 0.3,
        });
      });

      // 5. Generic Scroll Reveals
      gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
        gsap.fromTo(
          el,
          { y: 38, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.85,
            ease: "power3.out",
            clearProps: "all",
            scrollTrigger: {
              trigger: el,
              start: "top 85%",
              once: true,
            },
          },
        );
      });

      // 6. Checklist Stagger & 72% Callout Ring Draw
      const checklistItems = document.querySelectorAll("[data-checklist] li");
      if (checklistItems.length) {
        gsap.fromTo(
          checklistItems,
          { x: -20, opacity: 0 },
          {
            x: 0,
            opacity: 1,
            duration: 0.55,
            stagger: 0.09,
            ease: "back.out(1.4)",
            clearProps: "all",
            scrollTrigger: {
              trigger: ".service-hero__checklist-card",
              start: "top 88%",
              once: true,
            },
          },
        );
      }

      const ringProgress = document.querySelector<SVGCircleElement>(
        ".mobile-callout__progress",
      );
      if (ringProgress) {
        // Circumference for r=34 is ~213.6; 72% is dashoffset ~59.8
        gsap.fromTo(
          ringProgress,
          { strokeDashoffset: 213.6 },
          {
            strokeDashoffset: 59.8,
            duration: 1.4,
            ease: "power3.out",
            scrollTrigger: {
              trigger: ".mobile-callout",
              start: "top 85%",
              once: true,
            },
          },
        );
      }

      // 7. Starts Section Multi-Plane ScrollTrigger Scrub Parallax
      gsap.utils
        .toArray<HTMLElement>(".starts-feature")
        .forEach((startsFeature) => {
          const sats = startsFeature.querySelectorAll<HTMLElement>(
            "[data-spotlight-parallax]",
          );
          sats.forEach((sat) => {
            const deltaY = Number(sat.dataset.spotlightParallax || -36);
            gsap.fromTo(
              sat,
              { y: -deltaY * 0.4 },
              {
                y: deltaY * 0.6,
                ease: "none",
                scrollTrigger: {
                  trigger: startsFeature,
                  start: "top bottom",
                  end: "bottom top",
                  scrub: 0.6,
                },
              },
            );
          });
        });

      // 8. Stats Band: Card Entrance + Number Counter + Meter Fill
      gsap.fromTo(
        ".stat-card",
        { y: 34, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.7,
          stagger: 0.12,
          ease: "power3.out",
          clearProps: "all",
          scrollTrigger: {
            trigger: ".stats-band__grid",
            start: "top 85%",
            once: true,
          },
        },
      );

      gsap.utils
        .toArray<HTMLElement>("[data-stat-counter]")
        .forEach((counterEl) => {
          const targetVal = Number(counterEl.dataset.statCounter || "0");
          const decimals = Number(counterEl.dataset.statDecimals || "0");
          const counterObj = { val: 0 };

          gsap.to(counterObj, {
            val: targetVal,
            duration: 1.6,
            ease: "power2.out",
            onUpdate: () => {
              if (decimals > 0) {
                counterEl.textContent = counterObj.val.toFixed(decimals);
              } else {
                counterEl.textContent = Math.round(
                  counterObj.val,
                ).toLocaleString();
              }
            },
            scrollTrigger: {
              trigger: ".stats-band__grid",
              start: "top 85%",
              once: true,
            },
          });
        });

      gsap.utils.toArray<HTMLElement>("[data-stat-bar]").forEach((barEl) => {
        const scaleTarget = Number(barEl.dataset.statBar || "1");
        gsap.fromTo(
          barEl,
          { scaleX: 0 },
          {
            scaleX: scaleTarget,
            duration: 1.4,
            ease: "power3.out",
            scrollTrigger: {
              trigger: ".stats-band__grid",
              start: "top 85%",
              once: true,
            },
          },
        );
      });

      // 9. Ready Band: Multi-Plane ScrollTrigger Scrub Parallax
      const readyBand = document.querySelector<HTMLElement>("#ready-band");
      if (readyBand) {
        gsap.utils
          .toArray<HTMLElement>("[data-ready-parallax]")
          .forEach((layer) => {
            const deltaY = Number(layer.dataset.readyParallax || -30);
            gsap.fromTo(
              layer,
              { y: -deltaY * 0.45 },
              {
                y: deltaY * 0.55,
                ease: "none",
                scrollTrigger: {
                  trigger: readyBand,
                  start: "top bottom",
                  end: "bottom top",
                  scrub: 0.6,
                },
              },
            );
          });
      }

      // 10. Deliverables Grids: Orbit Medallions + Hover Physics
      gsap.utils
        .toArray<HTMLElement>("[data-deliverables-grid]")
        .forEach((delivGrid) => {
          const cards = gsap.utils.toArray<HTMLElement>(
            delivGrid.querySelectorAll("[data-deliverable-card]"),
          );
          const orbits = delivGrid.querySelectorAll(".deliverable-card__orbit");
          const icons = delivGrid.querySelectorAll("[data-deliverable-icon]");

          gsap.to(orbits, {
            rotation: 360,
            duration: 26,
            repeat: -1,
            ease: "none",
          });

          const delivTl = gsap.timeline({
            scrollTrigger: {
              trigger: delivGrid,
              start: "top 82%",
              once: true,
            },
          });

          delivTl
            .fromTo(
              cards,
              { y: 36, opacity: 0 },
              {
                y: 0,
                opacity: 1,
                duration: 0.65,
                stagger: 0.08,
                ease: "power3.out",
                clearProps: "all",
              },
            )
            .fromTo(
              icons,
              { scale: 0.5, rotation: -15 },
              {
                scale: 1,
                rotation: 0,
                duration: 0.7,
                stagger: 0.08,
                ease: "back.out(1.8)",
                clearProps: "all",
              },
              "<0.05",
            );

          cards.forEach((card) => {
            const icon = card.querySelector("[data-deliverable-icon]");
            const accent = card.querySelector("[data-deliverable-accent]");

            card.addEventListener("pointerenter", () => {
              if (icon) {
                gsap.to(icon, {
                  scale: 1.15,
                  rotation: -6,
                  duration: 0.4,
                  ease: "back.out(2)",
                });
              }
              if (accent) {
                gsap.to(accent, {
                  x: 6,
                  y: -6,
                  scale: 1.14,
                  rotation: 8,
                  duration: 0.4,
                  ease: "back.out(2)",
                });
              }
            });

            card.addEventListener("pointerleave", () => {
              if (icon) {
                gsap.to(icon, {
                  scale: 1,
                  rotation: 0,
                  duration: 0.55,
                  ease: "elastic.out(1, 0.5)",
                });
              }
              if (accent) {
                gsap.to(accent, {
                  x: 0,
                  y: 0,
                  scale: 1,
                  rotation: 0,
                  duration: 0.55,
                  ease: "elastic.out(1, 0.5)",
                });
              }
            });
          });
        });

      // 11. Consultation Multi-Layer Entrance
      const consultSection =
        document.querySelector<HTMLElement>("#consultation");
      if (consultSection) {
        const consultMain = consultSection.querySelector(".consult__art-main");
        const consultFloats = consultSection.querySelectorAll(
          ".consult__art-float",
        );

        const consultTl = gsap.timeline({
          scrollTrigger: {
            trigger: consultSection,
            start: "top 80%",
            once: true,
          },
        });

        if (consultMain) {
          consultTl.fromTo(
            consultMain,
            { y: 30, scale: 0.88, opacity: 0 },
            {
              y: 0,
              scale: 1,
              opacity: 1,
              duration: 0.75,
              ease: "back.out(1.5)",
              clearProps: "all",
            },
          );
        }
        if (consultFloats.length) {
          consultTl.fromTo(
            consultFloats,
            { scale: 0, y: 20, opacity: 0 },
            {
              scale: 1,
              y: 0,
              opacity: 1,
              duration: 0.6,
              stagger: 0.1,
              ease: "back.out(2.2)",
              clearProps: "all",
            },
            "<0.2",
          );
        }
      }
    });

    // 12. Process Accordion + Interactive Stage Choreography
    const stage = document.querySelector<HTMLElement>(".process__stage");
    const stepLabel = document.querySelector("#process-step-label");
    const stepTag = document.querySelector("#process-step-tag");
    const progressBar = document.querySelector<HTMLElement>(
      "#process-progress-bar",
    );
    const stageBlob = document.querySelector<HTMLElement>(
      ".process__stage-blob",
    );
    const allDetails = gsap.utils.toArray<HTMLDetailsElement>(".step");
    const allDots = gsap.utils.toArray<HTMLButtonElement>("[data-step-dot]");
    const stepTags = allDetails.map(
      (d) => d.querySelector(".step__tag")?.textContent || "",
    );

    const activateProcessStep = (stepIndex: number) => {
      if (!stage) return;
      const prevStep = Number(stage.dataset.activeStep ?? "0");
      stage.dataset.activeStep = String(stepIndex);

      if (stepLabel) stepLabel.textContent = String(stepIndex + 1);
      if (stepTag && stepTags[stepIndex]) {
        stepTag.textContent = stepTags[stepIndex];
      }

      allDots.forEach((dot, idx) => {
        dot.classList.toggle("is-active", idx === stepIndex);
      });

      const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (progressBar) {
        const ratio = (stepIndex + 1) / Math.max(allDetails.length, 1);
        if (prefersReduced) {
          progressBar.style.transform = `scaleX(${ratio})`;
        } else {
          gsap.to(progressBar, {
            scaleX: ratio,
            duration: 0.55,
            ease: "power3.out",
          });
        }
      }

      if (prefersReduced || prevStep === stepIndex) return;

      const nextVisual = stage.querySelector<HTMLElement>(
        `[data-visual="${stepIndex}"]`,
      );
      if (stageBlob) {
        gsap.to(stageBlob, {
          rotation: stepIndex * 45,
          scale: 1 + (stepIndex % 2) * 0.08,
          duration: 0.8,
          ease: "power2.out",
        });
      }

      if (nextVisual) {
        const mainImg = nextVisual.querySelector(".process__visual-main");
        const floatImgs = nextVisual.querySelectorAll(".process__visual-float");

        if (mainImg) {
          gsap.fromTo(
            mainImg,
            { y: 28, scale: 0.85, opacity: 0 },
            {
              y: 0,
              scale: 1,
              opacity: 1,
              duration: 0.55,
              ease: "back.out(1.5)",
              overwrite: "auto",
            },
          );
        }
        if (floatImgs.length) {
          gsap.fromTo(
            floatImgs,
            { scale: 0.5, opacity: 0 },
            {
              scale: 1,
              opacity: 1,
              duration: 0.5,
              stagger: 0.08,
              ease: "back.out(2.1)",
              delay: 0.1,
              overwrite: "auto",
            },
          );
        }
      }
    };

    allDetails.forEach((details) => {
      details.addEventListener("toggle", () => {
        if (!details.open) return;
        const stepIdx = Number(details.dataset.step ?? "0");
        activateProcessStep(stepIdx);
      });
    });

    allDots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const idx = Number(dot.dataset.stepDot ?? "0");
        const targetDetails = allDetails[idx];
        if (targetDetails) {
          targetDetails.open = true;
        } else {
          activateProcessStep(idx);
        }
      });
    });
  </script>

