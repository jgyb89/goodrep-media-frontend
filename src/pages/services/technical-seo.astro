---
import MainLayout from "../../layouts/MainLayout.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import StartsSection from "../../components/StartsSection.astro";
import StatsBand from "../../components/StatsBand.astro";
import PillarsSection from "../../components/PillarsSection.astro";
import ProcessSection from "../../components/ProcessSection.astro";
import ReadyBand from "../../components/ReadyBand.astro";
import DeliverablesGrid from "../../components/DeliverablesGrid.astro";
import ConsultSection from "../../components/ConsultSection.astro";

import {
  metaData,
  heroData,
  startsData,
  statsData,
  pillarsData,
  processData,
  scopeData,
  readyData,
  deliverablesData,
  consultData,
} from "../../data/technicalSeoData.js";
---

<MainLayout title={metaData.title} description={metaData.description}>
  <ServiceHero {...heroData} />
  <StartsSection {...startsData} />
  <StatsBand {...statsData} />
  <PillarsSection {...pillarsData} />
  <ProcessSection
    {...processData}
    accordionName="technical-seo-process"
    stageLabelPrefix="Advantage"
  />
  <StartsSection {...scopeData} />
  <ReadyBand {...readyData} />
  <DeliverablesGrid {...deliverablesData} />
  <ConsultSection {...consultData} />
</MainLayout>
