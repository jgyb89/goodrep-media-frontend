---
import MainLayout from "../../layouts/MainLayout.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import StartsSection from "../../components/StartsSection.astro";
import StatsBand from "../../components/StatsBand.astro";
import ProcessSection from "../../components/ProcessSection.astro";
import ReadyBand from "../../components/ReadyBand.astro";
import DeliverablesGrid from "../../components/DeliverablesGrid.astro";
import ConsultSection from "../../components/ConsultSection.astro";

import {
  metaData,
  heroData,
  startsData,
  statsData,
  scopeData,
  processData,
  readyData,
  deliverablesData,
  consultData,
} from "../../data/ecommerceWebDesignData.js";

const serviceSchema = {
  "@type": "Service",
  "name": "eCommerce Web Design Services",
  "provider": {
    "@id": "https://goodrep.media/#organization"
  },
  "areaServed": "Grand Rapids, MI",
  "description": metaData.description || "Custom eCommerce web design and store development for growing brands."
};
---

<MainLayout
  title={metaData.title}
  description={metaData.description}
  pageSchema={serviceSchema}
>
  <ServiceHero {...heroData} />
  <StartsSection {...startsData} />
  <StatsBand {...statsData} />
  <StartsSection {...scopeData} />
  <ProcessSection
    {...processData}
    accordionName="ecom-design-process"
    stageLabelPrefix="Phase"
  />
  <DeliverablesGrid {...deliverablesData} />
  <ReadyBand {...readyData} />
  <ConsultSection {...consultData} theme="dark" />
</MainLayout>
