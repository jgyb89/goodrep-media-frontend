---
import MainLayout from "../../layouts/MainLayout.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import StartsSection from "../../components/StartsSection.astro";
import StatsBand from "../../components/StatsBand.astro";
import PillarsSection from "../../components/PillarsSection.astro";
import ProcessSection from "../../components/ProcessSection.astro";
import StartsSectionScope from "../../components/StartsSection.astro";
import DeliverablesGrid from "../../components/DeliverablesGrid.astro";
import ReadyBand from "../../components/ReadyBand.astro";
import ConsultSection from "../../components/ConsultSection.astro";

import {
  metaData,
  heroData,
  startsData,
  statsData,
  pillarsData,
  processData,
  scopeData,
  strategiesGridData,
  readyData,
  workingGridData,
  consultData,
} from "../../data/linkBuildingData.js";

const serviceSchema = {
  "@type": "Service",
  "name": "Link Building & Digital PR Services",
  "provider": {
    "@id": "https://goodrep.media/#organization"
  },
  "areaServed": "Grand Rapids, MI",
  "description": metaData.description || "High-authority editorial link building and digital PR for domain growth."
};
---

<MainLayout
  title={metaData.title}
  description={metaData.description}
  pageSchema={serviceSchema}
>
  <ServiceHero {...heroData} />
  <StartsSection {...startsData} />
  <StatsBand {...statsData} />
  <PillarsSection {...pillarsData} />
  <ProcessSection
    {...processData}
    accordionName="link-building-process"
    stageLabelPrefix="Step"
  />
  <StartsSectionScope {...scopeData} />
  <DeliverablesGrid {...strategiesGridData} />
  <DeliverablesGrid {...workingGridData} />
  <ReadyBand {...readyData} />
  <ConsultSection {...consultData} theme="dark" />
</MainLayout>
