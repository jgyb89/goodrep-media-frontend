---
import MainLayout from "../../layouts/MainLayout.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import StartsSection from "../../components/StartsSection.astro";
import StatsBand from "../../components/StatsBand.astro";
import PillarsSection from "../../components/PillarsSection.astro";
import ProcessSection from "../../components/ProcessSection.astro";
import StartsSectionApproach from "../../components/StartsSection.astro";
import DeliverablesGrid from "../../components/DeliverablesGrid.astro";
import ReadyBand from "../../components/ReadyBand.astro";
import ConsultSection from "../../components/ConsultSection.astro";

import {
  metaData,
  heroData,
  startsData,
  statsData,
  pillarsData,
  processData,
  approachData,
  deliverablesData,
  readyData,
  consultData,
} from "../../data/videoProductionData.js";

const serviceSchema = {
  "@type": "Service",
  "name": "Video Production Services",
  "provider": {
    "@id": "https://goodrep.media/#organization"
  },
  "areaServed": "Grand Rapids, MI",
  "description": metaData.description || "High-impact video production and commercial video advertising services."
};
---

<MainLayout
  title={metaData.title}
  description={metaData.description}
  pageSchema={serviceSchema}
>
  <ServiceHero {...heroData} />
  <StartsSection {...startsData} />
  <StatsBand {...statsData} />
  <PillarsSection {...pillarsData} />
  <ProcessSection
    {...processData}
    accordionName="video-production-process"
    stageLabelPrefix="Phase"
  />
  <StartsSectionApproach {...approachData} />
  <DeliverablesGrid {...deliverablesData} />
  <ReadyBand {...readyData} />
  <ConsultSection {...consultData} theme="dark" />
</MainLayout>
