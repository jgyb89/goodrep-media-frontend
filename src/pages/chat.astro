---
// src/pages/chat.astro
import MainLayout from "../layouts/MainLayout.astro";

const pageTitle = "Schedule a 1-on-1 Consultation | Good Rep Media";
const pageDescription =
  "Book a free 30-minute growth strategy session with Good Rep Media. Pick an open slot on our calendar to discuss SEO, web design, paid ads, and digital marketing.";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Schedule a Strategy Consultation | Good Rep Media",
  description: pageDescription,
  url: "https://goodrep.media/chat/",
  mainEntity: {
    "@type": "LocalBusiness",
    name: "Good Rep Media",
    telephone: "+1-616-300-9868",
    email: "team@goodrep.media",
    address: {
      "@type": "PostalAddress",
      streetAddress: "O-745 Lake Michigan Dr. NW",
      addressLocality: "Grand Rapids",
      addressRegion: "MI",
      postalCode: "49534",
      addressCountry: "US",
    },
  },
};

const perks = [
  {
    icon: "schedule",
    title: "30-Minute Focused Session",
    desc: "A direct, high-value conversation centered on your business goals and current roadblocks.",
  },
  {
    icon: "groups",
    title: "1-on-1 With Real Strategists",
    desc: "Speak with experienced in-house pros in Grand Rapids — never an outsourced call center.",
  },
  {
    icon: "verified_user",
    title: "100% Free & Zero Pitch",
    desc: "Walk away with an honest footprint review and actionable ideas you can keep, no strings attached.",
  },
];

const steps = [
  {
    number: "01",
    tag: "CALENDAR",
    title: "Pick Your Date & Time",
    desc: "Choose an open slot below. An instant calendar invitation with Google Meet video & dial-in info will be delivered to your inbox.",
    icon: "calendar_today",
  },
  {
    number: "02",
    tag: "PRE-AUDIT",
    title: "We Inspect Your Footprint",
    desc: "Before we talk, our team analyzes your website speed, local SEO presence, and competitor landscape so we come prepared with insights.",
    icon: "query_stats",
  },
  {
    number: "03",
    tag: "ROADMAP",
    title: "Actionable Growth Plan",
    desc: "We discuss practical strategies to get your phones ringing and calendar booked — with clear timelines and transparent expectations.",
    icon: "rocket_launch",
  },
];

const faqs = [
  {
    q: "How does the consultation take place?",
    a: "We meet over a Google Meet video call (link sent automatically in your calendar invite). Prefer a regular phone call? Just note it when booking or let us know!",
  },
  {
    q: "What should I prepare for our call?",
    a: "Nothing formal! Just bring your current website URL, your biggest marketing bottlenecks, and what revenue or lead goals you want to reach this year.",
  },
  {
    q: "What if I can't find a time that works?",
    a: "We are flexible! Reach out directly at (616) 300-9868 or email team@goodrep.media, and we'll happily arrange an alternate time that accommodates your schedule.",
  },
  {
    q: "Is this consultation genuinely free?",
    a: "Yes, 100%. We provide honest audits and practical advice. We don't believe in pushy sales tactics — if we are a good fit to work together, you'll know it.",
  },
];
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  pageSchema={pageSchema}
>
  <!-- CHAT BOOKING HERO -->
  <section class="chat-hero">
    <!-- Ambient Backdrop Art from public assets -->
    <div class="chat-hero__backdrop" aria-hidden="true">
      <img
        class="chat-hero__blob"
        src="/grm-web-assets/blue-circular-background-graphic.svg"
        alt=""
        width="746"
        height="780"
        loading="eager"
      />
      <img
        class="chat-hero__decor chat-hero__decor--chat"
        src="/grm-web-assets/3d-chat-bubbles-graphic.svg"
        alt=""
        width="62"
        height="66"
        loading="eager"
      />
      <img
        class="chat-hero__decor chat-hero__decor--cal"
        src="/grm-web-assets/calendar-graphic.svg"
        alt=""
        width="140"
        height="135"
        loading="eager"
      />
    </div>

    <div class="container chat-hero__container">
      <!-- Breadcrumb -->
      <nav class="chat-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="chat-breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Schedule a Chat</span>
      </nav>

      <!-- Eyebrow Pill -->
      <div class="chat-eyebrow">
        <span class="chat-eyebrow__pulse" aria-hidden="true"></span>
        <span class="chat-eyebrow__text">Free 30-Minute Strategy Session</span>
      </div>

      <!-- Main Headline -->
      <h1 class="chat-hero__title">
        Let’s Chat: Book Your Free <span class="text-cyan"
          >1-on-1 Strategy Call</span
        >
      </h1>

      <!-- Lead paragraph -->
      <p class="chat-hero__lead">
        Select a date and time on the calendar below that works for your
        schedule. In 30 focused minutes, we’ll review your digital footprint,
        answer your questions, and provide an honest, actionable plan to grow
        your business.
      </p>
    </div>
  </section>

  <!-- CALENDLY EMBED SECTION (PRIMARY FOCUS) -->
  <section class="chat-embed-section" id="booking-calendar">
    <div class="container chat-embed-container">
      <div class="chat-calendar-card">
        <!-- Card Top Bar / Live Status Indicator -->
        <header class="chat-calendar-card__header">
          <div class="chat-calendar-card__status">
            <span class="chat-calendar-card__live-dot" aria-hidden="true"
            ></span>
            <span class="chat-calendar-card__status-text"
              >Live Scheduling &bull; Immediate Confirmation</span
            >
          </div>
          <div class="chat-calendar-card__meta">
            <span
              class="material-symbols-outlined chat-calendar-card__meta-icon"
              aria-hidden="true"
            >
              schedule
            </span>
            <span>All times display in your local time zone</span>
          </div>
        </header>

        <!-- Calendly Embed Widget Container -->
        <div class="chat-calendar-card__widget-wrapper">
          <!-- Subtle Loading Placeholder / Fallback Skeleton -->
          <div class="chat-calendar-card__skeleton" aria-hidden="true">
            <div class="chat-skeleton-spinner">
              <span class="material-symbols-outlined chat-skeleton-icon"
                >calendar_month</span
              >
              <span class="chat-skeleton-text"
                >Loading scheduling calendar...</span
              >
            </div>
          </div>

          <!-- Calendly inline widget begin -->
          <div
            class="calendly-inline-widget"
            data-url="https://calendly.com/goodrep-media/free-consultation"
            style="min-width:320px;height:700px;"
          >
          </div>
          <script
            type="text/javascript"
            src="https://assets.calendly.com/assets/external/widget.js"
            async
            is:inline></script>
          <!-- Calendly inline widget end -->
        </div>

        <!-- Card Footer with Direct Fallback Link -->
        <footer class="chat-calendar-card__footer">
          <p class="chat-calendar-card__fallback-text">
            Having trouble viewing the calendar?
            <a
              href="https://calendly.com/goodrep-media/free-consultation"
              target="_blank"
              rel="noopener noreferrer"
              class="chat-calendar-card__fallback-link"
            >
              Open Calendly directly in a new tab &rarr;
            </a>
          </p>
        </footer>
      </div>

      <!-- Trust Perks Row (Placed below Calendly embed window) -->
      <div class="chat-perks">
        {
          perks.map((perk) => (
            <div class="chat-perk-card">
              <div class="chat-perk-card__icon-wrap">
                <span
                  class="material-symbols-outlined chat-perk-card__icon"
                  aria-hidden="true"
                >
                  {perk.icon}
                </span>
              </div>
              <div class="chat-perk-card__body">
                <h2 class="chat-perk-card__title">{perk.title}</h2>
                <p class="chat-perk-card__desc">{perk.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WHAT HAPPENS NEXT (CONCISE 3-STEP PROCESS) -->
  <section class="section chat-process">
    <div class="container">
      <header class="section-head text-center chat-process__head">
        <span class="chat-kicker">WHAT TO EXPECT</span>
        <h2 class="chat-section-title">A Fast, Simple Path to Clarity</h2>
        <p class="chat-section-lead">
          We respect your busy schedule as a business owner. Here is exactly
          what happens when you book a chat with us:
        </p>
      </header>

      <div class="chat-process__grid">
        {
          steps.map((step) => (
            <div class="chat-step-card">
              <div class="chat-step-card__top">
                <span class="chat-step-card__num">{step.number}</span>
                <span class="chat-step-card__tag">{step.tag}</span>
              </div>
              <div class="chat-step-card__icon-box">
                <span
                  class="material-symbols-outlined chat-step-card__icon"
                  aria-hidden="true"
                >
                  {step.icon}
                </span>
              </div>
              <h3 class="chat-step-card__title">{step.title}</h3>
              <p class="chat-step-card__desc">{step.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FREQUENTLY ASKED QUESTIONS -->
  <section class="section chat-faq">
    <div class="container chat-faq__container">
      <header class="section-head text-center chat-faq__head">
        <span class="chat-kicker">COMMON QUESTIONS</span>
        <h2 class="chat-section-title">
          Everything You Need to Know Before Booking
        </h2>
      </header>

      <div class="chat-faq__grid">
        {
          faqs.map((faq) => (
            <div class="chat-faq-card">
              <div class="chat-faq-card__q-wrap">
                <span
                  class="material-symbols-outlined chat-faq-card__q-icon"
                  aria-hidden="true"
                >
                  help_outline
                </span>
                <h3 class="chat-faq-card__question">{faq.q}</h3>
              </div>
              <p class="chat-faq-card__answer">{faq.a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- QUICK CONTACT / ALTERNATIVE STRIP -->
  <section class="chat-alt-strip">
    <div class="container chat-alt-strip__container">
      <div class="chat-alt-strip__card">
        <div class="chat-alt-strip__art" aria-hidden="true">
          <img
            src="/grm-web-assets/online-support-graphic.svg"
            alt=""
            width="220"
            height="180"
            loading="lazy"
          />
        </div>
        <div class="chat-alt-strip__content">
          <span class="chat-alt-strip__kicker">NEED TO CONNECT SOONER?</span>
          <h2 class="chat-alt-strip__title">
            Prefer to call or send a quick message?
          </h2>
          <p class="chat-alt-strip__text">
            If you have an urgent inquiry or prefer talking by phone right away,
            our team is ready to help you.
          </p>
          <div class="chat-alt-strip__actions">
            <a
              href="tel:+16163009868"
              class="btn btn--primary chat-alt-strip__btn"
            >
              <span class="material-symbols-outlined" aria-hidden="true"
                >call</span
              >
              <span>(616) 300-9868</span>
            </a>
            <a
              href="mailto:team@goodrep.media"
              class="btn btn--outline chat-alt-strip__btn"
            >
              <span class="material-symbols-outlined" aria-hidden="true"
                >mail</span
              >
              <span>team@goodrep.media</span>
            </a>
            <button
              type="button"
              class="btn btn--ghost chat-alt-strip__btn"
              data-open-modal
            >
              <span class="material-symbols-outlined" aria-hidden="true"
                >chat</span
              >
              <span>Send Message</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* ==========================================================================
     CHAT PAGE STYLES
     ========================================================================== */

  .text-cyan {
    color: var(--color-cyan, #1bc4d9);
  }

  /* ---------------- Hero Section ---------------- */
  .chat-hero {
    position: relative;
    padding: clamp(2.5rem, 5vw, 4rem) 0 1rem;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    overflow: hidden;
  }

  .chat-hero__backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .chat-hero__blob {
    position: absolute;
    top: -150px;
    right: -100px;
    width: 650px;
    height: 650px;
    opacity: 0.22;
    filter: blur(10px);
  }

  .chat-hero__decor {
    position: absolute;
    opacity: 0.85;
    transition: transform 0.5s ease-out;
  }

  .chat-hero__decor--chat {
    top: 40px;
    left: clamp(1rem, 5vw, 6rem);
    width: clamp(40px, 4vw, 56px);
    height: auto;
    animation: chatFloat 6s ease-in-out infinite;
  }

  .chat-hero__decor--cal {
    top: 80px;
    right: clamp(1rem, 6vw, 7rem);
    width: clamp(65px, 6vw, 100px);
    height: auto;
    opacity: 0.75;
    animation: chatFloat 7s ease-in-out infinite reverse;
  }

  @keyframes chatFloat {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-12px) rotate(2deg);
    }
  }

  .chat-hero__container {
    position: relative;
    z-index: 1;
    max-width: 1040px;
    margin: 0 auto;
    text-align: center;
  }

  /* ---------------- Breadcrumb ---------------- */
  .chat-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-muted, #64748b);
    margin: 0 0.4rem 0 0;
  }

  .chat-breadcrumb a {
    color: var(--color-muted, #64748b);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .chat-breadcrumb a:hover {
    color: var(--color-cyan, #1bc4d9);
  }

  .chat-breadcrumb__sep {
    color: #cbd5e1;
  }

  /* ---------------- Eyebrow Pill ---------------- */
  .chat-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    background: #e6f9fc;
    border: 1px solid rgba(27, 196, 217, 0.35);
    margin: 0 0 0 0.1rem;
  }

  .chat-eyebrow__pulse {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-cyan, #1bc4d9);
    box-shadow: 0 0 0 0 rgba(27, 196, 217, 0.7);
    animation: pulseCyan 2s infinite;
  }

  @keyframes pulseCyan {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(27, 196, 217, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 8px rgba(27, 196, 217, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(27, 196, 217, 0);
    }
  }

  .chat-eyebrow__text {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #0c8392;
  }

  /* ---------------- Headline & Lead ---------------- */
  .chat-hero__title {
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    font-weight: 800;
    line-height: 1.18;
    color: var(--color-dark, #333333);
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
  }

  .chat-hero__lead {
    font-size: clamp(1rem, 1.35vw, 1.1875rem);
    line-height: 1.7;
    color: #475569;
    max-width: 780px;
    margin: 0 auto;
  }

  /* ---------------- Primary Embed Container ---------------- */
  .chat-embed-section {
    padding: 1.5rem 0 4.5rem;
    background: #f8fafc;
  }

  .chat-embed-container {
    max-width: 1040px;
    margin: 0 auto;
  }

  .chat-calendar-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    box-shadow:
      0 16px 40px -12px rgba(15, 23, 42, 0.12),
      0 0 0 1px rgba(27, 196, 217, 0.1);
    overflow: hidden;
    position: relative;
    transition: box-shadow 0.3s ease;
  }

  .chat-calendar-card:hover {
    box-shadow:
      0 24px 50px -15px rgba(15, 23, 42, 0.16),
      0 0 0 1px rgba(27, 196, 217, 0.2);
  }

  /* Header of Calendar Card */
  .chat-calendar-card__header {
    background: #fcfdfe;
    border-bottom: 1px solid #edf2f7;
    padding: 1rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .chat-calendar-card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: #0f766e;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
  }

  .chat-calendar-card__live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    display: inline-block;
    box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.25);
  }

  .chat-calendar-card__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: #64748b;
  }

  .chat-calendar-card__meta-icon {
    font-size: 16px;
    color: var(--color-cyan, #1bc4d9);
  }

  /* Widget & Skeleton */
  .chat-calendar-card__widget-wrapper {
    position: relative;
    min-height: 700px;
    width: 100%;
    background: #ffffff;
  }

  .chat-calendar-card__skeleton {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    z-index: 0;
    pointer-events: none;
  }

  .chat-skeleton-spinner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: #94a3b8;
  }

  .chat-skeleton-icon {
    font-size: 48px;
    color: var(--color-cyan, #1bc4d9);
    animation: pulseIcon 1.8s infinite ease-in-out;
  }

  .chat-skeleton-text {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  @keyframes pulseIcon {
    0%,
    100% {
      opacity: 0.4;
      transform: scale(0.96);
    }
    50% {
      opacity: 1;
      transform: scale(1.05);
    }
  }

  /* The actual Calendly inline widget sits on top */
  .chat-calendar-card__widget-wrapper :global(.calendly-inline-widget) {
    position: relative;
    z-index: 1;
    width: 100% !important;
  }

  /* Card Footer / Direct Link */
  .chat-calendar-card__footer {
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    padding: 0.9rem 1.75rem;
    text-align: center;
  }

  .chat-calendar-card__fallback-text {
    font-size: 0.84rem;
    color: #64748b;
    margin: 0;
  }

  .chat-calendar-card__fallback-link {
    color: var(--color-cyan, #1bc4d9);
    font-weight: 700;
    text-decoration: none;
    margin-left: 0.25rem;
    transition:
      color 0.15s ease,
      text-decoration 0.15s ease;
  }

  .chat-calendar-card__fallback-link:hover {
    color: var(--color-cyan-dark, #0fa3b6);
    text-decoration: underline;
  }

  /* ---------------- Perks Grid (Below Calendar Card) ---------------- */
  .chat-perks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 2rem;
    text-align: left;
  }

  .chat-perk-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    box-shadow: 0 4px 16px -6px rgba(15, 23, 42, 0.06);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .chat-perk-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px -8px rgba(15, 23, 42, 0.12);
    border-color: rgba(27, 196, 217, 0.4);
  }

  .chat-perk-card__icon-wrap {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: #e6f9fc;
    color: var(--color-cyan, #1bc4d9);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chat-perk-card__icon {
    font-size: 24px;
  }

  .chat-perk-card__title {
    font-size: 0.9375rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
    color: var(--color-dark, #333333);
  }

  .chat-perk-card__desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #64748b;
    margin: 0;
  }

  /* ---------------- Process Section ---------------- */
  .chat-process {
    padding: 5rem 0;
    background: #ffffff;
  }

  .chat-kicker {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-primary, #e94f37);
    margin-bottom: 0.5rem;
  }

  .chat-section-title {
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 700;
    color: var(--color-dark, #333333);
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }

  .chat-section-lead {
    font-size: 1.05rem;
    color: #64748b;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.65;
  }

  .chat-process__head {
    margin-bottom: 3rem;
  }

  .chat-process__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .chat-step-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .chat-step-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px -10px rgba(15, 23, 42, 0.12);
    border-color: rgba(27, 196, 217, 0.5);
  }

  .chat-step-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .chat-step-card__num {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-cyan, #1bc4d9);
  }

  .chat-step-card__tag {
    font-size: 0.6875rem;
    font-weight: 800;
