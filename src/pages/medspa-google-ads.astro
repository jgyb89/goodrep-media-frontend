---
// src/pages/medspa-google-ads.astro
// Replicated Landing Page: https://goodrep.media/medspa-google-ads/
import LandingLayout from "../layouts/LandingLayout.astro";
import ConsultSection from "../components/ConsultSection.astro";
import FaqSection from "../components/landing/FaqSection.astro";
import {
  heroData,
  clientLogos,
  howWeHelpData,
  benefitsData,
  statsData,
  whyGoodRepData,
  testimonialsData,
  faqData,
  auditConsultData,
} from "../data/medspaGoogleAdsData.js";
---

<LandingLayout
  title="Google Ads for Med Spas & Aesthetics | Good Rep Media"
  description="Generate more local calls, consultations, and bookings for your med spa or therapy practice with dedicated Google Ads campaign management."
  ctaLabel="Get Free Audit"
  ctaHref="#get-free-audit"
>
  <!-- ================= 1. HERO SECTION ================= -->
  <section class="medspa-hero">
    <div class="medspa-hero__bg-texture" aria-hidden="true"></div>
    <div class="container medspa-hero__container">
      <div class="medspa-hero__content">
        <span class="eyebrow eyebrow--cyan">{heroData.eyebrow}</span>
        <h1 class="medspa-hero__title">
          Help More Local Clients Find Your Med Spa or Therapy Practice With <span
            class="text-highlight">Google Ads</span
          >?
        </h1>
        <div class="medspa-hero__lead">
          {heroData.lead.map((para) => (
            <p>{para}</p>
          ))}
        </div>
        <div class="medspa-hero__actions">
          <a href={heroData.ctaPrimary.href} class="btn btn--cyan">
            {heroData.ctaPrimary.label}
          </a>
          <a href={heroData.ctaSecondary.href} class="btn btn--red">
            {heroData.ctaSecondary.label}
          </a>
        </div>
      </div>

      <div class="medspa-hero__visual">
        <div class="medspa-art-stage">
          <img
            class="medspa-art__blob"
            src={heroData.art.blob}
            alt=""
            width="746"
            height="780"
            loading="eager"
          />
          <img
            class="medspa-art__main"
            src={heroData.art.main}
            alt={heroData.art.mainAlt}
            width="746"
            height="780"
            loading="eager"
          />
          <img
            class="medspa-art__satellite medspa-art__satellite--coins"
            src={heroData.art.accent1.src}
            alt=""
            width="746"
            height="780"
            style={heroData.art.accent1.style}
            data-float
            loading="eager"
          />
          <img
            class="medspa-art__satellite medspa-art__satellite--target"
            src={heroData.art.accent2.src}
            alt=""
            width="746"
            height="780"
            style={heroData.art.accent2.style}
            data-float
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 2. CLIENT LOGOS MARQUEE ================= -->
  <section class="medspa-marquee" aria-label="Trusted Clients">
    <div class="container medspa-marquee__header">
      <span class="eyebrow eyebrow--cyan">Trusted by our Clients</span>
    </div>
    <div class="medspa-marquee__viewport">
      <div class="medspa-marquee__track" aria-hidden="true">
        {clientLogos.concat(clientLogos).map((logo) => (
          <div class="medspa-marquee__item">
            <img
              src={logo.src}
              alt={logo.name}
              style={`width: ${logo.width}px;`}
              loading="lazy"
            />
          </div>
        ))}
      </div>
      <div class="medspa-marquee__track" aria-hidden="true">
        {clientLogos.concat(clientLogos).map((logo) => (
          <div class="medspa-marquee__item">
            <img
              src={logo.src}
              alt={logo.name}
              style={`width: ${logo.width}px;`}
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 3. HOW WE HELP SPOTLIGHT ================= -->
  <section class="section medspa-spotlight">
    <div class="container medspa-spotlight__layout">
      <div class="medspa-spotlight__media">
        <div class="medspa-spotlight__frame">
          <img
            src={howWeHelpData.media.src}
            alt={howWeHelpData.media.alt}
            width={howWeHelpData.media.width}
            height={howWeHelpData.media.height}
            loading="lazy"
          />
        </div>
      </div>

      <div class="medspa-spotlight__content">
        <span class="eyebrow eyebrow--cyan">{howWeHelpData.eyebrow}</span>
        <h2 class="section-title">{howWeHelpData.title}</h2>
        <p class="section-lead">{howWeHelpData.description}</p>
        <ul class="medspa-checklist">
          <li>
            <span class="material-symbols-outlined check-icon">check_circle</span>
            <span>Target local people actively searching for treatments</span>
          </li>
          <li>
            <span class="material-symbols-outlined check-icon">check_circle</span>
            <span>Eliminate wasted spend on negative & low-intent clicks</span>
          </li>
          <li>
            <span class="material-symbols-outlined check-icon">check_circle</span>
            <span>Accurate tracking for calls, consults, and booking forms</span>
          </li>
          <li>
            <span class="material-symbols-outlined check-icon">check_circle</span>
            <span>Ongoing weekly refinement and proactive optimization</span>
          </li>
        </ul>
        <div class="medspa-spotlight__cta">
          <a href="#get-free-audit" class="btn btn--cyan">
            Explore Free Audit Options
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 4. 6 BENEFIT VALUE CARDS ================= -->
  <section class="section medspa-benefits">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow eyebrow--cyan">Core Benefits</span>
        <h2 class="section-title">Built for Practice Growth That Lasts</h2>
        <p class="section-lead">
          Everything your med spa or clinic needs to capture local demand and keep high-value treatment chairs filled.
        </p>
      </div>

      <div class="medspa-benefits__grid">
        {benefitsData.map((b) => (
          <article class="benefit-card">
            <div class="benefit-card__icon-wrap">
              <img src={b.icon} alt="" width="56" height="56" loading="lazy" />
            </div>
            <h3 class="benefit-card__title">{b.title}</h3>
            <p class="benefit-card__text">{b.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 5. STATS METRICS RIBBON ================= -->
  <section class="medspa-stats">
    <div class="container medspa-stats__grid">
      {statsData.map((s) => (
        <div class="stat-box">
          <div class="stat-box__num">{s.value}</div>
          <div class="stat-box__label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ================= 6. WHY GOODREP 4 PILLARS & PROOF ================= -->
  <section class="section medspa-pillars">
    <div class="container medspa-pillars__layout">
      <div class="medspa-pillars__content">
        <span class="eyebrow eyebrow--cyan">{whyGoodRepData.eyebrow}</span>
        <h2 class="section-title">{whyGoodRepData.title}</h2>
        <div class="medspa-pillars__lead">
          {whyGoodRepData.lead.map((p) => (
            <p>{p}</p>
          ))}
        </div>

        <div class="medspa-pillars__steps">
          {whyGoodRepData.pillars.map((step) => (
            <div class="pillar-step">
              <div class="pillar-step__badge">{step.number}</div>
              <div class="pillar-step__info">
                <h3 class="pillar-step__title">{step.title}</h3>
                <p class="pillar-step__text">{step.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="medspa-pillars__proof">
        <div class="proof-stack">
          {whyGoodRepData.visualProofs.map((proof, idx) => (
            <div
              class:list={["proof-card", `proof-card--${idx + 1}`]}
              style={`transform: rotate(${proof.tilt});`}
            >
              <img
                src={proof.src}
                alt={proof.alt}
                width="500"
                height="340"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 7. TESTIMONIALS ================= -->
  <section class="section medspa-testimonials">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow eyebrow--cyan">{testimonialsData.eyebrow}</span>
        <h2 class="section-title">{testimonialsData.title}</h2>
        <p class="section-lead">{testimonialsData.subtitle}</p>
      </div>

      <div class="medspa-testimonials__grid">
        {testimonialsData.items.map((item) => (
          <article class="testimonial-card">
            <div class="testimonial-card__stars" aria-label="5 stars">
              <span class="material-symbols-outlined star-icon">star</span>
              <span class="material-symbols-outlined star-icon">star</span>
              <span class="material-symbols-outlined star-icon">star</span>
              <span class="material-symbols-outlined star-icon">star</span>
              <span class="material-symbols-outlined star-icon">star</span>
            </div>
            <blockquote class="testimonial-card__quote">
              &ldquo;{item.quote}&rdquo;
            </blockquote>
            <div class="testimonial-card__author">
              <img
                class="testimonial-card__avatar"
                src={item.avatar}
                alt={item.author}
                width="64"
                height="64"
                loading="lazy"
              />
              <div class="testimonial-card__meta">
                <div class="testimonial-card__name">{item.author}</div>
                <div class="testimonial-card__role">
                  {item.role}, {item.company}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 8. FAQ ACCORDION ================= -->
  <FaqSection {...faqData} />

  <!-- ================= 9. AUDIT CONSULTATION SECTION ================= -->
  <ConsultSection
    id={auditConsultData.id}
    kicker={auditConsultData.kicker}
    title={auditConsultData.title}
    text={auditConsultData.text}
    cardTitle={auditConsultData.cardTitle}
    submitLabel={auditConsultData.submitLabel}
    art={auditConsultData.art}
  />
</LandingLayout>

<style>
  /* ---------- Hero Section ---------- */
  .medspa-hero {
    position: relative;
    background: #0d1117;
    color: #ffffff;
    padding: clamp(3.5rem, 7vw, 6rem) 0 clamp(4rem, 8vw, 6.5rem);
    overflow: hidden;
  }

  .medspa-hero__bg-texture {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
        circle at 80% 20%,
        rgba(8, 193, 212, 0.15) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 20% 80%,
        rgba(233, 79, 55, 0.08) 0%,
        transparent 45%
      );
    pointer-events: none;
  }

  .medspa-hero__container {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .medspa-hero__container {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
    }
  }

  .eyebrow--cyan {
    color: var(--color-cyan);
    font-weight: 700;
  }

  .medspa-hero__title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.18;
    margin: 0.5rem 0 1.5rem;
    color: #ffffff;
    text-wrap: balance;
  }

  .text-highlight {
    color: var(--color-cyan);
    background: linear-gradient(135deg, #1bc4d9 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .medspa-hero__lead {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: #c9d1d9;
    margin-bottom: 2rem;
  }

  .medspa-hero__lead p {
    margin: 0;
  }

  .medspa-hero__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn--cyan {
    background: var(--color-cyan);
    color: #0d1117;
    font-weight: 700;
    border-radius: 9999px;
    padding: 0.85rem 1.8rem;
    box-shadow: 0 4px 18px rgba(8, 193, 212, 0.35);
  }

  .btn--cyan:hover {
    background: #1cd4e8;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(8, 193, 212, 0.45);
  }

  .btn--red {
    background: #e31c23;
    color: #ffffff;
    font-weight: 700;
    border-radius: 9999px;
    padding: 0.85rem 1.8rem;
    box-shadow: 0 4px 18px rgba(227, 28, 35, 0.35);
  }

  .btn--red:hover {
    background: #f02830;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(227, 28, 35, 0.45);
  }

  /* Art Stage */
  .medspa-hero__visual {
    display: flex;
    justify-content: center;
  }

  .medspa-art-stage {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1 / 0.95;
    margin: 0 auto;
  }

  .medspa-art__blob {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 90%;
    height: auto;
    z-index: 0;
  }

  .medspa-art__main {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 86%;
    max-height: 86%;
    z-index: 2;
    object-fit: contain;
    filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.4));
  }

  .medspa-art__satellite {
    position: absolute;
    z-index: 3;
    filter: drop-shadow(0 12px 18px rgba(0, 0, 0, 0.35));
    animation: float 4s ease-in-out infinite alternate;
  }

  .medspa-art__satellite--coins {
    animation-delay: 0.5s;
  }

  .medspa-art__satellite--target {
    animation-delay: 1.5s;
  }

  @keyframes float {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-12px);
    }
  }

  /* ---------- Client Marquee ---------- */
  .medspa-marquee {
    background: #090d12;
    padding: 2.5rem 0 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .medspa-marquee__header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .medspa-marquee__viewport {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 3rem;
  }

  .medspa-marquee__track {
    display: flex;
    align-items: center;
    gap: 4rem;
    animation: marquee 30s linear infinite;
    flex-shrink: 0;
    min-width: 100%;
  }

  .medspa-marquee__item {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
    transition: opacity 0.3s;
  }

  .medspa-marquee__item:hover {
    opacity: 1;
  }

  .medspa-marquee__item img {
    max-height: 48px;
    width: auto;
    object-fit: contain;
    filter: brightness(1.1);
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  /* ---------- Spotlight Section ---------- */
  .medspa-spotlight {
    background: #ffffff;
  }

  .medspa-spotlight__layout {
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .medspa-spotlight__layout {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }

  .medspa-spotlight__frame {
    background: #f8fafc;
    border-radius: 20px;
    padding: 1rem;
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08);
    border: 1px solid var(--color-border);
  }

  .medspa-spotlight__frame img {
    border-radius: 14px;
    width: 100%;
    height: auto;
    display: block;
  }

  .medspa-checklist {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .medspa-checklist li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.05rem;
    color: var(--color-dark);
  }

  .check-icon {
    color: var(--color-cyan);
    font-size: 1.4rem;
    flex-shrink: 0;
  }

  /* ---------- Benefits Grid ---------- */
  .medspa-benefits {
    background: var(--color-bg);
  }

  .medspa-benefits__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .medspa-benefits__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .medspa-benefits__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .benefit-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 2.25rem 2rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
  }

  .benefit-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(15, 23, 42, 0.08);
    border-color: var(--color-cyan);
  }

  .benefit-card__icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    background: #eefbfc;
    display: grid;
    place-items: center;
    margin-bottom: 1.5rem;
  }

  .benefit-card__icon-wrap img {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .benefit-card__title {
    font-size: 1.25rem;
    margin: 0 0 0.75rem;
    color: var(--color-dark);
    line-height: 1.35;
  }

  .benefit-card__text {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.65;
    font-size: 0.98rem;
  }

  /* ---------- Stats Ribbon ---------- */
  .medspa-stats {
    background: #0d1117;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 3.5rem 0;
  }

  .medspa-stats__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(2, 1fr);
    text-align: center;
  }

  @media (min-width: 960px) {
    .medspa-stats__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-box {
    padding: 1.5rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .stat-box:hover {
    border-color: var(--color-cyan);
    transform: translateY(-3px);
  }

  .stat-box__num {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 700;
    color: var(--color-cyan);
    line-height: 1;
    margin-bottom: 0.65rem;
  }

  .stat-box__label {
    color: #e2e8f0;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* ---------- Pillars Section ---------- */
  .medspa-pillars {
    background: #ffffff;
  }

  .medspa-pillars__layout {
    display: grid;
    gap: 4rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .medspa-pillars__layout {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  .medspa-pillars__lead {
    margin-bottom: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .medspa-pillars__lead p {
    margin: 0;
  }

  .medspa-pillars__steps {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .pillar-step {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    background: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 1.5rem;
    transition: border-color 0.25s, transform 0.25s;
  }

  .pillar-step:hover {
    border-color: var(--color-cyan);
    transform: translateX(4px);
  }

  .pillar-step__badge {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--color-cyan);
    color: #0d1117;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .pillar-step__title {
    font-size: 1.15rem;
    margin: 0 0 0.4rem;
    color: var(--color-dark);
  }

  .pillar-step__text {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Proof Stack */
  .proof-stack {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }

  .proof-card {
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.14);
    border: 1px solid var(--color-border);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    max-width: 440px;
    width: 100%;
    background: #ffffff;
  }

  .proof-card img {
    display: block;
    width: 100%;
    height: auto;
  }

  .proof-card:hover {
    transform: rotate(0deg) scale(1.02) !important;
    box-shadow: 0 24px 48px rgba(15, 23, 42, 0.22);
    z-index: 10;
  }

  /* ---------- Testimonials ---------- */
  .medspa-testimonials {
    background: var(--color-bg);
  }

  .medspa-testimonials__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 960px) {
    .medspa-testimonials__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .testimonial-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: 2.25rem 2rem;
    display: flex;
