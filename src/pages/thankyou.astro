---
// src/pages/thankyou.astro
import MainLayout from "../layouts/MainLayout.astro";

const steps = [
  {
    step: "01",
    tag: "INSPECTION",
    title: "Footprint Audit & Review",
    desc: "We analyze your existing website speed, local SEO visibility, Google rankings, and competitor presence to prepare meaningful talking points.",
    icon: "/grm-web-icons/number-icon-1.svg",
    accent: "/grm-web-assets/3d-search-window-graphic.svg",
  },
  {
    step: "02",
    tag: "STRATEGY CALL",
    title: "Direct 1-on-1 Consultation",
    desc: "A dedicated Good Rep Media strategist reaches out to align on your revenue targets, ideal customer profile, and specific growth bottlenecks.",
    icon: "/grm-web-icons/number-icon-2.svg",
    accent: "/grm-web-assets/3d-chat-bubbles-graphic.svg",
  },
  {
    step: "03",
    tag: "ACTION PLAN",
    title: "Custom Growth Blueprint",
    desc: "You receive a clear, transparent action plan tailored to your budget and business goals with zero long-term lock-in contracts.",
    icon: "/grm-web-icons/number-icon-3.svg",
    accent: "/grm-web-assets/3d-rocket-graphic.svg",
  },
];

const featuredServices = [
  {
    title: "Website Design & UX",
    desc: "High-converting, mobile-responsive custom websites engineered to turn visitors into phone calls and booked clients.",
    href: "/services/web-design/",
    icon: "/grm-web-icons/website-design-icon-blue.svg",
    graphic: "/grm-main-graphics/website-design-graphic.svg",
    accent: "/grm-web-assets/3d-browser-window-graphic.svg",
    badge: "Web & UX",
  },
  {
    title: "Local SEO & Google Maps",
    desc: "Dominate Google's local 3-pack and capture high-intent customers actively searching in your service area.",
    href: "/services/local-seo/",
    icon: "/grm-web-icons/google-business-icon.svg",
    graphic: "/grm-main-graphics/local-seo-marketing-graphic.svg",
    accent: "/grm-web-assets/3d-map-indicator-icon-graphic.svg",
    badge: "Google Maps",
  },
  {
    title: "Paid Advertising (PPC)",
    desc: "Targeted Google Ads and Meta campaigns tracked down to the exact dollar, phone call, and conversion.",
    href: "/services/pay-per-click-marketing/",
    icon: "/grm-web-icons/paid-search-icon.svg",
    graphic: "/grm-main-graphics/pay-per-click-marketing-graphic.svg",
    accent: "/grm-web-assets/arrow-in-target-graphic.svg",
    badge: "Fast Leads",
  },
  {
    title: "Social Media Marketing",
    desc: "Engaging content, audience growth, and community management that builds local trust and brand loyalty.",
    href: "/services/social-media-marketing/",
    icon: "/grm-web-icons/social-media-icon.svg",
    graphic: "/grm-main-graphics/social-media-marketing-graphic.svg",
    accent: "/grm-web-assets/999-hearts-likes-graphic.svg",
    badge: "Engagement",
  },
];

const highlights = [
  "Response within a few business days from a real strategist",
  "100% in-house Grand Rapids digital marketing team",
  "Zero sales pressure — honest, data-backed growth advice",
];
---

<MainLayout
  title="Thank You | Good Rep Media - Message Received"
  description="Thank you for reaching out to Good Rep Media. Our digital marketing team in Grand Rapids, Michigan has received your message and will be in touch shortly."
  noindex={true}
>
  <!-- Isolated GA4 Lead Conversion Event -->
  <script is:inline>
    window.addEventListener("load", function () {
      if (typeof gtag === "function") {
        gtag("event", "generate_lead", {
          event_category: "engagement",
          event_label: "Contact Form Submission",
        });
      }
    });
  </script>

  <!-- THANK YOU HERO -->
  <section class="thankyou-hero">
    <div class="container thankyou-hero__container">
      <div class="thankyou-hero__content">
        <!-- Breadcrumb navigation -->
        <nav class="thankyou-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/contact/">Contact</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Thank You</span>
        </nav>

        <!-- Status Pill Badge -->
        <div class="thankyou-badge">
          <span
            class="material-symbols-outlined thankyou-badge__icon"
            aria-hidden="true">check_circle</span
          >
          <span class="thankyou-badge__text">Message Received &amp; Logged</span>
        </div>

        <h1 class="thankyou-hero__title">
          Thank You! Your Request is <span class="text-cyan">in Good Hands.</span>
        </h1>

        <p class="thankyou-hero__lead">
          We’ve received your inquiry and our team is already reviewing your
          details. A Good Rep Media strategist will inspect your current online
          footprint and follow up with you within <strong>a few business days</strong>.
        </p>

        <!-- Signature Checklist Card -->
        <div class="thankyou-hero__checklist-card">
          <ul class="thankyou-hero__checklist">
            {
              highlights.map((item) => (
                <li>
                  <span
                    class="material-symbols-outlined"
                    aria-hidden="true"
                  >
                    check_circle
                  </span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Primary Action Buttons: Homepage & Services Page -->
        <div class="thankyou-hero__actions">
          <a href="/" class="btn btn--primary thankyou-btn">
            <span class="material-symbols-outlined" aria-hidden="true">home</span>
            <span>Return to Homepage</span>
          </a>
          <a href="/services/" class="btn btn--outline thankyou-btn">
            <span class="material-symbols-outlined" aria-hidden="true">grid_view</span>
            <span>Explore Our Services</span>
          </a>
        </div>
      </div>

      <!-- Hero Artwork Stage (1 background + 1 centerpiece + 2 opposite-corner accents) -->
      <div class="thankyou-hero__graphic" aria-hidden="true">
        <div class="thankyou-hero__art">
          <img
            class="thankyou-hero__blob"
            src="/grm-web-assets/blue-circular-background-graphic.svg"
            alt=""
            width="746"
            height="780"
            data-no-lightbox
          />
          <img
            class="thankyou-hero__main"
            src="/grm-web-assets/online-support-graphic.svg"
            alt=""
            width="746"
            height="780"
            data-no-lightbox
            fetchpriority="high"
          />
          <img
            class="thankyou-hero__float thankyou-hero__float--tr"
            data-float
            src="/grm-web-assets/happy-face-speech-bubble-graphic.svg"
            alt=""
            width="240"
            height="240"
            data-no-lightbox
          />
          <img
            class="thankyou-hero__float thankyou-hero__float--bl"
            data-float
            src="/grm-web-assets/calendar-graphic.svg"
            alt=""
            width="240"
            height="240"
            data-no-lightbox
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT HAPPENS NEXT (3-STEP ROADMAP WITH ORBITAL MEDALLIONS & 3D GRAPHICS) -->
  <section class="section thankyou-steps">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">CLEAR EXPECTATIONS</span>
        <h2 class="section-title">What Happens Next?</h2>
        <p class="section-lead">
          Here is our straightforward 3-step onboarding workflow while our team
          prepares your preliminary digital footprint audit.
        </p>
      </header>

      <div class="thankyou-steps__grid">
        {
          steps.map((st) => (
            <article class="step-card" data-step-card data-reveal>
              <div class="step-card__top">
                <div class="step-card__medallion" aria-hidden="true">
                  <span class="step-card__orbit" />
                  <div class="step-card__icon-tile">
                    <img
                      class="step-card__icon"
                      data-step-icon
                      src={st.icon}
                      alt=""
                      width="42"
                      height="42"
                      loading="lazy"
                      data-no-lightbox
                    />
                  </div>
                  <img
                    class="step-card__accent"
                    data-step-accent
                    src={st.accent}
                    alt=""
                    width="44"
                    height="44"
                    loading="lazy"
                    data-no-lightbox
                  />
                </div>
                <span class="step-card__tag">{st.tag}</span>
              </div>

              <h3 class="step-card__title">{st.title}</h3>
              <p class="step-card__desc">{st.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FEATURED SERVICES SHOWCASE WITH GRAPHICAL ILLUSTRATIONS -->
  <section class="section thankyou-services">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">EXPLORE OUR CAPABILITIES</span>
        <h2 class="section-title">While You Wait, Explore Our Services</h2>
        <p class="section-lead">
          From custom websites to targeted local lead generation, see how Good
          Rep Media delivers real phone calls and measurable local market share.
        </p>
      </header>

      <div class="thankyou-services__grid">
        {
          featuredServices.map((svc) => (
            <a href={svc.href} class="service-card" data-reveal>
              <div class="service-card__visual" aria-hidden="true">
                <div class="service-card__badge">{svc.badge}</div>
                <img
                  class="service-card__illustration"
                  src={svc.graphic}
                  alt=""
                  width="320"
                  height="220"
                  loading="lazy"
                  data-no-lightbox
                />
                <img
                  class="service-card__float-accent"
                  data-float
                  src={svc.accent}
                  alt=""
                  width="64"
                  height="64"
                  loading="lazy"
                  data-no-lightbox
                />
              </div>

              <div class="service-card__body">
                <div class="service-card__header">
                  <div class="service-card__icon-box" aria-hidden="true">
                    <img
                      src={svc.icon}
                      alt=""
                      width="28"
                      height="28"
                      loading="lazy"
                      data-no-lightbox
                    />
                  </div>
                  <h3 class="service-card__title">{svc.title}</h3>
                </div>

                <p class="service-card__desc">{svc.desc}</p>

                <span class="service-card__link">
                  <span>View Service Details</span>
                  <span class="material-symbols-outlined" aria-hidden="true">
                    arrow_forward
                  </span>
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <div class="thankyou-services__cta" data-reveal>
        <a href="/services/" class="btn btn--primary thankyou-btn">
          <span class="material-symbols-outlined" aria-hidden="true">grid_view</span>
          <span>View All 12 Marketing Services</span>
        </a>
        <a href="/" class="btn btn--outline thankyou-btn">
          <span class="material-symbols-outlined" aria-hidden="true">home</span>
          <span>Back to Homepage</span>
        </a>
      </div>
    </div>
  </section>

  <!-- DIRECT CONTACT / IMMEDIATE ASSISTANCE BANNER -->
  <section class="thankyou-direct">
    <div class="container">
      <div class="thankyou-direct__card" data-reveal>
        <div class="thankyou-direct__content">
          <div class="thankyou-direct__header">
            <img
              class="thankyou-direct__graphic"
              src="/grm-main-graphics/handshake-hands.webp"
              alt=""
              width="96"
              height="96"
              loading="lazy"
              aria-hidden="true"
              data-no-lightbox
            />
            <div>
              <span class="eyebrow thankyou-direct__eyebrow">
                IMMEDIATE ASSISTANCE
              </span>
              <h2 class="thankyou-direct__title">
                Have an Urgent Question or Project?
              </h2>
            </div>
          </div>
          <p class="thankyou-direct__desc">
            If you have an urgent deadline or prefer to speak with our Grand
            Rapids team right now, give us a call or reach out directly.
          </p>
        </div>

        <div class="thankyou-direct__actions">
          <a href="tel:6163009868" class="thankyou-contact-pill">
            <span class="material-symbols-outlined" aria-hidden="true">call</span>
            <span>(616) 300-9868</span>
          </a>
          <a href="mailto:team@goodrep.media" class="thankyou-contact-pill">
            <span class="material-symbols-outlined" aria-hidden="true">mail</span>
            <span>team@goodrep.media</span>
          </a>
          <div class="thankyou-contact-pill thankyou-contact-pill--static">
            <span class="material-symbols-outlined" aria-hidden="true">
              location_on
            </span>
            <span>Grand Rapids, MI</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let thankyouCtx: gsap.Context | null = null;

  function initThankYouPage() {
    const heroEl = document.querySelector(".thankyou-hero");
    if (!heroEl) return;

    if (thankyouCtx) {
      thankyouCtx.revert();
    }

    thankyouCtx = gsap.context(() => {
      const mm = gsap.matchMedia();

      mm.add("(prefers-reduced-motion: no-preference)", () => {
        // Hero text entrance
        gsap.fromTo(
          ".thankyou-hero__content > *",
          { y: 26, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.75,
            stagger: 0.1,
            ease: "power3.out",
            delay: 0.1,
            clearProps: "transform,opacity",
          },
        );

        // Hero artwork entrance
        gsap.fromTo(
          ".thankyou-hero__blob",
          { scale: 0.85, opacity: 0 },
          {
            scale: 1,
            opacity: 1,
            duration: 0.95,
            ease: "power3.out",
            delay: 0.12,
            clearProps: "transform,opacity",
          },
        );

        gsap.fromTo(
          ".thankyou-hero__main",
          { scale: 0.9, opacity: 0 },
          {
            scale: 1,
            opacity: 1,
            duration: 0.9,
            ease: "power3.out",
            delay: 0.22,
            clearProps: "transform,opacity",
          },
        );

        gsap.fromTo(
          ".thankyou-hero__float",
          { scale: 0, opacity: 0 },
          {
            scale: 1,
            opacity: 1,
            duration: 0.7,
            stagger: 0.14,
            ease: "back.out(2)",
            delay: 0.4,
            clearProps: "transform,opacity",
          },
        );

        // Continuous gentle float for accents
        gsap.utils.toArray<HTMLElement>("[data-float]").forEach((el, i) => {
          gsap.to(el, {
            yPercent: -10,
            rotation: i % 2 ? 3 : -3,
            duration: 2.3 + (i % 3) * 0.35,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: (i % 4) * 0.15,
          });
        });

        // Spinning dashed orbits on step medallions
        const orbits = document.querySelectorAll(".step-card__orbit");
        if (orbits.length) {
          gsap.to(orbits, {
            rotation: 360,
            duration: 26,
            repeat: -1,
            ease: "none",
          });
        }

        // Interactive hover micro-animations on step cards
        const stepCards = gsap.utils.toArray<HTMLElement>("[data-step-card]");
        stepCards.forEach((card) => {
          const icon = card.querySelector("[data-step-icon]");
          const accent = card.querySelector("[data-step-accent]");

          card.addEventListener("pointerenter", () => {
            if (icon) {
              gsap.to(icon, {
                scale: 1.14,
                rotation: -6,
                duration: 0.35,
                ease: "back.out(2)",
              });
            }
            if (accent) {
              gsap.to(accent, {
                x: 5,
                y: -5,
                scale: 1.14,
                rotation: 8,
                duration: 0.35,
                ease: "back.out(2)",
              });
            }
          });

          card.addEventListener("pointerleave", () => {
            if (icon) {
              gsap.to(icon, {
                scale: 1,
                rotation: 0,
                duration: 0.5,
                ease: "elastic.out(1, 0.5)",
              });
            }
            if (accent) {
              gsap.to(accent, {
                x: 0,
                y: 0,
                scale: 1,
                rotation: 0,
                duration: 0.5,
                ease: "elastic.out(1, 0.5)",
              });
            }
          });
        });

        // Scroll reveals
        gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
          gsap.fromTo(
            el,
            { y: 32, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 0.75,
              ease: "power3.out",
              clearProps: "transform,opacity",
              scrollTrigger: {
                trigger: el,
                start: "top 86%",
                once: true,
              },
            },
          );
        });
      });
    });

    ScrollTrigger.refresh();
  }

  document.addEventListener("astro:page-load", initThankYouPage);
  document.addEventListener("astro:before-swap", () => {
    if (thankyouCtx) {
      thankyouCtx.revert();
      thankyouCtx = null;
    }
  });
</script>

<style>
  /* ---------- Hero Section ---------- */
  .thankyou-hero {
    background-color: var(--color-bg);
    padding: clamp(2.75rem, 5.5vw, 5rem) 0 clamp(2.75rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .thankyou-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      rgba(27, 196, 217, 0.16) 1.5px,
      transparent 1.5px
    );
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse at 75% 50%, #000 0%, transparent 70%);
    pointer-events: none;
  }

  .thankyou-hero__container {
    display: grid;
    gap: 3.25rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .thankyou-hero__container {
      grid-template-columns: 1.12fr 0.88fr;
    }
  }

  /* Breadcrumb Pill */
  .thankyou-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-muted);
    margin-bottom: 1rem;
    background: var(--color-light);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
  }

  .thankyou-breadcrumb a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .thankyou-breadcrumb a:hover {
    color: var(--color-cyan);
  }

  .thankyou-breadcrumb span[aria-current="page"] {
    color: var(--color-dark);
    font-weight: 600;
  }

  /* Status Pill Badge */
  .thankyou-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.38rem 0.9rem;
    background: var(--color-cyan-soft);
    border: 1px solid rgba(27, 196, 217, 0.32);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-cyan-dark);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1.15rem;
    margin-left: 0.5rem;
  }

  @media (max-width: 560px) {
    .thankyou-badge {
      display: flex;
      width: fit-content;
      margin-left: 0;
    }
  }

  .thankyou-badge__icon {
    font-size: 1.1rem;
    color: var(--color-cyan);
  }

  .thankyou-hero__title {
    font-size: clamp(2.15rem, 4.4vw, 3.35rem);
    font-weight: 700;
    line-height: 1.14;
    letter-spacing: -0.015em;
    margin: 0 0 1.15rem;
    color: var(--color-dark);
  }

  .text-cyan {
    color: var(--color-cyan);
  }

  .thankyou-hero__lead {
    color: var(--color-muted);
    font-size: 1.08rem;
    line-height: 1.75;
    margin: 0 0 1.5rem;
    max-width: 620px;
  }

  .thankyou-hero__lead strong {
    color: var(--color-dark);
  }

  /* Signature Checklist Card */
  .thankyou-hero__checklist-card {
    background: var(--color-light);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-cyan);
    border-radius: 14px;
    padding: 1.15rem 1.4rem;
    margin-bottom: 1.85rem;
    box-shadow: var(--shadow-soft);
    max-width: 580px;
  }

  .thankyou-hero__checklist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.65rem;
  }

  .thankyou-hero__checklist li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.96rem;
    font-weight: 600;
    color: var(--color-dark);
  }

  .thankyou-hero__checklist .material-symbols-outlined {
    color: var(--color-cyan);
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  /* Actions */
  .thankyou-hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .thankyou-btn {
    padding: 0.85rem 1.75rem;
    font-weight: 600;
    gap: 0.6rem;
  }

  .thankyou-btn .material-symbols-outlined {
    font-size: 1.2rem;
  }

  /* Hero Artwork Stage */
  .thankyou-hero__graphic {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .thankyou-hero__art {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1 / 0.94;
  }

  .thankyou-hero__art img {
    position: absolute;
    height: auto !important;
    max-height: none !important;
    object-fit: contain;
    pointer-events: none;
  }

  .thankyou-hero__blob {
    width: 88%;
    left: 6%;
    top: 5%;
    z-index: 0;
  }

  .thankyou-hero__main {
    width: 68%;
    left: 16%;
    top: 12%;
    z-index: 2;
    filter: drop-shadow(0 20px 30px rgba(15, 23, 42, 0.22));
  }

  .thankyou-hero__float {
    z-index: 3;
    filter: drop-shadow(0 14px 22px rgba(15, 23, 42, 0.22));
  }

  .thankyou-hero__float--tr {
    width: 24%;
    right: 4%;
    top: 5%;
  }

  .thankyou-hero__float--bl {
    width: 22%;
    left: 5%;
    bottom: 7%;
  }

  /* ---------- What Happens Next (Orbital Medallion Step Cards) ---------- */
  .thankyou-steps {
    background: var(--color-light);
    border-bottom: 1px solid var(--color-border);
  }

  .thankyou-steps__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 2rem;
  }

  .step-card {
    background: var(--color-bg);
    border-radius: 20px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-top: 4px solid var(--color-cyan);
    padding: 2.15rem 1.85rem;
    box-shadow: var(--shadow-soft);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .step-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lift);
    border-color: var(--color-cyan);
  }

  .step-card__top {
    display: flex;
