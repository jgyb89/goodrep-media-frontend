  <!-- GSAP ANIMATIONS -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const wordEls = gsap.utils.toArray<HTMLElement>("[data-hero-word]");
    const sceneEls = gsap.utils.toArray<HTMLElement>("[data-hero-scene]");
    const mm = gsap.matchMedia();

    // Motion-heavy effects only run when the user hasn't asked for reduced motion
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      // 1. Headline rotator: flips up + fades in, then flips down + fades out,
      //    while crossfading the matching graphic composition on the right.
      if (wordEls.length > 1) {
        const hidden = { yPercent: 60, rotationX: -80, autoAlpha: 0 };
        const shown = { yPercent: 0, rotationX: 0, autoAlpha: 1 };
        const sceneOut = { y: -14, scale: 0.95, autoAlpha: 0 };
        const sceneInStart = { y: 18, scale: 0.94, autoAlpha: 0 };
        const sceneShown = { y: 0, scale: 1, autoAlpha: 1 };

        gsap.set(wordEls, {
          transformPerspective: 650,
          transformOrigin: "50% 100%", // hinge from the baseline
          force3D: true,
        });
        gsap.set(wordEls[0], shown);
        gsap.set(wordEls.slice(1), hidden);

        if (sceneEls.length === wordEls.length) {
          gsap.set(sceneEls[0], sceneShown);
          gsap.set(sceneEls.slice(1), sceneInStart);
        }

        const setActive = (active: number) =>
          wordEls.forEach((el, idx) =>
            el.setAttribute("aria-hidden", String(idx !== active)),
          );

        const flipTl = gsap.timeline({ repeat: -1 });

        wordEls.forEach((current, index) => {
          const nextIndex = (index + 1) % wordEls.length;
          const next = wordEls[nextIndex];
          const currentScene = sceneEls[index];
          const nextScene = sceneEls[nextIndex];

          // Current phrase flips down and fades out...
          flipTl.to(
            current,
            { ...hidden, duration: 0.5, ease: "power2.in" },
            "+=2.2", // hold time
          );

          // ...while the current graphic arrangement fades out
          if (currentScene) {
            flipTl.to(
              currentScene,
              { ...sceneOut, duration: 0.45, ease: "power2.in" },
              "<",
            );
          }

          // ...and the next phrase flips up and fades in
          flipTl.fromTo(
            next,
            hidden,
            {
              ...shown,
              duration: 0.6,
              ease: "power3.out",
              immediateRender: false,
              onStart: () => setActive(nextIndex),
            },
            "<0.25",
          );

          // ...as the matching graphic arrangement fades in
          if (nextScene) {
            flipTl.fromTo(
              nextScene,
              sceneInStart,
              {
                ...sceneShown,
                duration: 0.65,
                ease: "power3.out",
                immediateRender: false,
              },
              "<",
            );
          }
        });
      }

      // 2. Infinite Marquee Animation (pauses on hover)
      const marqueeTween = gsap.to(".marquee__content", {
        xPercent: -100,
        repeat: -1,
        duration: 35,
        ease: "linear",
      });
      const marquee = document.querySelector(".marquee");
      marquee?.addEventListener("mouseenter", () => marqueeTween.pause());
      marquee?.addEventListener("mouseleave", () => marqueeTween.play());

      // 3. Entrance Stagger
      gsap.from(".hero__kicker, .hero__title, .hero__actions, .hero__trust", {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.2,
        ease: "power3.out",
        delay: 0.2,
      });

      gsap.from('[data-hero-scene="0"] .hero-art__main', {
        y: 40,
        opacity: 0,
        duration: 1,
        ease: "power3.out",
        delay: 0.4,
      });
      gsap.from(".hero-art__blob", {
        scale: 0.85,
        opacity: 0,
        duration: 1.2,
        ease: "power3.out",
        delay: 0.2,
      });

      // 4. Gentle floating for decorative illustrations
      gsap.utils.toArray<HTMLElement>("[data-float]").forEach((el, i) => {
        gsap.to(el, {
          y: -14,
          rotation: i % 2 ? 3 : -3,
          duration: 2.4 + (i % 3) * 0.5,
          ease: "sine.inOut",
          yoyo: true,
          repeat: -1,
          delay: (i % 3) * 0.3,
        });
      });

      // 5. Scroll reveals
      gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
        gsap.from(el, {
          y: 40,
          opacity: 0,
          duration: 0.9,
          ease: "power3.out",
          scrollTrigger: { trigger: el, start: "top 85%", once: true },
        });
      });

      gsap.utils
        .toArray<HTMLElement>("[data-reveal-group]")
        .forEach((group) => {
          gsap.from(group.children, {
            y: 40,
            opacity: 0,
            duration: 0.7,
            stagger: 0.1,
            ease: "power3.out",
            scrollTrigger: { trigger: group, start: "top 85%", once: true },
          });
        });

      // 6. Services: Static at rest; smooth movement plays on hover, freezes,
      //    and reverses back to original static position on leave.
      gsap.utils.toArray<HTMLElement>("[data-service-card]").forEach((card) => {
        const mainImg = card.querySelector<HTMLElement>("[data-card-main]");
        const accents = gsap.utils.toArray<HTMLElement>(
          card.querySelectorAll("[data-card-accent]"),
        );
        const blob = card.querySelector<HTMLElement>(".service-card__blob");

        const hoverTl = gsap.timeline({
          paused: true,
          defaults: { duration: 0.45, ease: "power2.out" },
        });

        if (blob) {
          hoverTl.to(
            blob,
            {
              scale: 1.08,
              rotation: 6,
            },
            0,
          );
        }

        if (mainImg) {
          hoverTl.to(
            mainImg,
            {
              y: -6,
              scale: 1.06,
              rotation: -1.5,
            },
            0,
          );
        }

        accents.forEach((acc, i) => {
          const dx = Number(acc.dataset.dx || 8);
          const dy = Number(acc.dataset.dy || -8);
          const rot = Number(acc.dataset.rot || 6);

          hoverTl.to(
            acc,
            {
              x: dx,
              y: dy,
              rotation: rot,
              scale: 1.1,
            },
            i * 0.04,
          );
        });

        card.addEventListener("pointerenter", () => hoverTl.play());
        card.addEventListener("pointerleave", () => hoverTl.reverse());
      });

      // 7. Why Good Rep: Elastic medallion pop-in + continuous orbit ring
      const whyGrid = document.querySelector<HTMLElement>("[data-why-grid]");
      if (whyGrid) {
        const valueCards = gsap.utils.toArray<HTMLElement>("[data-value-card]");
        const icons = whyGrid.querySelectorAll(".value__icon");
        const orbits = whyGrid.querySelectorAll(".value__orbit");

        gsap.to(orbits, {
          rotation: 360,
          duration: 26,
          repeat: -1,
          ease: "none",
        });

        const whyTl = gsap.timeline({
          scrollTrigger: {
            trigger: whyGrid,
            start: "top 82%",
            once: true,
          },
        });

        whyTl
          .from(valueCards, {
            y: 36,
            opacity: 0,
            duration: 0.65,
            stagger: 0.12,
            ease: "power3.out",
          })
          .from(
            icons,
            {
              scale: 0.5,
              rotation: -15,
              duration: 0.75,
              stagger: 0.12,
              ease: "back.out(1.8)",
            },
            "<0.05",
          );

        valueCards.forEach((vc) => {
          const icon = vc.querySelector(".value__main-img");
          vc.addEventListener("pointerenter", () => {
            if (icon) {
              gsap.to(icon, {
                scale: 1.12,
                rotation: -5,
                duration: 0.4,
                ease: "back.out(2)",
              });
            }
          });
          vc.addEventListener("pointerleave", () => {
            if (icon) {
              gsap.to(icon, {
                scale: 1,
                rotation: 0,
                duration: 0.55,
                ease: "elastic.out(1, 0.5)",
              });
            }
          });
        });
      }

      // 8. Our Work: Multi-plane ScrollTrigger scrub depth parallax
      const workSection = document.querySelector<HTMLElement>("#work");
      if (workSection) {
        gsap.utils
          .toArray<HTMLElement>("[data-work-parallax]")
          .forEach((layer) => {
            const deltaY = Number(layer.dataset.workParallax || -30);
            gsap.fromTo(
              layer,
              { y: -deltaY * 0.45 },
              {
                y: deltaY * 0.55,
                ease: "none",
                scrollTrigger: {
                  trigger: workSection,
                  start: "top bottom",
                  end: "bottom top",
                  scrub: 0.6,
                },
              },
            );
          });
      }

      // 9. Spotlight: Scroll-scrubbed satellite graphics + checklist stagger
      gsap.utils.toArray<HTMLElement>(".feature").forEach((featureEl) => {
        const satellites = gsap.utils.toArray<HTMLElement>(
          featureEl.querySelectorAll("[data-spotlight-parallax]"),
        );
        satellites.forEach((sat) => {
          const deltaY = Number(sat.dataset.spotlightParallax || -40);
          gsap.fromTo(
            sat,
            { y: -deltaY * 0.4 },
            {
              y: deltaY * 0.6,
              ease: "none",
              scrollTrigger: {
                trigger: featureEl,
                start: "top bottom",
                end: "bottom top",
                scrub: 0.6,
              },
            },
          );
        });

        const checklistItems = featureEl.querySelectorAll(
          "[data-checklist] li",
        );
        if (checklistItems.length) {
          gsap.from(checklistItems, {
            x: -24,
            opacity: 0,
            duration: 0.55,
            stagger: 0.1,
            ease: "back.out(1.4)",
            scrollTrigger: {
              trigger: featureEl,
              start: "top 78%",
              once: true,
            },
          });
        }
      });

      // 10. Consultation: Multi-layer entrance + wave/card depth
      const consultSection =
        document.querySelector<HTMLElement>("#consultation");
      if (consultSection) {
        const consultMain = consultSection.querySelector(".consult__art-main");
        const consultFloats = consultSection.querySelectorAll(
          ".consult__art-float",
        );

        const consultTl = gsap.timeline({
          scrollTrigger: {
            trigger: consultSection,
            start: "top 80%",
            once: true,
          },
        });

        if (consultMain) {
          consultTl.from(consultMain, {
            y: 30,
            scale: 0.88,
            opacity: 0,
            duration: 0.75,
            ease: "back.out(1.5)",
          });
        }
        if (consultFloats.length) {
          consultTl.from(
            consultFloats,
            {
              scale: 0,
              y: 20,
              opacity: 0,
              duration: 0.6,
              stagger: 0.1,
              ease: "back.out(2.2)",
            },
            "<0.2",
          );
        }
      }
    });

    // 11. Process accordion + interactive stage choreography
    const stage = document.querySelector<HTMLElement>(".process__stage");
    const stepLabel = document.querySelector("#process-step-label");
    const stepTag = document.querySelector("#process-step-tag");
    const progressBar = document.querySelector<HTMLElement>(
      "#process-progress-bar",
    );
    const stageBlob = document.querySelector<HTMLElement>(
      ".process__stage-blob",
    );
    const allDetails = gsap.utils.toArray<HTMLDetailsElement>(".step");
    const allDots = gsap.utils.toArray<HTMLButtonElement>("[data-step-dot]");
    const stepTags = allDetails.map(
      (d) => d.querySelector(".step__tag")?.textContent || "",
    );

    const activateProcessStep = (stepIndex: number) => {
      if (!stage) return;
      const prevStep = Number(stage.dataset.activeStep ?? "0");
      stage.dataset.activeStep = String(stepIndex);

      if (stepLabel) stepLabel.textContent = String(stepIndex + 1);
      if (stepTag && stepTags[stepIndex]) {
        stepTag.textContent = stepTags[stepIndex];
      }

      allDots.forEach((dot, idx) => {
        dot.classList.toggle("is-active", idx === stepIndex);
      });

      const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (progressBar) {
        const ratio = (stepIndex + 1) / Math.max(allDetails.length, 1);
        if (prefersReduced) {
          progressBar.style.transform = `scaleX(${ratio})`;
        } else {
          gsap.to(progressBar, {
            scaleX: ratio,
            duration: 0.55,
            ease: "power3.out",
          });
        }
      }

      if (prefersReduced || prevStep === stepIndex) return;

      const nextVisual = stage.querySelector<HTMLElement>(
        `[data-visual="${stepIndex}"]`,
      );
      if (stageBlob) {
        gsap.to(stageBlob, {
          rotation: stepIndex * 45,
          scale: 1 + (stepIndex % 2) * 0.08,
          duration: 0.8,
          ease: "power2.out",
        });
      }

      if (nextVisual) {
        const mainImg = nextVisual.querySelector(".process__visual-main");
        const floatImgs = nextVisual.querySelectorAll(".process__visual-float");

        if (mainImg) {
          gsap.fromTo(
            mainImg,
            { y: 28, scale: 0.85, opacity: 0 },
            {
              y: 0,
              scale: 1,
              opacity: 1,
              duration: 0.55,
              ease: "back.out(1.5)",
              overwrite: "auto",
            },
          );
        }
        if (floatImgs.length) {
          gsap.fromTo(
            floatImgs,
            { scale: 0.5, opacity: 0 },
            {
              scale: 1,
              opacity: 1,
              duration: 0.5,
              stagger: 0.08,
              ease: "back.out(2.1)",
              delay: 0.1,
              overwrite: "auto",
            },
          );
        }
      }
    };

    allDetails.forEach((details) => {
      details.addEventListener("toggle", () => {
        if (!details.open) return;
        const stepIdx = Number(details.dataset.step ?? "0");
        activateProcessStep(stepIdx);
      });
    });

    allDots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const idx = Number(dot.dataset.stepDot ?? "0");
        const targetDetails = allDetails[idx];
        if (targetDetails) {
          targetDetails.open = true;
        } else {
          activateProcessStep(idx);
        }
      });
    });
  </script>

