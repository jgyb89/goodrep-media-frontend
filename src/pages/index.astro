// ---------- Knowledge Center: latest posts from WordPress ----------
let posts: any[] = [];
try {
  const data = await fetchWP(`
    query GetLatestPosts {
      posts(first: 4) {
        nodes {
          id
          title
          slug
          excerpt
          featuredImage {
            node {
              sourceUrl
              altText
            }
          }
        }
      }
    }
  `);
  posts = (data?.posts?.nodes || []).map((post: any) => ({
    ...post,
    // Strip all tags from the WP excerpt; keeps entities safely encoded
    excerpt: DOMPurify.sanitize(post.excerpt || "", { ALLOWED_TAGS: [] }),
  }));
} catch (error: any) {
  console.warn(
    "Could not fetch posts for homepage knowledge center:",
    error?.message || error,
  );
}
