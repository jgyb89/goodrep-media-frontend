---
import DOMPurify from "isomorphic-dompurify";
import MainLayout from "../layouts/MainLayout.astro";
import LeadForm from "../components/LeadForm.jsx";
import { fetchWP } from "../lib/api.js";

// ---------- Content data (kept here so copy is easy to edit) ----------
const services = [
  {
    title: "Website Design",
    img: "/Asset 17.webp",
    w: 503,
    h: 586,
    text: "Custom, mobile-first websites built to load fast, rank well, and turn visitors into customers.",
  },
  {
    title: "Local SEO",
    img: "/Asset 36.webp",
    w: 678,
    h: 414,
    text: "Show up in the map pack and local searches when nearby customers are looking for you.",
  },
  {
    title: "Technical SEO",
    img: "/Asset 40.webp",
    w: 315,
    h: 215,
    text: "Speed, structure, and on-page fixes that help search engines understand and reward your site.",
  },
  {
    title: "Paid Digital Ads",
    img: "/Asset 45.webp",
    w: 212,
    h: 323,
    text: "Google and social ad campaigns managed for real leads, not just clicks.",
  },
  {
    title: "Social Media Management",
    img: "/Asset 28.webp",
    w: 696,
    h: 411,
    text: "Consistent, on-brand content and community management on the platforms your customers use.",
  },
  {
    title: "Digital Media Production",
    img: "/Asset 54.webp",
    w: 506,
    h: 413,
    text: "Photo, video, and graphics that make your business look as good online as it does in person.",
  },
  {
    title: "Branding",
    art: "brand",
    text: "Logos, colors, and messaging that make your business memorable and instantly recognizable.",
  },
  {
    title: "Marketing Strategy",
    img: "/Asset 37.webp",
    w: 261,
    h: 246,
    text: "A clear, data-backed roadmap that ties every marketing dollar to your business goals.",
  },
];

const values = [
  {
    title: "Hands-On Partnership",
    img: "/Asset 33.webp",
    w: 438,
    h: 152,
    text: "Work directly with real people who learn your business and treat it like their own.",
  },
  {
    title: "Built For Growth",
    img: "/Asset 4.webp",
    w: 291,
    h: 419,
    text: "Every recommendation is tied to more calls, more leads, and more customers through your door.",
  },
  {
    title: "Small Business Specialists",
    img: "/Asset 7.webp",
    w: 656,
    h: 302,
    text: "We focus on small and local businesses, so our strategies fit your budget and your market.",
  },
  {
    title: "Transparent & Affordable",
    img: "/Asset 34.webp",
    w: 152,
    h: 162,
    text: "Clear pricing and honest reporting. You always know what we are doing and why it matters.",
  },
];

const steps = [
  {
    title: "Free Consultations",
    text: "We start with a free 1-on-1 call to learn about your business, your goals, and your current online presence. No pressure, no jargon.",
    main: { src: "/Asset 50.webp", w: 186, h: 108 },
    accent: { src: "/Asset 32.webp", w: 147, h: 133 },
  },
  {
    title: "Setup & Strategy",
    text: "After evaluating the existing online presence, we develop a tailored roadmap and strategy, detailing target demographics and customer acquisition models, ensuring your approval before proceeding.",
    main: { src: "/Asset 43.webp", w: 183, h: 237 },
    accent: { src: "/Asset 37.webp", w: 261, h: 246 },
  },
  {
    title: "Launch & Manage",
    text: "We build, launch, and actively manage your website, campaigns, and content, optimizing along the way so nothing runs on autopilot.",
    main: { src: "/Asset 10.webp", w: 181, h: 180 },
    accent: { src: "/Asset 16.webp", w: 278, h: 45 },
  },
  {
    title: "Results & Reporting",
    text: "Clear, regular reports show what is working, what we are improving, and how your investment is turning into customers.",
    main: { src: "/Asset 4.webp", w: 291, h: 419 },
    accent: { src: "/Asset 42.webp", w: 148, h: 178 },
  },
];

// ---------- Knowledge Center: latest posts from WordPress ----------
let posts: any[] = [];
try {
  const data = await fetchWP(`
    query GetLatestPosts {
      posts(first: 4) {
        nodes {
          id
          title
          slug
          excerpt
          featuredImage {
            node {
              sourceUrl
              altText
            }
          }
        }
      }
    }
  `);
  posts = (data?.posts?.nodes || []).map((post: any) => ({
    ...post,
    // Strip all tags from the WP excerpt; keeps entities safely encoded
    excerpt: DOMPurify.sanitize(post.excerpt || "", { ALLOWED_TAGS: [] }),
  }));
} catch (error: any) {
  console.warn(
    "Could not fetch posts for homepage knowledge center:",
    error?.message || error,
  );
}
const heroWords = [
  "SEO Strategy",
  "More Engagement",
  "A Converting Website",
  "More Customers",
  "Google Ad Management",
];
---

<MainLayout title="Goodrep Media | Small Business Marketing Agency">
  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero__container">
      <div class="hero__content">
        <div class="hero__header">
          <span class="hero__kicker">SMALL BUSINESS MARKETING AGENCY</span>
          <h1 class="hero__title">
            <span class="hero__title-cyan">Your Small Business Needs</span>
            <span class="hero__rotator" id="hero-rotator">
              {
                heroWords.map((word, index) => (
                  <span
                    class="hero__word hero__title-red"
                    data-hero-word
                    aria-hidden={index === 0 ? "false" : "true"}
                  >
                    {word}
                  </span>
                ))
              }
            </span>
          </h1>
        </div>

        <div class="hero__actions">
          <!-- Button 1: Book Call -->
          <a href="#consultation" class="btn btn--primary hero__btn"
            >Book Free 30 Minute Call</a
          >

          <!-- Button 2: Modal Trigger (We will wire this to a dialog next) -->
          <button
            type="button"
            class="btn btn--outline hero__btn"
            id="trigger-contact-modal"
          >
            Send us a message
          </button>
        </div>

        <ul class="hero__trust">
          <li>
            <span class="material-symbols-outlined" aria-hidden="true"
              >check_circle</span
            > Free 1-on-1 strategy call
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true"
              >location_on</span
            > Based in Grand Rapids, MI
          </li>
        </ul>
      </div>

      <!-- Right Side Graphic: isometric composition built from /public assets -->
      <div class="hero__graphic" aria-hidden="true">
        <div class="hero-art">
          <img
            class="hero-art__blob"
            src="/Asset 2.webp"
            alt=""
            width="869"
            height="663"
          />
          <img
            class="hero-art__main"
            src="/Asset 11.webp"
            alt=""
            width="434"
            height="326"
            fetchpriority="high"
          />
          <img
            class="hero-art__float hero-art__float--likes"
            data-float
            src="/Asset 55.webp"
            alt=""
            width="197"
            height="98"
          />
          <img
            class="hero-art__float hero-art__float--mega"
            data-float
            src="/Asset 51.webp"
            alt=""
            width="117"
            height="95"
          />
          <img
            class="hero-art__float hero-art__float--smile"
            data-float
            src="/Asset 9.webp"
            alt=""
            width="137"
            height="162"
          />
        </div>
      </div>
    </div>

    <!-- INFINITE MARQUEE CRAWL -->
    <div class="marquee">
      <div class="marquee__track">
        <!-- List 1 -->
        <div class="marquee__content">
          <div class="marquee__item">
            <span class="material-symbols-outlined">troubleshoot</span> Local/Technical
            SEO
          </div>
          <div class="marquee__item">
            <span class="material-symbols-outlined">web</span> Website Design
          </div>
          <div class="marquee__item">
            <span class="material-symbols-outlined">manage_search</span> Search Engine
            Optimization
          </div>
          <div class="marquee__item">
            <span class="material-symbols-outlined">movie</span> Digital Media Production
          </div>
          <div class="marquee__item">
            <span class="material-symbols-outlined">ads_click</span> Google Ad Management
          </div>
          <div class="marquee__item">
            <span class="material-symbols-outlined">link</span> Link Building Services
          </div>
          <div class="marquee__item">
            <span class="material-symbols-outlined">share</span> Social Media
          </div>
          <div class="marquee__item">
            <span class="material-symbols-outlined">storefront</span> Amazon Marketing
            Services
          </div>
          <div class="marquee__item">
            <span class="material-symbols-outlined">mail</span> Email Marketing
          </div>
        </div>
        <!-- List 2 (Duplicate for seamless loop) -->
        <div class="marquee__content" aria-hidden="true">
          <div class="marquee__item">
            <span class="material-symbols-outlined">troubleshoot</span> Local/Technical
            SEO
          </div>
          <div class="marquee__item">
            <span class="material-symbols-outlined">web</span> Website Design
          </div>
          <div class="marquee__item">
            <span class="material-symbols-outlined">manage_search</span> Search Engine
            Optimization
          </div>
          <div class="marquee__item">
            <span class="material-symbols-outlined">movie</span> Digital Media Production
          </div>
          <div class="marquee__item">
            <span class="material-symbols-outlined">ads_click</span> Google Ad Management
          </div>
          <div class="marquee__item">
            <span class="material-symbols-outlined">link</span> Link Building Services
          </div>
          <div class="marquee__item">
            <span class="material-symbols-outlined">share</span> Social Media
          </div>
          <div class="marquee__item">
            <span class="material-symbols-outlined">storefront</span> Amazon Marketing
            Services
          </div>
          <div class="marquee__item">
            <span class="material-symbols-outlined">mail</span> Email Marketing
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section services" id="services">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">What We Do</span>
        <h2 class="section-title">Everything You Need To Grow Online</h2>
        <p class="section-lead">
          From your first website to a full-funnel marketing engine, we handle
          the digital side so you can focus on running your business.
        </p>
      </header>

      <div class="services__grid" data-reveal-group>
        {
          services.map((s) => (
            <article class="service-card">
              <div class="service-card__stage">
                {s.art === "brand" ? (
                  <div class="brand-art">
                    <img
                      class="brand-art__box"
                      src="/Asset 19.webp"
                      alt=""
                      width="288"
                      height="287"
                      loading="lazy"
                    />
                    <img
                      class="brand-art__heart"
                      src="/Asset 34.webp"
                      alt=""
                      width="152"
                      height="162"
                      loading="lazy"
                    />
                    <img
                      class="brand-art__cursor"
                      src="/Asset 18.webp"
                      alt=""
                      width="62"
                      height="60"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <img
                    class="service-card__img"
                    src={s.img}
                    alt=""
                    width={s.w}
                    height={s.h}
                    loading="lazy"
                  />
                )}
              </div>
              <h3 class="service-card__title">{s.title}</h3>
              <p class="service-card__text">{s.text}</p>
            </article>
          ))
        }
      </div>

      <div class="services__cta" data-reveal>
        <a href="#consultation" class="btn btn--primary"
          >Get A Free Strategy Call</a
        >
      </div>
    </div>
  </section>

  <!-- WHY GOOD REP -->
  <section class="section why">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">Why Good Rep</span>
        <h2 class="section-title">A Marketing Partner That Feels Local</h2>
      </header>

      <div class="why__grid" data-reveal-group>
        {
          values.map((v) => (
            <div class="value">
              <div class="value__icon">
                <img
                  src={v.img}
                  alt=""
                  width={v.w}
                  height={v.h}
                  loading="lazy"
                />
              </div>
              <h3 class="value__title">{v.title}</h3>
              <p class="value__text">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- OUR PROCESS -->
  <section class="section process" id="process">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">Our Process</span>
        <h2 class="section-title">Business Growth Easy &amp; Affordable</h2>
      </header>

      <div class="process__layout">
        <div class="process__list" data-reveal>
          {
            steps.map((step, i) => (
              <details
                class="step"
                name="process-steps"
                open={i === 0}
                data-step={i}
              >
                <summary class="step__summary">
                  <span class="step__num">{i + 1}</span>
                  <span class="step__title">{step.title}</span>
                  <span
                    class="material-symbols-outlined step__chevron"
                    aria-hidden="true"
                  >
                    expand_more
                  </span>
                </summary>
                <p class="step__body">{step.text}</p>
              </details>
            ))
          }
        </div>

        <div
          class="process__stage"
          data-active-step="0"
          aria-hidden="true"
          data-reveal
        >
          <img
            class="process__stage-blob"
            src="/Asset 2.webp"
            alt=""
            width="869"
            height="663"
            loading="lazy"
          />
          {
            steps.map((step, i) => (
              <div class="process__visual" data-visual={i}>
                <img
                  class="process__visual-main"
                  src={step.main.src}
                  alt=""
                  width={step.main.w}
                  height={step.main.h}
                  loading="lazy"
                />
                <img
                  class="process__visual-accent"
                  src={step.accent.src}
                  alt=""
                  width={step.accent.w}
                  height={step.accent.h}
                  loading="lazy"
                />
              </div>
            ))
          }
          <span class="process__stage-label"
            >Step <span id="process-step-label">1</span> of {steps.length}</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- OUR WORK -->
  <section class="work" id="work">
    <div class="work__band">
      <div class="container work__layout">
        <div class="work__art" aria-hidden="true" data-reveal>
          <img
            class="work__art-blob"
            src="/Asset 2.webp"
            alt=""
            width="869"
            height="663"
            loading="lazy"
          />
          <img
            class="work__device work__device--monitor"
            src="/Asset 54.webp"
            alt=""
            width="506"
            height="413"
            loading="lazy"
          />
          <img
            class="work__device work__device--laptop"
            src="/Asset 28.webp"
            alt=""
            width="696"
            height="411"
            loading="lazy"
          />
          <img
            class="work__device work__device--phone"
            data-float
            src="/Asset 53.webp"
            alt=""
            width="188"
            height="342"
            loading="lazy"
          />
        </div>

        <div class="work__content" data-reveal>
          <span class="eyebrow">Our Work</span>
          <h2 class="section-title work__title">Your Success is Our Success</h2>
          <p class="work__text">
            At Good Rep Media, we specialize in helping small businesses thrive
            by crafting custom websites, building powerful brands, and
            delivering smart digital strategies that drive real results. Whether
            it's launching a new company, refreshing an outdated presence, or
            growing an existing audience, we provide hands-on support every step
            of the way, from web design and branding to social media, SEO, and
            content creation.
          </p>
          <a href="#consultation" class="btn btn--primary">Start Your Project</a
          >

          <div class="work__clients">
            <span class="work__clients-label"
              >Trusted by local businesses like</span
            >
            <div class="work__logos">
              <img
                src="/glowing-results-skin-spa-logo-white.webp"
                alt="Glowing Results Skin Spa"
                width="1789"
                height="407"
                loading="lazy"
              />
              <img
                src="/be-balanced-bodyworks-logo-white.svg"
                alt="Be Balanced Bodyworks"
                width="686"
                height="138"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SPOTLIGHT: LOCAL SEO + PAID ADS -->
  <section class="section spotlight">
    <div class="container">
      <div class="feature" data-reveal>
        <div class="feature__media">
          <img
            src="/google-ads-graphic-1200.webp"
            alt="Illustration of a business owner reviewing five-star local search listings"
            width="1200"
            height="1039"
            loading="lazy"
          />
        </div>
        <div class="feature__content">
          <span class="eyebrow">Local SEO</span>
          <h2 class="section-title">Get Found When Nearby Customers Search</h2>
          <p class="section-lead">
            Most customers find local businesses through Google. We make sure
            yours shows up first, looks trustworthy, and makes it easy to call,
            visit, or book.
          </p>
          <ul class="checklist">
            <li>Google Business Profile setup &amp; optimization</li>
            <li>Review generation &amp; reputation management</li>
            <li>Local citations &amp; directory listings</li>
            <li>Location pages built to rank</li>
          </ul>
          <a href="#consultation" class="feature__link"
            >Talk to an SEO expert <span
              class="material-symbols-outlined"
              aria-hidden="true">arrow_forward</span
            ></a
          >
        </div>
      </div>

      <div class="feature feature--reverse" data-reveal>
        <div class="feature__media feature__media--photo">
          <img
            src="/ads-management-services-1400.webp"
            alt="Magnifying glass over a digital advertising dashboard"
            width="1400"
            height="881"
            loading="lazy"
          />
          <img
            class="feature__badge"
            data-float
            src="/Asset 37.webp"
            alt=""
            width="261"
            height="246"
            loading="lazy"
          />
        </div>
        <div class="feature__content">
          <span class="eyebrow">Paid Advertising</span>
          <h2 class="section-title">Ad Campaigns Built Around Your Budget</h2>
          <p class="section-lead">
            We target the right people at the right moment, then track every
            call and form fill so you can see exactly what your ad spend is
            bringing in.
          </p>
          <ul class="checklist">
            <li>Google Search &amp; Local Services Ads</li>
            <li>Facebook &amp; Instagram campaigns</li>
            <li>Conversion &amp; call tracking</li>
            <li>Clear monthly performance reports</li>
          </ul>
          <a href="#consultation" class="feature__link"
            >Plan my ad strategy <span
              class="material-symbols-outlined"
              aria-hidden="true">arrow_forward</span
            ></a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- KNOWLEDGE CENTER (renders only when posts are available) -->
  {
    posts.length > 0 && (
      <section class="section knowledge">
        <div class="container">
          <header class="section-head" data-reveal>
            <span class="eyebrow">Knowledge Center</span>
            <h2 class="section-title">
              Tips &amp; Tricks For Local Businesses To Get More Customers
            </h2>
          </header>

          <div class="knowledge__grid" data-reveal-group>
            {posts.map((post) => (
              <article class="post-card">
                <a
                  class="post-card__media"
                  href={`/blog/${post.slug}`}
                  tabindex="-1"
                  aria-hidden="true"
                >
                  {post.featuredImage?.node?.sourceUrl ? (
                    <img
                      src={post.featuredImage.node.sourceUrl}
                      alt=""
                      loading="lazy"
                      width="600"
                      height="375"
                    />
                  ) : (
                    <img
                      class="post-card__placeholder"
                      src="/Asset 43.webp"
                      alt=""
                      loading="lazy"
                      width="183"
                      height="237"
                    />
                  )}
                </a>
                <div class="post-card__body">
                  <h3 class="post-card__title">
                    <a href={`/blog/${post.slug}`}>{post.title}</a>
                  </h3>
                  <p class="post-card__excerpt" set:html={post.excerpt} />
                  <a
                    class="post-card__more"
                    href={`/blog/${post.slug}`}
                    aria-label={`Read more: ${post.title}`}
                  >
                    Read More{" "}
                    <span class="material-symbols-outlined" aria-hidden="true">
                      chevron_right
                    </span>
                  </a>
                </div>
              </article>
            ))}
          </div>

          <div class="knowledge__cta">
            <a href="/blog" class="btn btn--primary">
              View All Blogs
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- CONSULTATION -->
  <section class="consult" id="consultation">
    <svg
      class="consult__wave"
      viewBox="0 0 1440 120"
      preserveAspectRatio="none"
      aria-hidden="true"
      style={`color: ${posts.length > 0 ? "var(--color-light)" : "var(--color-bg)"}`}
    >
      <path
        d="M0,0 L1440,0 L1440,40 C1180,110 900,120 640,80 C380,40 180,30 0,70 Z"
        fill="currentColor"></path>
    </svg>

    <div class="container consult__layout">
      <div class="consult__intro" data-reveal>
        <div class="consult__art" aria-hidden="true">
          <img
            class="consult__art-main"
            src="/Asset 48.webp"
            alt=""
            width="612"
            height="330"
            loading="lazy"
          />
          <img
            class="consult__art-float"
            data-float
            src="/Asset 50.webp"
            alt=""
            width="186"
            height="108"
            loading="lazy"
          />
        </div>
        <p class="consult__kicker">Need some help online?</p>
        <h2 class="consult__title">
          Book A FREE 1-on-1 Digital Marketing Consultation
        </h2>
        <p class="consult__text">
          Get actionable advice for how to grow your business from our digital
          marketing experts!
        </p>
        <ul class="consult__contact">
          <li>
            <span class="material-symbols-outlined" aria-hidden="true"
              >call</span
            >
            <a href="tel:+16163009868">(616) 300-9868</a>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true"
              >mail</span
            >
            <a href="mailto:team@goodrep.media">team@goodrep.media</a>
          </li>
        </ul>
      </div>

      <div class="consult__card" data-reveal>
        <h3 class="consult__card-title">Book Your Free Consultation</h3>
        <LeadForm client:visible submitLabel="Book Your Free Call" />
      </div>
    </div>
  </section>

  <!-- MODAL: Gravity Form -->
  <dialog class="contact-modal" id="contact-modal">
    <div class="contact-modal__inner">
      <button
        class="contact-modal__close"
        id="close-contact-modal"
        aria-label="Close modal"
      >
        <span class="material-symbols-outlined">close</span>
      </button>
      <h3 class="contact-modal__title">Send Us A Message</h3>
      <LeadForm client:visible />
    </div>
  </dialog>

  <!-- GSAP ANIMATIONS -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const wordEls = gsap.utils.toArray<HTMLElement>("[data-hero-word]");
    const mm = gsap.matchMedia();

    // Motion-heavy effects only run when the user hasn't asked for reduced motion
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      // 1. Headline rotator: flips up + fades in, then flips down + fades out
      if (wordEls.length > 1) {
        const hidden = { yPercent: 60, rotationX: -80, autoAlpha: 0 };
        const shown = { yPercent: 0, rotationX: 0, autoAlpha: 1 };

        gsap.set(wordEls, {
          transformPerspective: 650,
          transformOrigin: "50% 100%", // hinge from the baseline
          force3D: true,
        });
        gsap.set(wordEls[0], shown);
        gsap.set(wordEls.slice(1), hidden);

        const setActive = (active: number) =>
          wordEls.forEach((el, idx) =>
            el.setAttribute("aria-hidden", String(idx !== active)),
          );

        const flipTl = gsap.timeline({ repeat: -1 });

        wordEls.forEach((current, index) => {
          const nextIndex = (index + 1) % wordEls.length;
          const next = wordEls[nextIndex];

          // Current phrase flips down and fades out...
          flipTl.to(
            current,
            { ...hidden, duration: 0.5, ease: "power2.in" },
            "+=2.2", // hold time
          );

          // ...while the next phrase flips up and fades in
          flipTl.fromTo(
            next,
            hidden,
            {
              ...shown,
              duration: 0.6,
              ease: "power3.out",
              immediateRender: false,
              onStart: () => setActive(nextIndex),
            },
            "<0.25",
          );
        });
      }

      // 2. Infinite Marquee Animation (pauses on hover)
      const marqueeTween = gsap.to(".marquee__content", {
        xPercent: -100,
        repeat: -1,
        duration: 35,
        ease: "linear",
      });
      const marquee = document.querySelector(".marquee");
      marquee?.addEventListener("mouseenter", () => marqueeTween.pause());
      marquee?.addEventListener("mouseleave", () => marqueeTween.play());

      // 3. Entrance Stagger
      gsap.from(".hero__kicker, .hero__title, .hero__actions, .hero__trust", {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.2,
        ease: "power3.out",
        delay: 0.2,
      });

      gsap.from(".hero-art__main", {
        y: 40,
        opacity: 0,
        duration: 1,
        ease: "power3.out",
        delay: 0.4,
      });
      gsap.from(".hero-art__blob", {
        scale: 0.85,
        opacity: 0,
        duration: 1.2,
        ease: "power3.out",
        delay: 0.2,
      });

      // 4. Gentle floating for decorative illustrations
      gsap.utils.toArray<HTMLElement>("[data-float]").forEach((el, i) => {
        gsap.to(el, {
          y: -14,
          rotation: i % 2 ? 3 : -3,
          duration: 2.4 + (i % 3) * 0.5,
          ease: "sine.inOut",
          yoyo: true,
          repeat: -1,
          delay: i * 0.3,
        });
      });

      // 5. Scroll reveals
      gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
        gsap.from(el, {
          y: 40,
          opacity: 0,
          duration: 0.9,
          ease: "power3.out",
          scrollTrigger: { trigger: el, start: "top 85%", once: true },
        });
      });

      gsap.utils
        .toArray<HTMLElement>("[data-reveal-group]")
        .forEach((group) => {
          gsap.from(group.children, {
            y: 40,
            opacity: 0,
            duration: 0.7,
            stagger: 0.1,
            ease: "power3.out",
            scrollTrigger: { trigger: group, start: "top 85%", once: true },
          });
        });
    });

    // 6. Process accordion: swap the illustration to match the open step
    const stage = document.querySelector<HTMLElement>(".process__stage");
    const stepLabel = document.querySelector("#process-step-label");
    document
      .querySelectorAll<HTMLDetailsElement>(".step")
      .forEach((details) => {
        details.addEventListener("toggle", () => {
          if (!details.open || !stage) return;
          const step = details.dataset.step ?? "0";
          stage.dataset.activeStep = step;
          if (stepLabel) stepLabel.textContent = String(Number(step) + 1);
        });
      });

    // 7. Modal Logic (Native HTML Dialog)
    const modal = document.querySelector("#contact-modal") as HTMLDialogElement;
    const openBtn = document.querySelector("#trigger-contact-modal");
    const closeBtn = document.querySelector("#close-contact-modal");

    openBtn?.addEventListener("click", () => modal?.showModal());
    closeBtn?.addEventListener("click", () => modal?.close());

    // Close modal when clicking outside
    modal?.addEventListener("click", (e) => {
      const dialogDimensions = modal.getBoundingClientRect();
      if (
        e.clientX < dialogDimensions.left ||
        e.clientX > dialogDimensions.right ||
        e.clientY < dialogDimensions.top ||
        e.clientY > dialogDimensions.bottom
      ) {
        modal.close();
      }
    });
  </script>

