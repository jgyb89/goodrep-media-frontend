---

<MainLayout
  title="Our Work & Portfolio | Goodrep Media - Case Studies"
  description="Explore real case studies and website projects from Good Rep Media. Discover how we help small and local businesses win more leads and customers online."
>
  <!-- WORK HERO -->
  <section class="work-hero">
    <div class="container work-hero__container">
      <div class="work-hero__content">
        <span class="work-hero__kicker">OUR PORTFOLIO &amp; PROVEN RESULTS</span>
        <h1 class="work-hero__title">
          Real Results For <span class="text-cyan">Real Small Businesses</span>
        </h1>
        <p class="work-hero__lead">
          We don't build generic cookie-cutter templates. Every website, local search campaign, and ad strategy is engineered to get phones ringing and customers walking through your doors.
        </p>
        <div class="work-hero__actions">
          <a href="#consultation" class="btn btn--primary">Start Your Project</a>
          <a href="#case-studies" class="btn btn--outline">View Case Studies</a>
        </div>
      </div>

      <div class="work-hero__graphic" aria-hidden="true">
        <div class="work-hero__art">
          <img
            class="work-hero__blob"
            data-hero-depth="14"
            src="/grm-web-assets/blue-circular-background-graphic.svg"
            alt=""
            width="746"
            height="780"
          />
          <img
            class="work-hero__main"
            data-hero-depth="-20"
            src="/grm-main-graphics/laptop-web-design-layout-graphic.svg"
            alt="Good Rep Media Web Design & Development Showcase"
            width="746"
            height="780"
            style="width: 66%; left: 17%; top: 12%;"
            data-no-lightbox
            fetchpriority="high"
          />
          <img
            class="work-hero__float work-hero__float--tl"
            data-hero-depth="-34"
            data-float
            src="/grm-web-assets/award-trophy-graphic.svg"
            alt=""
            width="746"
            height="780"
            style="width: 20%; left: 4%; top: 6%;"
            loading="lazy"
          />
          <img
            class="work-hero__float work-hero__float--br"
            data-hero-depth="-38"
            data-float
            src="/grm-web-assets/award-badge-graphic-02.svg"
            alt=""
            width="746"
            height="780"
            style="width: 20%; right: 4%; bottom: 6%;"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- STATS RIBBON (matching case-stats style) -->
  <section class="stats-bar" aria-label="Performance metrics">
    <div class="container">
      <div class="stats-bar__grid">
        {stats.map((stat) => (
          <div class="stat-card">
            <div class="stat-card__number">
              {stat.prefix && (
                <span class="stat-card__affix">{stat.prefix}</span>
              )}
              <span
                class="stat-card__value"
                data-stat-counter={stat.value}
                data-stat-decimals={stat.decimals ?? 0}
              >
                {stat.value}
              </span>
              {stat.suffix && (
                <span class="stat-card__affix">{stat.suffix}</span>
              )}
            </div>
            <div class="stat-card__meter" aria-hidden="true">
              <div
                class="stat-card__meter-fill"
                data-stat-bar={(stat.barPercent ?? 85) / 100}
              />
            </div>
            <p class="stat-card__label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CASE STUDIES SHOWCASE -->
  <section class="section case-studies" id="case-studies">
    <div class="container">
      <header class="section-head text-center" data-reveal>
        <span class="eyebrow">Featured Projects</span>
        <h2 class="section-title">Case Studies &amp; Proven Growth</h2>
        <p class="section-lead">
          A glimpse into how we transform small business websites into high-performing customer acquisition engines.
        </p>
      </header>

      <!-- Project Cards Grid -->
      <div class="work-grid" data-reveal>
        {projects.map((project, idx) => (
          <div
            class="project-card"
            data-project-card
            data-project-index={idx}
            tabindex="0"
            role="button"
            aria-haspopup="dialog"
            aria-label={`View ${project.title} case study details`}
          >
            <!-- Peek Card Behind (slides out ~5% on hover with arrow & sideways text) -->
            <div class="project-card__peek" aria-hidden="true">
              <div class="project-card__peek-strip">
                <span class="material-symbols-outlined project-card__peek-arrow">arrow_forward</span>
                <span class="project-card__peek-text">See more details</span>
              </div>
            </div>

            <!-- Front Visual Card -->
            <div class="project-card__front">
              <div class="window-graphic">
                <div class="window-graphic__dots" aria-hidden="true">
                  <span />
                  <span />
                  <span />
                  <span class="window-graphic__url">{project.title}</span>
                </div>
                <div class="window-graphic__body">
                  {project.logo && (
                    <div class:list={["window-graphic__brand", project.logoClass]}>
                      <img
                        src={project.logo}
                        alt={project.title}
                        loading="lazy"
                      />
                    </div>
                  )}
                  <img
                    class="window-graphic__img"
                    src={project.img}
                    alt={`${project.title} showcase`}
                    width={project.w || 800}
                    height={project.h || 1050}
                    loading="lazy"
                  />
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- PROJECT DETAIL MODAL DIALOG -->
    <dialog
      id="project-detail-modal"
      class="project-modal"
      aria-label="Project Case Study Details"
      aria-modal="true"
    >
      <div class="project-modal__backdrop" id="project-modal-backdrop" aria-hidden="true"></div>

      <div class="project-modal__wrapper">
        <button
          type="button"
          class="project-modal__close"
          id="project-modal-close"
          aria-label="Close project details (Escape)"
        >
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>

        <div class="project-modal__stage">
          {projects.map((project, idx) => (
            <div
              class="project-modal__panel"
              data-modal-panel={idx}
              style="display: none;"
            >
              <div class="project-modal__card">
                <!-- Shared Window Bar Header Graphic across both columns -->
                <div class="window-graphic__dots project-modal__window-bar" aria-hidden="true">
                  <span />
                  <span />
                  <span />
                  <span class="window-graphic__url">{project.title}</span>
                </div>

                <!-- Combined Modal Body -->
                <div class="project-modal__body">
                  <!-- Left: Project Image (flex 1 on desktop) -->
                  <div class="project-modal__image-col">
                    <div class="project-modal__image-wrap">
                      {project.logo && (
                        <div class:list={["window-graphic__brand", "project-modal__brand", project.logoClass]}>
                          <img
                            src={project.logo}
                            alt={project.title}
                            loading="lazy"
                          />
                        </div>
                      )}
                      <img
                        class="project-modal__img"
                        src={project.img}
                        alt={`${project.title} showcase`}
                        width={project.w || 800}
                        height={project.h || 1050}
                      />
                    </div>
                  </div>

                  <!-- Mobile Header Banner (visible only on <= 859px) -->
                  <div class="project-modal__mobile-header">
                    <div class="project-modal__mobile-header-bg">
                      <img src={project.img} alt="" aria-hidden="true" />
                      <div class="project-modal__mobile-header-overlay" aria-hidden="true"></div>
                    </div>
                    <div class="project-modal__mobile-header-content">
                      {project.logo ? (
                        <img
                          src={project.logo}
                          alt={project.title}
                          class:list={[
                            "project-modal__mobile-logo",
                            project.logoClass ? "project-modal__mobile-logo--cclc" : ""
                          ]}
                        />
                      ) : (
                        <span class="project-modal__mobile-title-fallback">{project.title}</span>
                      )}
                    </div>
                  </div>

                  <!-- Right: Stats Card (flex 3 on desktop) -->
                  <div class="project-modal__stats-col">
                    <div class="project-modal__stats-body">
                      <div class="case-card__meta">
                        <span class="case-card__tag">{project.tag}</span>
                        <span class="case-card__sep" aria-hidden="true">&bull;</span>
                        <span class="case-card__category">{project.category}</span>
                      </div>

                      <h3 class="case-card__title">
                        {project.href ? (
                          <a href={project.href}>{project.title}</a>
                        ) : (
                          project.title
                        )}
                      </h3>
                      <p class="case-card__summary">{project.summary}</p>

                      <hr class="project-modal__divider" aria-hidden="true" />

                      <div class="case-card__columns">
                        <!-- Left: Stats stacked in a column with Google icons -->
                        <div class="case-card__stats">
                          <div class="case-card__stats-list">
                            {project.metrics.map((m) => (
                              <div class="case-card__stat-item">
                                {m.icon && (
                                  <span
                                    class="case-card__stat-icon material-symbols-outlined"
                                    aria-hidden="true"
                                  >
                                    {m.icon}
                                  </span>
                                )}
                                <div class="case-card__stat-text">
                                  <span class="case-card__stat-num">{m.num}</span>
                                  <span class="case-card__stat-desc">{m.desc}</span>
                                </div>
                              </div>
                            ))}
                          </div>
                        </div>

                        <!-- Right: Delivered list -->
                        <div class="case-card__deliverables">
                          <ul class="case-card__deliv-list">
                            {project.deliverables.map((d) => (
                              <li>{d}</li>
                            ))}
                          </ul>
                        </div>
                      </div>

                      {project.href ? (
                        <div class="case-card__action">
                          <a href={project.href} class="btn btn--primary case-card__btn">
                            <span>View Case Study</span>
                            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                          </a>
                        </div>
                      ) : (
                        <div class="case-card__action">
                          <a href="#consultation" class="btn btn--primary case-card__btn">
                            <span>Start Your Project</span>
                            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                          </a>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </dialog>
  </section>

  <!-- WORK ETHOS / BANNER -->
  <section class="work-ethos">
    <div class="container work-ethos__container" data-reveal>
      <div class="work-ethos__box">
        <h2 class="work-ethos__title">Have a Project in Mind?</h2>
        <p class="work-ethos__lead">
          Whether you need a fresh website design, local SEO dominance, or lead-generating digital ad campaigns, our team is ready to help you grow.
        </p>
        <div class="work-ethos__actions">
          <a href="#consultation" class="btn btn--primary">Book Free 30-Min Strategy Call</a>
          <a href="/services" class="btn btn--outline-light">Explore Our Services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CONSULTATION BANNER -->
  <section class="consult" id="consultation">
    <div class="container consult__layout">
      <div class="consult__intro" data-reveal>
        <p class="consult__kicker">Start your project today</p>
        <h2 class="consult__title">Let's Discuss Your Business Growth</h2>
        <p class="consult__text">
          Tell us about your company and marketing goals. We'll outline what works best in your local market and provide a clear, flat-rate pricing plan.
        </p>
        <ul class="consult__contact">
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">call</span>
            <a href="tel:+16163009868">(616) 300-9868</a>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">mail</span>
            <a href="mailto:team@goodrep.media">team@goodrep.media</a>
          </li>
        </ul>
      </div>

      <div class="consult__card" data-reveal>
        <h3 class="consult__card-title">Book Your Free Consultation</h3>
        <LeadForm client:visible submitLabel="Start My Project" />
      </div>
    </div>
  </section>

  <!-- GSAP ANIMATIONS -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.from(".work-hero__content > *", {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.15,
        ease: "power3.out",
        delay: 0.2,
      });

      gsap.from(".work-hero__blob", {
        scale: 0.85,
        opacity: 0,
        duration: 1.1,
        ease: "power3.out",
        delay: 0.2,
      });

      gsap.from(".work-hero__main", {
        scale: 0.9,
        opacity: 0,
        duration: 1,
        ease: "power3.out",
        delay: 0.3,
        clearProps: "transform,opacity",
      });

      gsap.from(".work-hero__float", {
        scale: 0.75,
        opacity: 0,
        duration: 0.9,
        stagger: 0.15,
        ease: "back.out(1.5)",
        delay: 0.45,
        clearProps: "transform,opacity",
      });

      // 2.5D Pointer Parallax on Hero Graphic (matching /services/digital-media-production)
      const workHero = document.querySelector<HTMLElement>(".work-hero");
      const heroDepthLayers = gsap.utils.toArray<HTMLElement>(
        "[data-hero-depth]",
        workHero,
      );
      if (workHero && heroDepthLayers.length) {
        workHero.addEventListener("pointermove", (e) => {
          const rect = workHero.getBoundingClientRect();
          const nx = (e.clientX - rect.left) / rect.width - 0.5;
          const ny = (e.clientY - rect.top) / rect.height - 0.5;
          heroDepthLayers.forEach((layer) => {
            const depth = Number(layer.dataset.heroDepth || 20);
            gsap.to(layer, {
              x: nx * depth,
              y: ny * depth,
              duration: 0.6,
              ease: "power2.out",
              overwrite: "auto",
            });
          });
        });
        workHero.addEventListener("pointerleave", () => {
          heroDepthLayers.forEach((layer) => {
            gsap.to(layer, {
              x: 0,
              y: 0,
              duration: 0.8,
              ease: "power3.out",
              overwrite: "auto",
            });
          });
        });
      }

      gsap.utils.toArray<HTMLElement>("[data-float]").forEach((el, i) => {
        gsap.to(el, {
          y: -12,
          rotation: i % 2 ? 3 : -3,
          duration: 2.4 + (i % 3) * 0.45,
          ease: "sine.inOut",
          yoyo: true,
          repeat: -1,
          delay: (i % 4) * 0.25,
        });
      });

      // Stats Bar Cards Entrance, Number Counter & Meter Animations (matching case-stats)
      const statsBarGrid = document.querySelector(".stats-bar__grid");
      if (statsBarGrid) {
        gsap.fromTo(
          statsBarGrid.querySelectorAll(".stat-card"),
          { y: 34, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.7,
            stagger: 0.12,
            ease: "power3.out",
            clearProps: "all",
            scrollTrigger: {
              trigger: statsBarGrid,
              start: "top 85%",
              once: true,
            },
          }
        );

        // Counter number animations
        gsap.utils
          .toArray<HTMLElement>("[data-stat-counter]", statsBarGrid)
          .forEach((counterEl) => {
            const targetVal = Number(counterEl.dataset.statCounter || "0");
            const decimals = Number(counterEl.dataset.statDecimals || "0");
            const counterObj = { val: 0 };

            gsap.to(counterObj, {
              val: targetVal,
              duration: 1.6,
              ease: "power2.out",
              onUpdate: () => {
                counterEl.textContent = counterObj.val.toFixed(decimals);
              },
              scrollTrigger: {
                trigger: statsBarGrid,
                start: "top 85%",
                once: true,
              },
            });
          });

        // Meter fill animations
        gsap.utils
          .toArray<HTMLElement>("[data-stat-bar]", statsBarGrid)
          .forEach((barEl) => {
            const scaleTarget = Number(barEl.dataset.statBar || "1");
            gsap.fromTo(
              barEl,
              { scaleX: 0 },
              {
                scaleX: scaleTarget,
                duration: 1.4,
                ease: "power3.out",
                scrollTrigger: {
                  trigger: statsBarGrid,
                  start: "top 85%",
                  once: true,
                },
              }
            );
          });
      }

      gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
        gsap.from(el, {
          y: 40,
          opacity: 0,
          duration: 0.8,
          ease: "power3.out",
          scrollTrigger: {
            trigger: el,
            start: "top 85%",
            once: true,
          },
        });
      });
    });

    // Project Detail Modal Controller
    function initProjectModal() {
      const modal = document.querySelector<HTMLDialogElement>('#project-detail-modal');
      const backdrop = document.querySelector<HTMLElement>('#project-modal-backdrop');
      const closeBtn = document.querySelector<HTMLButtonElement>('#project-modal-close');
      const cards = document.querySelectorAll<HTMLElement>('[data-project-card]');
      const panels = document.querySelectorAll<HTMLElement>('[data-modal-panel]');

      if (!modal || !cards.length || !panels.length) return;

      let activeTrigger: HTMLElement | null = null;

      function openModal(idx: number, triggerEl?: HTMLElement) {
        if (triggerEl) activeTrigger = triggerEl;

        panels.forEach((panel) => {
          panel.style.display = 'none';
          panel.classList.remove('is-active');
        });

        const activePanel = document.querySelector<HTMLElement>(`[data-modal-panel="${idx}"]`);
        if (activePanel) {
          activePanel.style.display = '';
          void activePanel.offsetWidth; // Force reflow for CSS keyframe animation restart
          activePanel.classList.add('is-active');
        }

        if (typeof modal.showModal === 'function') {
          if (!modal.open) {
            modal.showModal();
          }
        } else {
          modal.setAttribute('open', '');
        }

        document.body.style.overflow = 'hidden';
        closeBtn?.focus();
      }

      function closeModal() {
        if (typeof modal.close === 'function') {
          if (modal.open) {
            modal.close();
          }
        } else {
          modal.removeAttribute('open');
        }

        document.body.style.overflow = '';

        panels.forEach((panel) => {
          panel.classList.remove('is-active');
        });

        if (activeTrigger && typeof activeTrigger.focus === 'function') {
          activeTrigger.focus();
        }
        activeTrigger = null;
      }

      cards.forEach((card) => {
        const idx = Number(card.dataset.projectIndex || '0');

        card.addEventListener('click', (e) => {
          e.preventDefault();
          openModal(idx, card);
        });

        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openModal(idx, card);
          }
        });
      });

      closeBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        closeModal();
      });

      backdrop?.addEventListener('click', () => {
        closeModal();
      });

      modal.addEventListener('click', (e) => {
        if (e.target === modal || (e.target as HTMLElement).classList.contains('project-modal__wrapper')) {
          closeModal();
        }
      });

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && (modal.open || modal.hasAttribute('open'))) {
          e.preventDefault();
          closeModal();
        }
      });

      modal.addEventListener('cancel', (e) => {
        e.preventDefault();
        closeModal();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProjectModal);
    } else {
      initProjectModal();
    }
  </script>

