---

<MainLayout
  title="Our Work & Portfolio | Goodrep Media - Case Studies"
  description="Explore real case studies and website projects from Good Rep Media. Discover how we help small and local businesses win more leads and customers online."
>
  <!-- WORK HERO -->
  <section class="work-hero">
    <div class="container work-hero__container">
      <div class="work-hero__content">
        <span class="work-hero__kicker">OUR PORTFOLIO &amp; PROVEN RESULTS</span>
        <h1 class="work-hero__title">
          Real Results For <span class="text-cyan">Real Small Businesses</span>
        </h1>
        <p class="work-hero__lead">
          We don't build generic cookie-cutter templates. Every website, local search campaign, and ad strategy is engineered to get phones ringing and customers walking through your doors.
        </p>
        <div class="work-hero__actions">
          <a href="#consultation" class="btn btn--primary">Start Your Project</a>
          <a href="#case-studies" class="btn btn--outline">View Case Studies</a>
        </div>
      </div>

      <div class="work-hero__graphic" aria-hidden="true">
        <div class="work-hero__art">
          <img
            class="work-hero__blob"
            src="/grm-web-assets/blue-circular-background-graphic.svg"
            alt=""
            width="746"
            height="780"
          />
          <img
            class="work-hero__main"
            src="/grm-web-assets/mac-computer-monitor-cyan-screen-background-graphic.svg"
            alt="Good Rep Media Portfolio Showcase"
            width="687"
            height="663"
            fetchpriority="high"
          />
          <img
            class="work-hero__badge work-hero__badge--web"
            data-float
            src="/grm-web-assets/website-graphic.svg"
            alt=""
            width="280"
            height="280"
          />
          <img
            class="work-hero__badge work-hero__badge--arrows"
            data-float
            src="/grm-web-assets/3-arrows-up-graphic.svg"
            alt=""
            width="291"
            height="419"
          />
          <img
            class="work-hero__badge work-hero__badge--gauge"
            data-float
            src="/grm-web-assets/77-percent-bubble-graphic.svg"
            alt=""
            width="148"
            height="178"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- STATS RIBBON -->
  <section class="stats-bar">
    <div class="container stats-bar__container">
      {stats.map((st) => (
        <div class="stat-item">
          <span class="stat-item__value">{st.value}</span>
          <span class="stat-item__label">{st.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- CASE STUDIES SHOWCASE -->
  <section class="section case-studies" id="case-studies">
    <div class="container">
      <header class="section-head text-center" data-reveal>
        <span class="eyebrow">Featured Projects</span>
        <h2 class="section-title">Case Studies &amp; Proven Growth</h2>
        <p class="section-lead">
          A glimpse into how we transform small business websites into high-performing customer acquisition engines.
        </p>
      </header>

      <div class="case-studies__list">
        {projects.map((project, idx) => (
          <article
            class:list={[
              "case-card",
              { "case-card--reverse": idx % 2 === 1 },
            ]}
            data-reveal
          >
            <div class="case-card__visual">
              <div class="window-graphic">
                <div class="window-graphic__dots" aria-hidden="true">
                  <span />
                  <span />
                  <span />
                  <span class="window-graphic__url">{project.title}</span>
                </div>
                <div class="window-graphic__body" aria-hidden="true">
                  {project.logo && (
                    <div class="window-graphic__brand">
                      <img
                        src={project.logo}
                        alt={project.title}
                        loading="lazy"
                      />
                    </div>
                  )}
                  <img
                    class="window-graphic__blob"
                    src={project.blob}
                    alt=""
                    width="746"
                    height="780"
                    loading="lazy"
                  />
                  <img
                    class="window-graphic__main"
                    src={project.main.src}
                    alt={`${project.title} showcase`}
                    style={project.main.style}
                    width="687"
                    height="663"
                    loading="lazy"
                  />
                  {project.accents.map((acc) => (
                    <img
                      class="window-graphic__accent"
                      data-float
                      src={acc.src}
                      alt=""
                      style={acc.style}
                      width="240"
                      height="240"
                      loading="lazy"
                    />
                  ))}
                </div>
              </div>
            </div>

            <div class="case-card__content">
              <div class="case-card__meta">
                <span class="case-card__tag">{project.tag}</span>
                <span class="case-card__category">{project.category}</span>
              </div>

              <h3 class="case-card__title">{project.title}</h3>
              <p class="case-card__summary">{project.summary}</p>

              <div class="case-card__metrics">
                {project.metrics.map((m) => (
                  <div class="metric-pill">
                    <span class="metric-pill__num">{m.num}</span>
                    <span class="metric-pill__desc">{m.desc}</span>
                  </div>
                ))}
              </div>

              <div class="case-card__deliverables">
                <span class="case-card__deliv-heading">Delivered:</span>
                <ul class="case-card__deliv-list">
                  {project.deliverables.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WORK ETHOS / BANNER -->
  <section class="work-ethos">
    <div class="container work-ethos__container" data-reveal>
      <div class="work-ethos__box">
        <h2 class="work-ethos__title">Have a Project in Mind?</h2>
        <p class="work-ethos__lead">
          Whether you need a fresh website design, local SEO dominance, or lead-generating digital ad campaigns, our team is ready to help you grow.
        </p>
        <div class="work-ethos__actions">
          <a href="#consultation" class="btn btn--primary">Book Free 30-Min Strategy Call</a>
          <a href="/services" class="btn btn--outline-light">Explore Our Services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CONSULTATION BANNER -->
  <section class="consult" id="consultation">
    <div class="container consult__layout">
      <div class="consult__intro" data-reveal>
        <p class="consult__kicker">Start your project today</p>
        <h2 class="consult__title">Let's Discuss Your Business Growth</h2>
        <p class="consult__text">
          Tell us about your company and marketing goals. We'll outline what works best in your local market and provide a clear, flat-rate pricing plan.
        </p>
        <ul class="consult__contact">
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">call</span>
            <a href="tel:+16163009868">(616) 300-9868</a>
          </li>
          <li>
            <span class="material-symbols-outlined" aria-hidden="true">mail</span>
            <a href="mailto:team@goodrep.media">team@goodrep.media</a>
          </li>
        </ul>
      </div>

      <div class="consult__card" data-reveal>
        <h3 class="consult__card-title">Book Your Free Consultation</h3>
        <LeadForm client:visible submitLabel="Start My Project" />
      </div>
    </div>
  </section>

  <!-- GSAP ANIMATIONS -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.from(".work-hero__content > *", {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.15,
        ease: "power3.out",
        delay: 0.2,
      });

      gsap.from(".work-hero__blob", {
        scale: 0.85,
        opacity: 0,
        duration: 1.1,
        ease: "power3.out",
        delay: 0.2,
      });

      gsap.from(".work-hero__main", {
        scale: 0.9,
        opacity: 0,
        duration: 1,
        ease: "power3.out",
        delay: 0.3,
      });

      gsap.from(".work-hero__badge", {
        scale: 0,
        opacity: 0,
        duration: 0.8,
        stagger: 0.14,
        ease: "back.out(2)",
        delay: 0.5,
      });

      gsap.utils.toArray<HTMLElement>("[data-float]").forEach((el, i) => {
        gsap.to(el, {
          y: -12,
          rotation: i % 2 ? 3 : -3,
          duration: 2.4 + (i % 3) * 0.45,
          ease: "sine.inOut",
          yoyo: true,
          repeat: -1,
          delay: (i % 4) * 0.25,
        });
      });

      gsap.fromTo(
        ".stat-item",
        { y: 20, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.6,
          stagger: 0.1,
          ease: "power3.out",
          clearProps: "all",
          scrollTrigger: {
            trigger: ".stats-bar",
            start: "top 88%",
            once: true,
          },
        }
      );

      gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
        gsap.from(el, {
          y: 40,
          opacity: 0,
          duration: 0.8,
          ease: "power3.out",
          scrollTrigger: {
            trigger: el,
            start: "top 85%",
            once: true,
          },
        });
      });
    });
  </script>

  <style>
    /* ---------- Hero ---------- */
    .work-hero {
      background-color: var(--color-bg);
      padding: clamp(3rem, 6vw, 5rem) 0 clamp(2rem, 4vw, 4rem);
      border-bottom: 1px solid var(--color-border);
      position: relative;
      overflow: hidden;
    }

    .work-hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(
        rgba(27, 196, 217, 0.18) 1.5px,
        transparent 1.5px
      );
      background-size: 28px 28px;
      mask-image: radial-gradient(ellipse at 80% 50%, #000 0%, transparent 70%);
      pointer-events: none;
    }

    .work-hero__container {
      display: grid;
      gap: 3rem;
      align-items: center;
    }

    @media (min-width: 960px) {
      .work-hero__container {
        grid-template-columns: 6fr 5fr;
      }
    }

    .work-hero__kicker {
      display: block;
      color: #64748b;
      font-weight: 600;
      font-size: 0.85rem;
      letter-spacing: 1.5px;
      margin-bottom: 0.75rem;
    }

    .work-hero__title {
      font-size: clamp(2.2rem, 4.5vw, 3.2rem);
      font-weight: 700;
      line-height: 1.18;
      letter-spacing: -0.01em;
      margin: 0 0 1.25rem;
    }

    .text-cyan {
      color: var(--color-cyan);
    }

    .work-hero__lead {
      color: var(--color-muted);
      font-size: 1.1rem;
      line-height: 1.7;
      margin: 0 0 2rem;
    }

    .work-hero__actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .work-hero__graphic {
      display: flex;
      justify-content: center;
    }

    .work-hero__art {
      position: relative;
      width: 100%;
      max-width: 500px;
      aspect-ratio: 1 / 0.92;
    }

    .work-hero__art img {
      position: absolute;
      height: auto;
      object-fit: contain;
      pointer-events: none;
    }

    .work-hero__blob {
      width: 88%;
      left: 6%;
      top: 4%;
      z-index: 0;
    }

    .work-hero__line {
      width: 78%;
      left: 11%;
      top: 10%;
      z-index: 1;
      opacity: 0.7;
    }

    .work-hero__main {
      width: 60%;
      left: 20%;
      top: 14%;
      z-index: 2;
      filter: drop-shadow(0 22px 28px rgba(15, 23, 42, 0.22));
    }

    .work-hero__badge {
      z-index: 3;
      filter: drop-shadow(0 14px 20px rgba(15, 23, 42, 0.25));
    }

    .work-hero__badge--web {
      width: 28%;
      left: 36%;
      top: 20%;
    }

    .work-hero__badge--gauge {
      width: 22%;
      left: 4%;
      bottom: 6%;
    }

    .work-hero__badge--likes {
      width: 26%;
      right: 4%;
      bottom: 6%;
    }

    .work-hero__badge--arrows {
      width: 24%;
      right: 3%;
      top: 4%;
    }

    /* ---------- Stats Bar ---------- */
    .stats-bar {
      background: var(--color-dark);
      color: var(--color-light);
      padding: 2.25rem 0;
      border-bottom: 4px solid var(--color-cyan);
    }

    .stats-bar__container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 2rem;
      text-align: center;
    }

    .stat-item__value {
      display: block;
      font-family: var(--font-heading);
      font-size: clamp(2rem, 3.5vw, 2.75rem);
      font-weight: 700;
      color: var(--color-cyan);
      line-height: 1;
      margin-bottom: 0.5rem;
    }

    .stat-item__label {
      display: block;
      font-size: 0.9rem;
      color: #94a3b8;
      font-weight: 600;
    }

    /* ---------- Case Studies ---------- */
    .case-studies {
      background: var(--color-light);
    }

    .case-studies__list {
      display: grid;
      gap: clamp(4rem, 8vw, 6.5rem);
      margin-top: 3.5rem;
    }

    .case-card {
      display: grid;
      gap: 3rem;
      align-items: center;
    }

    @media (min-width: 960px) {
      .case-card {
        grid-template-columns: 5fr 6fr;
        gap: 4.5rem;
      }
      .case-card--reverse {
        grid-template-columns: 6fr 5fr;
      }
      .case-card--reverse .case-card__visual {
        order: 2;
      }
    }

    .case-card__visual {
      display: flex;
      justify-content: center;
    }

    .window-graphic {
      width: 100%;
      max-width: 480px;
      background: #1e293b;
      border-radius: 20px;
      overflow: hidden;
      border: 1px solid rgba(15, 23, 42, 0.14);
      box-shadow: var(--shadow-lift);
      transition:
        transform 0.35s ease,
        box-shadow 0.35s ease;
    }

    .window-graphic:hover {
      transform: translateY(-4px);
    }

    .window-graphic__dots {
      padding: 0.8rem 1.15rem;
      display: flex;
      align-items: center;
      gap: 0.45rem;
      background: #0f172a;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .window-graphic__dots span:not(.window-graphic__url) {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.25);
    }

    .window-graphic__dots span:nth-child(1) {
      background: #ef4444;
    }

    .window-graphic__dots span:nth-child(2) {
      background: #f59e0b;
    }

    .window-graphic__dots span:nth-child(3) {
      background: #10b981;
    }

    .window-graphic__url {
      margin-left: 0.5rem;
      font-size: 0.75rem;
      font-weight: 600;
      color: #94a3b8;
      background: rgba(255, 255, 255, 0.06);
      padding: 0.2rem 0.75rem;
      border-radius: 999px;
      letter-spacing: 0.02em;
    }

    .window-graphic__body {
      position: relative;
      aspect-ratio: 1 / 0.92;
      overflow: hidden;
      background:
        radial-gradient(
          circle at 50% 54%,
          rgba(27, 196, 217, 0.25),
          transparent 68%
        ),
        url("/grm-web-assets/grm-our-work-bg-1.webp") center / cover no-repeat,
        #18181b;
    }

    .window-graphic__body > img {
      position: absolute;
      height: auto;
      object-fit: contain;
      pointer-events: none;
    }

    .window-graphic__brand {
      position: absolute;
      top: 0.85rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 4;
      background: rgba(15, 23, 42, 0.72);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.14);
