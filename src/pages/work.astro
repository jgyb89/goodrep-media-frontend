        style: "width: 24%; right: 6%; top: 8%;",
      },
      {
        src: "/grm-web-assets/search-bar-graphic.svg",
        style: "width: 26%; left: 6%; bottom: 8%;",
      },
    ],
    deliverables: ["Headless Web Application", "Custom API Development", "Technical SEO", "UI/UX Design"],
  },
  {
    title: "Pink Slushy Media",
    category: "Web Design & Conversion Funnel",
