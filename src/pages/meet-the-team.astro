---
import MainLayout from "../layouts/MainLayout.astro";
import ReadyBand from "../components/ReadyBand.astro";
import ConsultSection from "../components/ConsultSection.astro";
import {
  teamPageMeta,
  teamHeroData,
  teamMembers,
  teamPlaceholderSrc,
  teamReadyData,
  teamConsultData,
} from "../data/teamData.js";

const teamSchema = {
  "@type": "AboutPage",
  "@id": "https://goodrep.media/meet-the-team/#webpage",
  url: "https://goodrep.media/meet-the-team/",
  name: teamPageMeta.title,
  description: teamPageMeta.description,
  mainEntity: {
    "@id": "https://goodrep.media/#organization",
    employee: teamMembers.map((member) => ({
      "@type": "Person",
      name: member.name,
      jobTitle: member.title,
      description: member.description,
      ...(member.image
        ? { image: `https://goodrep.media${encodeURI(member.image)}` }
        : {}),
      worksFor: {
        "@id": "https://goodrep.media/#organization",
      },
    })),
  },
};
---

<MainLayout
  title={teamPageMeta.title}
  description={teamPageMeta.description}
  pageSchema={teamSchema}
>
  <!-- HERO SECTION -->
  <section class="team-hero">
    <div class="container team-hero__container">
      <div class="team-hero__content" data-reveal>
        <nav class="team-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/about/">About</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Meet the Team</span>
        </nav>

        <span class="team-hero__kicker">{teamHeroData.kicker}</span>
        <h1 class="team-hero__title">
          {teamHeroData.titleTop}{" "}
          <span class="text-cyan">{teamHeroData.titleHighlight}</span>
        </h1>
        <p class="team-hero__lead">{teamHeroData.lead}</p>

        <div class="team-hero__checklist-card">
          <ul class="team-hero__checklist">
            {
              teamHeroData.highlights.map((item) => (
                <li>
                  <span
                    class="material-symbols-outlined"
                    aria-hidden="true"
                  >
                    check_circle
                  </span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="team-hero__actions">
          <a href={teamHeroData.primaryCta.href} class="btn btn--primary">
            {teamHeroData.primaryCta.label}
          </a>
          <a href={teamHeroData.secondaryCta.href} class="btn btn--outline">
            {teamHeroData.secondaryCta.label}
          </a>
        </div>
      </div>

      <div class="team-hero__graphic" aria-hidden="true" data-reveal>
        <div class="team-hero__art">
          <img
            class="team-hero__blob"
            src={teamHeroData.stage.blob.src}
            alt=""
            width={teamHeroData.stage.blob.width}
            height={teamHeroData.stage.blob.height}
          />
          <img
            class="team-hero__main"
            src={teamHeroData.stage.main.src}
            alt={teamHeroData.stage.main.alt}
            width={teamHeroData.stage.main.width}
            height={teamHeroData.stage.main.height}
            style={teamHeroData.stage.main.style}
            fetchpriority="high"
          />
          {
            teamHeroData.stage.floats.map((f) => (
              <img
                class="team-hero__badge"
                data-float
                src={f.src}
                alt=""
                width={f.width}
                height={f.height}
                style={f.style}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- TEAM DIRECTORY GRID -->
  <section class="section team-directory" id="team-grid">
    <div class="container">
      <header class="section-head" data-reveal>
        <span class="eyebrow">Our In-House Experts</span>
        <h2 class="section-title">Meet the People Driving Your Results</h2>
        <p class="section-lead team-directory__lead">
          Every project at Good Rep Media is crafted by seasoned marketers,
          designers, writers, and developers who care deeply about helping small
          businesses succeed.
        </p>
      </header>

      <div class="team-grid">
        {
          teamMembers.map((member, index) => {
            const hasPhoto = Boolean(member.image);
            const imgSrc = member.image ?? teamPlaceholderSrc;
            return (
              <article
                class:list={[
                  "team-card",
                  !hasPhoto && "team-card--placeholder",
                ]}
                id={member.id}
                data-team-card
                data-no-lightbox
              >
                <div class="team-card__avatar-stage">
                  <span class="team-card__orbit" aria-hidden="true" />

                  <div
                    class:list={[
                      "team-card__avatar-mask",
                      !hasPhoto && "team-card__avatar-mask--placeholder",
                    ]}
                  >
                    <img
                      class:list={[
                        "team-card__avatar-img",
                        !hasPhoto && "team-card__avatar-img--placeholder",
                      ]}
                      src={imgSrc}
                      alt={
                        hasPhoto
                          ? `${member.name} — ${member.title} at Good Rep Media`
                          : `${member.name} (${member.title}) profile placeholder`
                      }
                      width={member.width}
                      height={member.height}
                      style={`object-position: ${member.objectPosition || "center center"};`}
                      loading={index < 4 ? "eager" : "lazy"}
                      decoding="async"
                      data-no-lightbox
                    />
                    {!hasPhoto && (
                      <span
                        class="team-card__placeholder-initials"
                        aria-hidden="true"
                      >
                        {member.initials}
                      </span>
                    )}
                    <span
                      class="team-card__mask-ring"
                      aria-hidden="true"
                    />
                  </div>

                  <span class="team-card__role-badge" aria-hidden="true">
                    <span class="material-symbols-outlined">
                      {member.icon}
                    </span>
                  </span>
                </div>

                <div class="team-card__body">
                  <h3 class="team-card__name">{member.name}</h3>
                  <p class="team-card__title">{member.title}</p>
                  <p class="team-card__desc">{member.description}</p>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- READY BREAKOUT BAND -->
  <ReadyBand {...teamReadyData} />

  <!-- CONSULTATION FUNNEL -->
  <ConsultSection {...teamConsultData} />

  <!-- GSAP ANIMATIONS -->
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    let teamCtx: gsap.Context | null = null;

    function initTeamPage() {
      const heroEl = document.querySelector(".team-hero");
      if (!heroEl) return;

      if (teamCtx) {
        teamCtx.revert();
      }

      teamCtx = gsap.context(() => {
        const mm = gsap.matchMedia();

        mm.add("(prefers-reduced-motion: no-preference)", () => {
          gsap.fromTo(
            ".team-hero__content > *",
            { y: 26, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 0.75,
              stagger: 0.12,
              ease: "power3.out",
              delay: 0.15,
              clearProps: "transform,opacity",
            },
          );

          gsap.fromTo(
            ".team-hero__blob",
            { scale: 0.85, opacity: 0 },
            {
              scale: 1,
              opacity: 1,
              duration: 1.0,
              ease: "power3.out",
              delay: 0.15,
              clearProps: "transform,opacity",
            },
          );

          gsap.fromTo(
            ".team-hero__main",
            { scale: 0.9, opacity: 0 },
            {
              scale: 1,
              opacity: 1,
              duration: 0.95,
              ease: "power3.out",
              delay: 0.25,
              clearProps: "transform,opacity",
            },
          );

          gsap.fromTo(
            ".team-hero__badge",
            { scale: 0, opacity: 0 },
            {
              scale: 1,
              opacity: 1,
              duration: 0.7,
              stagger: 0.12,
              ease: "back.out(2)",
              delay: 0.45,
              clearProps: "transform,opacity",
            },
          );

          gsap.utils
            .toArray<HTMLElement>(".team-hero [data-float]")
            .forEach((el, i) => {
              gsap.to(el, {
                yPercent: -10,
                rotation: i % 2 ? 3 : -3,
                duration: 2.2 + (i % 3) * 0.4,
                ease: "sine.inOut",
                yoyo: true,
                repeat: -1,
                delay: (i % 4) * 0.15,
              });
            });

          const cards = gsap.utils.toArray<HTMLElement>("[data-team-card]");
          if (cards.length) {
            gsap.fromTo(
              cards,
              { y: 36, opacity: 0 },
              {
                y: 0,
                opacity: 1,
                duration: 0.7,
                stagger: 0.08,
                ease: "power3.out",
                clearProps: "transform,opacity",
                scrollTrigger: {
                  trigger: ".team-grid",
                  start: "top 85%",
                  once: true,
                },
              },
            );
          }
        });
      });

      ScrollTrigger.refresh();
    }

    document.addEventListener("astro:page-load", initTeamPage);
    document.addEventListener("astro:before-swap", () => {
      if (teamCtx) {
        teamCtx.revert();
        teamCtx = null;
      }
    });
  </script>

  <style>
    /* ---------- Hero ---------- */
    .team-hero {
      background-color: var(--color-bg);
      padding: clamp(2.75rem, 5.5vw, 4.75rem) 0 clamp(2.5rem, 4.5vw, 4rem);
      border-bottom: 1px solid var(--color-border);
      position: relative;
      overflow: hidden;
    }

    .team-hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(
        rgba(27, 196, 217, 0.18) 1.5px,
        transparent 1.5px
      );
      background-size: 28px 28px;
      mask-image: radial-gradient(
        ellipse at 80% 50%,
        #000 0%,
        transparent 70%
      );
      pointer-events: none;
    }

    .team-hero__container {
      display: grid;
      gap: 3rem;
      align-items: center;
      position: relative;
      z-index: 1;
    }

    @media (min-width: 960px) {
      .team-hero__container {
        grid-template-columns: 6fr 5fr;
      }
    }

    .team-breadcrumb {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.9rem;
      border-radius: 999px;
      background: var(--color-light);
      border: 1px solid var(--color-border);
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--color-muted);
      margin-bottom: 1rem;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    }

    .team-breadcrumb a {
      color: var(--color-dark);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .team-breadcrumb a:hover {
      color: var(--color-cyan-dark);
    }

    .team-breadcrumb [aria-current="page"] {
      color: var(--color-cyan-dark);
      font-weight: 700;
    }

    .team-hero__kicker {
      display: block;
      color: #64748b;
      font-weight: 700;
      font-size: 0.85rem;
      letter-spacing: 1.5px;
      margin-bottom: 0.65rem;
    }

    .team-hero__title {
      font-size: clamp(2.1rem, 4.2vw, 3.1rem);
      font-weight: 700;
      line-height: 1.16;
      letter-spacing: -0.01em;
      margin: 0 0 1.15rem;
      text-wrap: balance;
    }

    .text-cyan {
      color: var(--color-cyan);
    }

    .team-hero__lead {
      color: var(--color-muted);
      font-size: 1.08rem;
      line-height: 1.7;
      margin: 0 0 1.5rem;
      text-wrap: pretty;
    }

    .team-hero__checklist-card {
      background: var(--color-light);
      border: 1px solid var(--color-border);
      border-left: 4px solid var(--color-cyan);
      border-radius: 14px;
      padding: 1.15rem 1.35rem;
      margin-bottom: 1.75rem;
      box-shadow: 0 8px 24px -12px rgba(15, 23, 42, 0.12);
    }

    .team-hero__checklist {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.6rem;
    }

    .team-hero__checklist li {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--color-dark);
    }

    .team-hero__checklist .material-symbols-outlined {
      color: var(--color-cyan);
      font-size: 1.25rem;
      flex-shrink: 0;
    }

    .team-hero__actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .team-hero__actions .btn {
      padding: 0.8rem 1.5rem;
    }

    .team-hero__graphic {
      display: flex;
      justify-content: center;
    }

    .team-hero__art {
      position: relative;
      width: 100%;
      max-width: 500px;
      aspect-ratio: 1 / 0.92;
      pointer-events: none;
    }

    .team-hero__art img {
      position: absolute;
      height: auto !important;
      max-height: none !important;
      object-fit: contain;
      pointer-events: none;
    }

    .team-hero__blob {
      width: 88%;
      left: 6%;
      top: 4%;
      z-index: 0;
    }

    .team-hero__main {
      width: 62%;
      left: 19%;
      top: 14%;
      z-index: 2;
      filter: drop-shadow(0 22px 28px rgba(15, 23, 42, 0.22));
    }

    .team-hero__badge {
      max-width: 28% !important;
      z-index: 3;
      filter: drop-shadow(0 14px 20px rgba(15, 23, 42, 0.25));
    }

    /* ---------- Team Directory Grid ---------- */
    .team-directory {
      background: var(--color-light);
    }

    .team-directory__lead {
      text-wrap: pretty;
    }

    .team-grid {
      display: grid;
      gap: 2rem;
      grid-template-columns: 1fr;
    }

    @media (min-width: 640px) {
      .team-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 1024px) {
      .team-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (min-width: 1280px) {
      .team-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .team-card {
      position: relative;
      background: var(--color-light);
      border-radius: 20px;
      border: 1px solid var(--color-border);
      border-top: 4px solid var(--color-cyan);
      padding: 2.25rem 1.65rem 2rem;
      box-shadow: var(--shadow-card);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        border-color 0.3s ease;
      overflow: hidden;
    }

    @supports (overflow-clip-margin: 16px) {
      .team-card {
        overflow: clip;
        overflow-clip-margin: 16px;
      }
    }

    .team-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lift);
      border-top-color: var(--color-primary);
    }

    /* ---------- Circular Mask Overlay Stage ---------- */
    .team-card__avatar-stage {
      position: relative;
      width: 184px;
      height: 184px;
      display: grid;
      place-items: center;
      margin: 0 auto 1.4rem;
      flex-shrink: 0;
    }

    .team-card__orbit {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 1.5px dashed rgba(27, 196, 217, 0.45);
      pointer-events: none;
      animation: teamOrbitSpin 28s linear infinite;
    }

    .team-card:hover .team-card__orbit {
      border-color: var(--color-primary);
      animation-duration: 14s;
    }

    @keyframes teamOrbitSpin {
      from {
        transform: rotate(0deg);
      }
      to {
        transform: rotate(360deg);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .team-card__orbit {
        animation: none;
      }
    }

    /* Circular Mask Overlay Container */
    .team-card__avatar-mask {
      position: relative;
      width: 164px;
      height: 164px;
      aspect-ratio: 1 / 1;
      border-radius: 50%;
      clip-path: circle(50% at 50% 50%);
      -webkit-mask-image: radial-gradient(
        circle,
        #000000 100%,
        transparent 100%
      );
      mask-image: radial-gradient(circle, #000000 100%, transparent 100%);
      background:
        radial-gradient(
          circle at 30% 25%,
          #ffffff 0%,
          var(--color-cyan-soft) 65%,
          #dbeafe 100%
        );
      overflow: hidden;
      box-shadow: 0 14px 28px -10px rgba(15, 23, 42, 0.25);
      isolation: isolate;
    }

    @supports (overflow-clip-margin: content-box) {
      .team-card__avatar-mask {
        overflow: clip;
        overflow-clip-margin: content-box;
      }
    }

    .team-card__avatar-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .team-card:hover .team-card__avatar-img {
      transform: scale(1.06);
    }

    .team-card__avatar-img--placeholder {
      opacity: 0.92;
    }

    .team-card__placeholder-initials {
      position: absolute;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(15, 23, 42, 0.78);
      backdrop-filter: blur(4px);
      color: var(--color-light);
      font-family: var(--font-heading);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      padding: 0.2rem 0.65rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.28);
      z-index: 2;
      pointer-events: none;
    }

    /* Circular Overlay Ring & Inner Vignette */
    .team-card__mask-ring {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      box-shadow:
        inset 0 0 0 4px #ffffff,
        inset 0 0 0 5.5px rgba(27, 196, 217, 0.38),
        inset 0 -16px 24px rgba(15, 23, 42, 0.12);
      pointer-events: none;
      z-index: 3;
      transition: box-shadow 0.3s ease;
    }

    .team-card:hover .team-card__mask-ring {
      box-shadow:
        inset 0 0 0 4px #ffffff,
        inset 0 0 0 6px rgba(233, 79, 55, 0.55),
        inset 0 -16px 24px rgba(15, 23, 42, 0.16);
    }

    .team-card__role-badge {
      position: absolute;
      right: 4px;
      bottom: 4px;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--color-cyan);
      color: var(--color-light);
      border: 3px solid var(--color-light);
      display: grid;
      place-items: center;
      box-shadow: 0 6px 14px rgba(15, 23, 42, 0.18);
      z-index: 4;
      transition:
        background-color 0.3s ease,
        transform 0.3s ease;
    }

    .team-card:hover .team-card__role-badge {
      background: var(--color-primary);
      transform: scale(1.08);
    }

    .team-card__role-badge .material-symbols-outlined {
      font-size: 1.15rem;
      line-height: 1;
    }

    /* ---------- Card Typography ---------- */
    .team-card__body {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex: 1;
    }

    .team-card__name {
      font-size: 1.28rem;
      font-weight: 700;
      color: var(--color-dark);
      margin: 0 0 0.4rem;
      text-wrap: balance;
    }

    .team-card__title {
      display: inline-block;
      font-family: var(--font-heading);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      color: var(--color-cyan-dark);
      background: var(--color-cyan-soft);
      padding: 0.28rem 0.85rem;
      border-radius: 999px;
      margin: 0 0 1rem;
      text-wrap: balance;
    }

    .team-card__desc {
      color: var(--color-muted);
      font-size: 0.95rem;
      line-height: 1.68;
      margin: 0;
      text-wrap: pretty;
    }
  </style>
</MainLayout>
