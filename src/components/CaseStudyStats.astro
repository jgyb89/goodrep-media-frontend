---
// src/components/CaseStudyStats.astro
// Reusable case study stats band forwarding to the unified StatsBand component (DRY)
import StatsBand from "./StatsBand.astro";

interface StatItem {
  prefix?: string;
  value: number;
  decimals?: number;
  suffix?: string;
  barPercent?: number;
  label: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
  stats: StatItem[];
}

const {
  eyebrow = "OUR METRICS",
  title,
  sub = "",
  stats = [],
} = Astro.props;
---

<StatsBand eyebrow={eyebrow} title={title} sub={sub} stats={stats} />
