---
interface Props {
  term: string;
  definition: string;
}
const { term, definition } = Astro.props;
---
<section class="service-definition section" aria-label={`What is ${term}?`}>
  <div class="container">
    <div class="service-definition__inner" style="max-width: 800px; margin: 0 auto; padding: 2rem; background: var(--color-cyan-soft); border-left: 4px solid var(--color-cyan); border-radius: 8px;">
      <h2 style="font-size: 1.5rem; margin-top: 0;">What is {term}?</h2>
      <p style="font-size: 1.1rem; line-height: 1.6; color: var(--color-darker); margin-bottom: 0;">
        {definition}
      </p>
    </div>
  </div>
</section>
