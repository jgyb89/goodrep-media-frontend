---
// src/components/PillarsSection.astro
import { Image } from "astro:assets";

interface PillarItem {
  num: string;
  tag: string;
  icon: string;
  title: string;
  body: string;
}

interface Satellite {
  src: string;
  alt?: string;
  width: number;
  height: number;
  parallax?: number;
  className?: string;
}

interface MediaPill {
  icon: string;
  iconBg?: string;
  title: string;
  subtitle: string;
  parallax?: number;
}

interface MediaStage {
  blob?: { src: string; width: number; height: number };
  main: { src: string; alt: string; width: number; height: number };
  satellites?: Satellite[];
  pill?: MediaPill;
}

interface Props {
  eyebrow?: string;
  title: string;
  question?: string;
  body: string;
  pillars: PillarItem[];
  media: MediaStage;
}

const {
  eyebrow = "THE PILLARS",
  title,
  question,
  body,
  pillars = [],
  media,
} = Astro.props;
---

<section
  class="section starts-section pillars-section"
  style="background: var(--color-bg);"
>
  <div class="container">
    <div class="starts-feature pillars-feature" data-reveal>
      <div class="starts-feature__content">
        <span class="eyebrow">{eyebrow}</span>
        <h2 class="section-title starts-feature__title">{title}</h2>

        {question && <p class="starts-feature__question">{question}</p>}
        {body && <p class="starts-feature__body" set:html={body} />}

        <div class="pillars-stack">
          {
            pillars.map((pillar) => (
              <article class="pillar-row-card" data-pillar-card>
                <div class="pillar-row-card__left">
                  <span class="pillar-row-card__num">{pillar.num}</span>
                  <div class="pillar-row-card__icon-box">
                    <img
                      src={pillar.icon}
                      alt=""
                      width="34"
                      height="34"
                      loading="lazy"
                    />
                  </div>
                </div>
                <div class="pillar-row-card__content">
                  <div class="pillar-row-card__header">
                    <h3 class="pillar-row-card__title">{pillar.title}</h3>
                    <span class="pillar-row-card__tag">{pillar.tag}</span>
                  </div>
                  <p class="pillar-row-card__body">{pillar.body}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="starts-feature__media" aria-hidden="true">
        {media.blob && (
          <img
            class="starts-feature__blob"
            data-spotlight-parallax="24"
            src={media.blob.src}
            alt=""
            width={media.blob.width}
            height={media.blob.height}
            loading="lazy"
          />
        )}
        <Image
          class="starts-feature__main"
          data-spotlight-parallax="-18"
          src={media.main.src}
          alt={media.main.alt}
          width={media.main.width}
          height={media.main.height}
          loading="lazy"
          decoding="async"
        />
        {media.satellites?.map((sat) => (
          <img
            class:list={["starts-feature__sat", sat.className]}
            data-spotlight-parallax={sat.parallax ?? -36}
            data-float
            src={sat.src}
            alt={sat.alt ?? ""}
            width={sat.width}
            height={sat.height}
            loading="lazy"
          />
        ))}
        {media.pill && (
          <div
            class="starts-feature__pill"
            data-spotlight-parallax={media.pill.parallax ?? -30}
          >
            <span
              class="starts-feature__pill-icon"
              style={media.pill.iconBg ? `background: ${media.pill.iconBg};` : undefined}
            >
              <span class="material-symbols-outlined" aria-hidden="true">
                {media.pill.icon}
              </span>
            </span>
            <div>
              <strong>{media.pill.title}</strong>
              <span>{media.pill.subtitle}</span>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const pillarsSections = document.querySelectorAll<HTMLElement>(".pillars-section");
  pillarsSections.forEach((root) => {
    const mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const featureEl = root.querySelector(".pillars-feature");
      if (featureEl) {
        gsap.fromTo(
          featureEl,
          { y: 38, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.85,
            ease: "power3.out",
            clearProps: "all",
            scrollTrigger: {
              trigger: featureEl,
              start: "top 85%",
              once: true,
            },
          },
        );

        // Satellites scrub parallax
        gsap.utils
          .toArray<HTMLElement>("[data-spotlight-parallax]", root)
          .forEach((sat) => {
            const deltaY = Number(sat.dataset.spotlightParallax || -36);
            gsap.fromTo(
              sat,
              { y: -deltaY * 0.4 },
              {
                y: deltaY * 0.6,
                ease: "none",
                scrollTrigger: {
                  trigger: featureEl,
                  start: "top bottom",
                  end: "bottom top",
                  scrub: 0.6,
                },
              },
            );
          });
      }

      // Continuous float
      root.querySelectorAll<HTMLElement>("[data-float]").forEach((el, i) => {
        gsap.to(el, {
          y: -12,
          rotation: i % 2 ? 3 : -3,
          duration: 2.4 + (i % 3) * 0.5,
          ease: "sine.inOut",
          yoyo: true,
          repeat: -1,
          delay: (i % 3) * 0.3,
        });
      });
    });
  });
</script>

<style>
  /* ---------- Pillars Section & Stack ---------- */
  .pillars-section {
    overflow: hidden;
  }

  .pillars-feature {
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .pillars-feature {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
  }

  .starts-feature__media {
    position: relative;
    aspect-ratio: 1 / 0.86;
    max-width: 560px;
    width: 100%;
    justify-self: center;
  }

  .starts-feature__media img {
    position: absolute;
    height: auto;
    will-change: transform;
    pointer-events: none;
  }

  .starts-feature__blob {
    width: 90%;
    left: 5%;
    top: 6%;
    opacity: 0.65;
  }

  .starts-feature__main {
    width: 92%;
    left: 4%;
    top: 6%;
    z-index: 1;
    filter: drop-shadow(0 22px 30px rgba(15, 23, 42, 0.14));
  }

  .starts-feature__sat {
    z-index: 2;
    filter: drop-shadow(0 14px 20px rgba(15, 23, 42, 0.2));
  }

  .starts-feature__sat--target {
    width: 22%;
    right: -2%;
    top: -4%;
  }

  .starts-feature__sat--likes {
    width: 24%;
    right: 4%;
    bottom: 8%;
  }

  .starts-feature__pill {
    position: absolute;
    bottom: 2%;
    left: 2%;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--color-light);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 0.75rem 1.15rem;
    box-shadow: 0 18px 35px -10px rgba(15, 23, 42, 0.22);
  }

  .starts-feature__pill-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--color-cyan);
    color: var(--color-light);
    display: grid;
    place-items: center;
  }

  .starts-feature__pill div {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .starts-feature__pill strong {
    font-size: 0.92rem;
    color: var(--color-dark);
  }

  .starts-feature__pill span {
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  .starts-feature__title {
    margin: 0.25rem 0 0.85rem;
  }

  .starts-feature__question {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-cyan-dark);
    margin: 0 0 1rem;
  }

  .starts-feature__body {
    color: var(--color-muted);
    font-size: 1.04rem;
    line-height: 1.75;
    margin: 0 0 1.15rem;
  }

  .pillars-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .pillar-row-card {
    background: var(--color-light);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-cyan);
    border-radius: 16px;
    padding: 1.25rem 1.4rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.15rem;
    align-items: start;
    box-shadow: var(--shadow-soft);
    transition:
      translate 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .pillar-row-card:hover {
    translate: 4px -3px;
    box-shadow: var(--shadow-lift);
    border-left-color: var(--color-primary);
  }

  .pillar-row-card__left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .pillar-row-card__num {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-cyan-dark);
    background: var(--color-cyan-soft);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }

  .pillar-row-card__icon-box {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--color-cyan-soft);
    display: grid;
    place-items: center;
  }

  .pillar-row-card__icon-box img {
    width: 30px;
    height: 30px;
    object-fit: contain;
  }

  .pillar-row-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .pillar-row-card__title {
    font-size: 1.15rem;
    margin: 0;
    color: var(--color-dark);
  }

  .pillar-row-card__tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-cyan-dark);
    background: var(--color-cyan-soft);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }

  .pillar-row-card__body {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.94rem;
    line-height: 1.65;
  }
</style>
