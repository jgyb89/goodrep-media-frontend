---
import { SITE_NAME, DEFAULT_PAGE_TITLE, DEFAULT_META_DESCRIPTION } from "../config/site.js";

interface Props {
  title?: string;
  description?: string;
  favicon?: string;
}

const {
  title = DEFAULT_PAGE_TITLE,
  description = DEFAULT_META_DESCRIPTION,
  favicon = "/grm-logos/GRM_Blue_Favicon.png",
} = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" type="image/png" href={favicon} />

<!-- Google Fonts preconnect and stylesheets -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap"
/>
